# NAS 的固定局域网 IP；浏览器需要用它连接 Mihomo Controller。
NAS_IP=192.168.1.50

# 留空时首次启动自动生成。可用 `docker compose exec mihomo-console
# mihomo-console show-secret` 查看，然后在 Dashboard 中填写。
MIHOMO_SECRET=

TZ=Asia/Tokyo
DATA_PATH=./data
DASHBOARD_PORT=18080
CONTROLLER_HOST_PORT=19090
MIXED_HOST_PORT=17890

# 10 分钟后首次检查，之后每小时更新当前订阅；设为 0 可禁用。
UPDATE_START_DELAY_SECONDS=600
UPDATE_INTERVAL_SECONDS=3600
