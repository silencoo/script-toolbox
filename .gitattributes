# Docker copies these files into Linux sandboxes, where CRLF breaks zsh.
docker-sandboxes/kits/zsh-shell/** text eol=lf
mihomo-console/*.py text eol=lf
mihomo-console/*.sh text eol=lf
mihomo-console/*.yaml text eol=lf
mihomo-console/*.yml text eol=lf
mihomo-console/deploy/*.yaml text eol=lf
mihomo-console/Dockerfile text eol=lf

# This directory is an automatically synchronized third-party source snapshot.
extensions/singlefile-mv3/** -text linguist-vendored=true
