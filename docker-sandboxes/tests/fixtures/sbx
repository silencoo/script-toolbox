#!/usr/bin/env bash

set -u

: "${SBX_TEST_LOG:?SBX_TEST_LOG is required}"
: "${SBX_TEST_POLICY_STATE:?SBX_TEST_POLICY_STATE is required}"
: "${SBX_TEST_AUTH_STATE:?SBX_TEST_AUTH_STATE is required}"

printf '%s\n' "$*" >> "$SBX_TEST_LOG"

assert_kit_line_endings() {
  local kit_path="$1"
  if grep -r $'\r' "$kit_path" >/dev/null 2>&1; then
    printf 'kit contains a carriage return: %s\n' "$kit_path" >&2
    exit 93
  fi
  printf '%s\n' 'kit-line-endings lf' >> "$SBX_TEST_LOG"
  if [ -d "$kit_path/files" ]; then
    printf '%s\n' 'kit-static-files present' >> "$SBX_TEST_LOG"
  else
    printf '%s\n' 'kit-static-files absent' >> "$SBX_TEST_LOG"
  fi
}

assert_refresh_kit_name_is_unique() {
  local kit_path="$1"
  local kit_name=''

  kit_name="$(
    awk '
      /^name:[[:space:]]*/ {
        count++
        sub(/^name:[[:space:]]*/, "")
        name=$0
      }
      END {
        if (count != 1) exit 1
        print name
      }
    ' "$kit_path/spec.yaml"
  )" || {
    printf 'refresh kit must declare exactly one top-level name: %s\n' \
      "$kit_path/spec.yaml" >&2
    exit 92
  }
  if [ "$kit_name" = zsh-shell ]; then
    printf '%s\n' 'compose: duplicate kit name "zsh-shell"' >&2
    exit 92
  fi
  printf 'kit-name %s\n' "$kit_name" >> "$SBX_TEST_LOG"
}

case "${1:-}" in
  version)
    printf 'sbx version: test\n'
    ;;
  policy)
    case "${2:-}" in
      init)
        if [ -e "$SBX_TEST_POLICY_STATE" ]; then
          printf '%s\n' \
            'ERROR: global network policy is already initialized; use "sbx policy reset" first to change it' >&2
          exit 1
        fi
        printf '%s\n' "${3:-}" > "$SBX_TEST_POLICY_STATE"
        printf 'Network policy set to "%s".\n' "${3:-}"
        ;;
      reset)
        rm -f "$SBX_TEST_POLICY_STATE"
        ;;
      inspect)
        printf '%s\n' 'unexpected interactive policy probe' >&2
        exit 97
        ;;
      check)
        printf 'Allowed: %s\n' "${4:-unknown}"
        ;;
      ls)
        if [ "${*: -1}" = '--json' ]; then
          preset="$(cat "$SBX_TEST_POLICY_STATE")"
          case "$preset" in
            allow-all) rule_id=default-allow-all ;;
            deny-all) rule_id=default-deny-all ;;
            balanced) rule_id=balanced-registry-allow ;;
            *) rule_id=custom-rule ;;
          esac
          printf '{"rules":[{"id":"%s","origin":"local"}]}\n' "$rule_id"
        else
          printf '%s\n' 'local all test-policy'
        fi
        ;;
      *)
        printf 'unsupported policy command: %s\n' "${2:-}" >&2
        exit 98
        ;;
    esac
    ;;
  diagnose)
    if [ -e "$SBX_TEST_AUTH_STATE" ]; then
      auth_message=authenticated
      auth_status=pass
    else
      auth_message='not authenticated'
      auth_status=warn
    fi
    printf '{\n'
    printf '  "checks": [\n'
    printf '    {\n'
    printf '      "name": "Authentication",\n'
    printf '      "status": "%s",\n' "$auth_status"
    printf '      "message": "%s"\n' "$auth_message"
    printf '    }\n'
    printf '  ]\n'
    printf '}\n'
    ;;
  login)
    : > "$SBX_TEST_AUTH_STATE"
    printf '%s\n' 'Login complete.'
    ;;
  daemon)
    case "${2:-}" in
      status)
        printf '%s\n' 'Status: running'
        if [ -n "${SBX_TEST_DAEMON_LOG:-}" ]; then
          printf 'Logs: %s\n' "$SBX_TEST_DAEMON_LOG"
        fi
        ;;
      start)
        if [ -n "${SBX_TEST_DAEMON_LOG:-}" ]; then
          printf '%s\n' '{"msg":"loggingkit started"}' >> "$SBX_TEST_DAEMON_LOG"
        fi
        printf '%s\n' 'daemon started'
        ;;
      stop)
        printf '%s\n' 'daemon stopped'
        ;;
      *)
        printf 'unsupported daemon command: %s\n' "${2:-}" >&2
        exit 96
        ;;
    esac
    ;;
  template)
    printf '%s\n' 'no cached templates'
    ;;
  ls)
    if [ "${2:-}" = '-q' ]; then
      if [ -n "${SBX_TEST_SANDBOX_NAMES:-}" ]; then
        printf '%s\n' "$SBX_TEST_SANDBOX_NAMES"
      fi
    else
      printf '%s\n' 'no sandboxes'
    fi
    ;;
  exec)
    if [ "${2:-}" = '-u' ]; then
      exit 0
    fi
    if [ "${SBX_TEST_SHELL_KIT_CURRENT:-1}" -eq 1 ]; then
      exit 0
    fi
    exit 1
    ;;
  cp)
    printf '%s\n' 'files copied'
    ;;
  kit)
    case "${2:-}" in
      add)
        assert_kit_line_endings "${4:?kit path is required}"
        assert_refresh_kit_name_is_unique "$4"
        if [ -n "${SBX_TEST_KIT_ADD_TRANSIENT_STATE:-}" ] \
          && [ ! -e "$SBX_TEST_KIT_ADD_TRANSIENT_STATE" ]; then
          : > "$SBX_TEST_KIT_ADD_TRANSIENT_STATE"
          printf '%s\n' 'commands.install[0] (set -eu; hidden-test-command)'
          printf '%s\n' \
            'curl: (35) TLS connect error: unexpected eof while reading' >&2
          exit 1
        fi
        printf '%s\n' 'kit added'
        ;;
      *)
        printf 'unsupported kit command: %s\n' "${2:-}" >&2
        exit 95
        ;;
    esac
    ;;
  run)
    printf 'root-size-env %s\n' \
      "${DOCKER_SANDBOXES_ROOT_SIZE:-}" >> "$SBX_TEST_LOG"
    printf 'docker-size-env %s\n' \
      "${DOCKER_SANDBOXES_DOCKER_SIZE:-}" >> "$SBX_TEST_LOG"
    kit_path=''
    previous_argument=''
    for argument in "$@"; do
      if [ "$previous_argument" = '--kit' ]; then
        kit_path="$argument"
        break
      fi
      previous_argument="$argument"
    done
    if [ -n "$kit_path" ]; then
      assert_kit_line_endings "$kit_path"
    fi
    printf '%s\n' 'sandbox started'
    ;;
  *)
    printf 'unsupported sbx command: %s\n' "${1:-}" >&2
    exit 99
    ;;
esac
