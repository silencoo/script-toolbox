#!/usr/bin/env bash
# promptctl — guided Shell frontend for persistent Claude/Codex instructions.
#
# The Python file beside this script is deliberately a non-interactive engine.
# Keeping prompts and confirmations here makes the public entrypoint consistent
# with the other script-toolbox tools while retaining deterministic operations.

set -euo pipefail
umask 077

SOURCE_PATH="${BASH_SOURCE[0]}"
while [ -L "$SOURCE_PATH" ]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
  SOURCE_PATH="$(readlink "$SOURCE_PATH")"
  case "$SOURCE_PATH" in
    /*) ;;
    *) SOURCE_PATH="${SOURCE_DIR}/${SOURCE_PATH}" ;;
  esac
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
ENGINE="${SCRIPT_DIR}/promptctl.py"
REMOTE_CLIENT="${SCRIPT_DIR}/prompt-remote.mjs"
TUI_CLIENT="${SCRIPT_DIR}/../tui/dist/toolbox-tui.mjs"
PYTHON_BIN=""
export PROMPTCTL_PROG="promptctl"

# shellcheck source=../ctl-lib.sh
. "${SCRIPT_DIR}/../ctl-lib.sh"

usage() {
  cat <<'EOF'
promptctl — configure persistent, user-editable instructions

Usage:
  promptctl
  promptctl tui
  promptctl interactive [--home <directory>]
  promptctl update [--check|--yes]
  promptctl install <claude|codex|all> [options]
  promptctl migrate --target <claude|codex|all> --profile <name> [--yes]
  promptctl status <claude|codex|all> [options]
  promptctl path <claude|codex|all> [options]
  promptctl uninstall <claude|codex|all> [options]
  promptctl snippet list|create|path|copy|delete ...
  promptctl profile list|create|delete ...
  promptctl plan --target <claude|codex|all> --profile <name>
  promptctl apply --target <claude|codex|all> --profile <name> --yes
  promptctl current --target <claude|codex|all> [--json]
  promptctl backup [--home <directory>]
  promptctl restore --yes [--version <id>] [--force]
  promptctl recovery
  promptctl versions
  promptctl remote init|status|ui ...

Run without arguments in a terminal for the unified TUI. Use "interactive"
for the guided Shell setup. Every write is previewed and
requires confirmation. Explicit subcommands are passed to the deterministic
Python engine; use "promptctl <command> --help" for their options.

Environment:
  PROMPTCTL_PYTHON   Python 3.9+ executable used by the internal engine.
  PROMPTCTL_REMOTE_CONFIG  Remote capability file.
EOF
}

run_remote_client() {
  require_node22 "Prompt Store commands"
  [ -r "$REMOTE_CLIENT" ] || die "Prompt Store client not found: $REMOTE_CLIENT"
  exec node "$REMOTE_CLIENT" "$@"
}

find_python() {
  local candidate

  [ -r "$ENGINE" ] || die "internal engine not found: $ENGINE"

  if [ -n "${PROMPTCTL_PYTHON:-}" ]; then
    candidate="$PROMPTCTL_PYTHON"
    command -v "$candidate" >/dev/null 2>&1 ||
      die "PROMPTCTL_PYTHON is not executable: $candidate"
    "$candidate" -c 'import sys; raise SystemExit(sys.version_info < (3, 9))' \
      >/dev/null 2>&1 ||
      die "Promptctl requires Python 3.9 or newer: $candidate"
    PYTHON_BIN="$candidate"
    return 0
  fi

  for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 &&
       "$candidate" -c 'import sys; raise SystemExit(sys.version_info < (3, 9))' \
         >/dev/null 2>&1; then
      PYTHON_BIN="$candidate"
      return 0
    fi
  done

  die "Promptctl requires Python 3.9 or newer; install python3 and re-run"
}

run_engine() {
  "$PYTHON_BIN" "$ENGINE" "$@"
}

normalize_profile() {
  local candidate="$1"
  case "$candidate" in
    *.md) candidate="${candidate%.md}" ;;
  esac
  case "$candidate" in
    ""|"."|".."|*/*|*\\*|*..*|*[!A-Za-z0-9._-]*)
      return 1
      ;;
  esac
  PROFILE_NAME="$candidate"
}

read_profile() {
  while true; do
    prompt_value "Instruction profile name" "personal"
    if normalize_profile "$PROMPT_REPLY"; then
      return 0
    fi
    warn "use one safe filename: letters, digits, dots, underscores, or hyphens"
  done
}

run_profile_engine() {
  local operation="$1"
  shift
  local -a command_args
  command_args=("$operation" "$GUIDED_CLIENT" "--name" "$PROFILE_NAME")
  if [ -n "$GUIDED_HOME" ]; then
    command_args+=("--home" "$GUIDED_HOME")
  fi
  command_args+=("$@")
  PROMPTCTL_GUIDED=1 "$PYTHON_BIN" "$ENGINE" "${command_args[@]}"
}

run_interactive() {
  local action
  local -a remove_args
  GUIDED_HOME=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --home)
        [ $# -ge 2 ] || die "--home requires a directory"
        GUIDED_HOME="$2"
        shift 2
        ;;
      --home=*)
        GUIDED_HOME="${1#*=}"
        [ -n "$GUIDED_HOME" ] || die "--home requires a directory"
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        die "interactive mode accepts only --home; use explicit commands for advanced options"
        ;;
    esac
  done

  log "Promptctl guided Shell setup"
  log "Every write is previewed and requires a separate confirmation."

  choose_menu \
    "What would you like to do?" 1 \
    "install|Configure or update persistent instructions" \
    "status|Inspect current Promptctl status" \
    "path|Print editable instruction paths" \
    "uninstall|Remove Promptctl-managed links" \
    "exit|Exit without changes"
  action="$MENU_VALUE"
  if [ "$action" = "exit" ]; then
    log "No changes were made."
    return 0
  fi

  choose_menu \
    "Which client?" 1 \
    "all|Claude Code and Codex" \
    "claude|Claude Code" \
    "codex|Codex"
  GUIDED_CLIENT="$MENU_VALUE"
  read_profile

  case "$action" in
    status|path)
      run_profile_engine "$action"
      ;;
    install)
      run_profile_engine install
      if ask_yes_no "Apply this Promptctl plan?" "no"; then
        run_profile_engine install --yes
      else
        log "[cancelled] no files were changed"
      fi
      ;;
    uninstall)
      remove_args=()
      if ask_yes_no \
        "Also back up and remove the editable instruction files?" "no"; then
        remove_args+=("--remove-instructions")
      fi
      run_profile_engine uninstall "${remove_args[@]+"${remove_args[@]}"}"
      if ask_yes_no "Apply this uninstall plan?" "no"; then
        run_profile_engine \
          uninstall "${remove_args[@]+"${remove_args[@]}"}" --yes
      else
        log "[cancelled] no files were changed"
      fi
      ;;
  esac
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
esac

if [ $# -eq 0 ] && [ -t 0 ] && [ -t 1 ]; then
  run_agent_tui "$TUI_CLIENT" prompts
fi
if [ "${1:-}" = "tui" ]; then
  shift
  run_agent_tui "$TUI_CLIENT" prompts "$@"
fi
if [ "${1:-}" = "update" ]; then
  shift
  run_ctl_update "${SCRIPT_DIR}/../update-commands.sh" promptctl "$@"
fi

case "${1:-}" in
  remote)
    if [ "${2:-}" = "status" ]; then
      shift 2
      run_remote_client status "$@"
    fi
    run_remote_client "$@"
    ;;
  backup|restore|recovery|versions)
    run_remote_client "$@"
    ;;
esac

find_python

if [ $# -eq 0 ]; then
  run_interactive
elif [ "$1" = "interactive" ]; then
  shift
  run_interactive "$@"
else
  exec "$PYTHON_BIN" "$ENGINE" "$@"
fi
