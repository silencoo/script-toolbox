  jq -n \
    --arg client "$CLIENT_ID" \
    --arg label "$CLIENT_LABEL" \
    --arg cli_path "$CLI_PATH" \
    --arg cli_version "$CLI_VERSION" \
    --arg provider_status "$PROVIDER_STATUS" \
    --arg provider_source "$PROVIDER_SOURCE" \
    --arg provider "$STATUS_PROVIDER" \
    --arg model "$STATUS_MODEL" \
    --arg inference_provider "$INFERENCE_PROVIDER" \
    --arg inference_source "$INFERENCE_SOURCE" \
    --arg identity_status "$IDENTITY_STATUS" \
    --arg identity_kind "$IDENTITY_KIND" \
    --arg identity_provider "$IDENTITY_PROVIDER" \
    --arg identity_account "$IDENTITY_ACCOUNT" \
    --arg identity_source "$IDENTITY_SOURCE" \
    --arg identity_credential_file "$IDENTITY_CREDENTIAL_FILE" \
    --arg identity_credential_mode "$IDENTITY_CREDENTIAL_MODE" \
    --arg config_file_1 "$CONFIG_FILE_1" \
    --arg config_file_2 "$CONFIG_FILE_2" \
    --arg state_file "$STATE_FILE" \
    --arg credential_kind "$CREDENTIAL_KIND" \
    --arg credential_file "$CREDENTIAL_FILE" \
    --arg credential_mode "$CREDENTIAL_MODE" \
    --argjson cli_installed "$CLI_INSTALLED" \
    --argjson config_exists "$CONFIG_EXISTS" \
    --argjson config_valid "$CONFIG_VALID" \
    --argjson state_exists "$STATE_EXISTS" \
    --argjson ownership_marker "$OWNERSHIP_MARKER" \
    --argjson credential_exists "$CREDENTIAL_EXISTS" \
    --argjson credential_private "$CREDENTIAL_PRIVATE" \
    --argjson credential_path_valid "$CREDENTIAL_PATH_VALID" \
    --argjson identity_credential_exists "$IDENTITY_CREDENTIAL_EXISTS" \
    --argjson identity_credential_private "$IDENTITY_CREDENTIAL_PRIVATE" \
    --argjson official_login_preserved "$OFFICIAL_LOGIN_PRESERVED" \
    --argjson identity_inference_split "$IDENTITY_INFERENCE_SPLIT" '
      {
        client: $client,
        label: $label,
        cli_installed: $cli_installed,
        cli_path: (if $cli_path == "" then null else $cli_path end),
        cli_version: (if $cli_version == "" then null else $cli_version end),
        provider_status: $provider_status,
        provider_source: $provider_source,
        provider: (if $provider == "" then null else $provider end),
        model: (if $model == "" then null else $model end),
        identity: {
          status: $identity_status,
          kind: (if $identity_kind == "" then null else $identity_kind end),
          provider: (if $identity_provider == "" then null else $identity_provider end),
          account: (if $identity_account == "" then null else $identity_account end),
          source: $identity_source,
          credential_file: (
            if $identity_credential_file == "" then null else $identity_credential_file end
          ),
          credential_exists: $identity_credential_exists,
          credential_private: $identity_credential_private,
          credential_mode: (
            if $identity_credential_mode == "" then null else $identity_credential_mode end
          )
        },
        inference: {
          status: $provider_status,
          provider: (if $inference_provider == "" then null else $inference_provider end),
          model: (if $model == "" then null else $model end),
          source: $inference_source,
          credential_kind: $credential_kind,
          credential_exists: $credential_exists,
          credential_private: $credential_private
        },
        official_login_preserved: $official_login_preserved,
        identity_inference_split: $identity_inference_split,
        config_files: (
          [$config_file_1, $config_file_2] | map(select(length > 0))
        ),
        config_exists: $config_exists,
        config_valid: $config_valid,
        state_file: $state_file,
        state_exists: $state_exists,
        ownership_marker: $ownership_marker,
        credential_kind: $credential_kind,
        credential_file: (
          if $credential_file == "" then null else $credential_file end
        ),
        credential_exists: $credential_exists,
        credential_private: $credential_private,
        credential_mode: (
          if $credential_mode == "" then null else $credential_mode end
        ),
        credential_path_valid: $credential_path_valid
      }
    '
}

run_status() {
  local requested="" json_output=0 client first=1

  while [ $# -gt 0 ]; do
    case "$1" in
      --json)
        json_output=1
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        [ -z "$requested" ] || die "status accepts one client name and optional --json"
        requested="$1"
        shift
        ;;
    esac
  done
  [ -n "$requested" ] || die "status requires a client name or all"
  if [ "$json_output" = 1 ]; then
    command -v jq >/dev/null 2>&1 ||
      die "jq is required for status --json; install jq and re-run"
  fi

  if [ "$requested" = "all" ]; then
    if [ "$json_output" = 1 ]; then
      {
        for client in claude codex opencode pi; do
          resolve_client "$client"
          status_prepare
          status_emit_json
        done
      } | jq -s '.'
    else
      for client in claude codex opencode pi; do
        resolve_client "$client"
        status_prepare
        if [ "$first" -ne 1 ]; then
          log ""
        fi
        status_emit_human
        first=0
      done
    fi
    return 0
  fi

  resolve_client "$requested"
  status_prepare
  if [ "$json_output" = 1 ]; then
    status_emit_json
  else
    status_emit_human
  fi
}

run_uninstall() {
  local requested="$1" assume_yes=0
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes|-y)
        assume_yes=1
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        die "uninstall accepts only --yes after the client name"
        ;;
    esac
  done

  resolve_client "$requested"
  if [ "$assume_yes" -ne 1 ]; then
    log "This removes only agentctl-managed ${CLIENT_LABEL} provider state."
    log "MCP configuration, Promptctl instructions, and the CLI stay installed."
    if ! ask_yes_no "Continue with ${CLIENT_LABEL} provider uninstall?" "no"; then
      log "[cancelled] no provider configuration was changed"
      return 0
    fi
  fi
  exec "$SETUP_SCRIPT" --uninstall
}

run_interactive() {
  local action
  if [ $# -gt 0 ]; then
    [ $# -eq 1 ] || die "interactive mode does not accept options"
    case "$1" in
      -h|--help) usage; return 0 ;;
      *) die "interactive mode does not accept options" ;;
    esac
  fi

  log "Agentctl guided Shell setup"
  log "Agent providers and the encrypted Toolbox Workspace are managed here."

  choose_menu \
    "What would you like to do?" 1 \
    "provider|Browse the unified Provider catalog" \
    "status|Inspect client and provider status" \
    "workspace|Inspect the unified MCP / Skills / Prompts Workspace" \
    "uninstall|Remove managed provider configuration" \
    "exit|Exit without changes"
  action="$MENU_VALUE"
  if [ "$action" = "exit" ]; then
    log "No changes were made."
    return 0
  fi

  if [ "$action" = "workspace" ]; then
    run_workspace status
  fi

  select_client
  case "$action" in
    provider)
      require_node22 "agentctl provider"
      node "$PROVIDER_CLIENT" list --target "$CLIENT_ID"
      log "Use: agentctl provider use <name> --target ${CLIENT_ID} --secret-file <private-file> --yes"
      ;;
    status)
      run_status "$CLIENT_ID"
      ;;
    uninstall)
      run_uninstall "$CLIENT_ID"
      ;;
  esac
}

case "${1:-}" in
  "")
    if [ -t 0 ] && [ -t 1 ]; then
      run_agent_tui "$TUI_CLIENT" overview
    else
      run_interactive
    fi
    ;;
  tui)
    shift
    run_agent_tui "$TUI_CLIENT" overview "$@"
    ;;
  interactive)
    shift
    run_interactive "$@"
    ;;
  update)
    shift
    run_ctl_update "${SCRIPT_DIR}/../update-commands.sh" agentctl "$@"
    ;;
  status)
    shift
    run_status "$@"
    ;;
  statusline)
    shift
    run_statusline "$@"
    ;;
  uninstall|remove)
    [ $# -ge 2 ] || die "$1 requires a client name"
    shift
    run_uninstall "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  workspace)
    shift
    run_workspace "$@"
    ;;
  provider)
    shift
    run_provider "$@"
    ;;
  account|identity)
    shift
    run_account "$@"
    ;;
  failover|route)
    shift
    run_failover "$@"
    ;;
  pricing|price)
    shift
    run_pricing "$@"
    ;;
  proxy)
    shift
    run_proxy "$@"
    ;;
  preset)
    run_orchestrator "$@"
    ;;
  doctor)
    run_orchestrator "$@"
    ;;
  -V|--version)
    printf 'agentctl %s\n' "$VERSION"
    ;;
  *)
    die "unknown command '$1'; use --help"
    ;;
esac
