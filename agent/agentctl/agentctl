#!/usr/bin/env bash
# agentctl — unified coding-agent configuration frontend.
# Per-client setup.sh files are private render backends for Provider use/apply.

set -euo pipefail
umask 077

SOURCE_PATH="${BASH_SOURCE[0]}"
while [ -L "$SOURCE_PATH" ]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
  SOURCE_PATH="$(readlink "$SOURCE_PATH")"
  case "$SOURCE_PATH" in
    /*) ;;
    *) SOURCE_PATH="${SOURCE_DIR}/${SOURCE_PATH}" ;;
  esac
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
DEFAULT_AGENT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
VERSION="0.17.5"
WORKSPACE_CLIENT="${SCRIPT_DIR}/workspace-client.mjs"
ORCHESTRATOR_CLIENT="${SCRIPT_DIR}/orchestrator-client.mjs"
PROVIDER_CLIENT="${SCRIPT_DIR}/provider-client.mjs"
ACCOUNT_CLIENT="${SCRIPT_DIR}/account-client.mjs"
FAILOVER_CLIENT="${SCRIPT_DIR}/failover-client.mjs"
PRICING_CLIENT="${SCRIPT_DIR}/pricing-client.mjs"
PROXY_CLIENT="${SCRIPT_DIR}/proxy-client.mjs"
TUI_CLIENT="${SCRIPT_DIR}/../tui/dist/toolbox-tui.mjs"

# shellcheck source=../ctl-lib.sh
. "${SCRIPT_DIR}/../ctl-lib.sh"

usage() {
  cat <<'EOF'
agentctl — install coding agents and configure providers/models

Usage:
  agentctl
  agentctl tui
  agentctl interactive
  agentctl update [--check|--yes]
  agentctl status <claude|codex|opencode|pi|all> [--json]
  agentctl statusline <install|status|uninstall> [options]
  agentctl provider <command> [options]
  agentctl account <status|list|login|save|use|delete> ...
  agentctl failover <command> [options]
  agentctl pricing <command> [options]
  agentctl proxy <plan|start|status|usage|attach|detach|stop|token> ...
  agentctl uninstall <claude|codex|opencode|pi> [--yes]
  agentctl workspace <command> [options]
  agentctl preset <list|show|create|delete|plan|apply|current|rollback|push|pull> ...
  agentctl doctor [claude|codex|all] [--target <target>] [--json]

Commands:
  status      Read CLI/provider configuration source and credential metadata,
              including external Claude config and official Codex login.
              Secret values are never emitted.
  statusline  Preview/install, inspect, or safely uninstall the managed Claude
              Code status-line preset. Existing external settings are preserved.
  provider    List built-ins and local/Workspace profiles in one catalog; use a
              selection to install/configure one client and store local Secrets.
  account     Safely log in through an isolated Codex home, then save and
              switch owner-only ChatGPT official-login snapshots.
  failover    Manage portable ordered provider routes and guarded retry/
              circuit-breaker policy. Runtime counters remain device-local.
  pricing     Manage an independent versioned fixed-decimal price catalog and
              calculate normalized token costs without floating point.
  proxy       Manage the optional loopback-only native protocol proxy, with
              explicit Codex passthrough attach/detach when requested.
  uninstall   Remove only provider/model/credential state owned by setup.sh.
              It does not remove MCP state, Promptctl files, or the CLI binary.
  workspace   Manage one encrypted recovery key for portable Provider,
              Secret, failover, pricing, MCP, Skills, Prompts, and Preset
              catalogs. Device-generated state remains local.
  preset      Bind one MCP profile, Skills pack, and Prompt profile into a
              transactional development preset with plan/apply/rollback.
  doctor      Inspect providers, local selections, preset drift, secrets,
              remote stores, and session-restart guidance.
  update      Check for or install the latest standalone ctl suite. All four
              controllers share one runtime and update together.

Run without arguments in a terminal for the unified TUI. Use "interactive"
for the guided Shell menu. Per-client setup scripts are internal renderers;
all user-facing Provider selection goes through "agentctl provider".
Run "agentctl workspace --help" for Workspace commands.
Run "agentctl provider --help" for the unified Provider catalog.
Run "agentctl account --help" for Codex official-account commands.
Run "agentctl failover --help" for portable failover-route commands.
Run "agentctl pricing --help" for price catalog and calculation commands.
Run "agentctl proxy --help" for the optional local proxy lifecycle.
Run "agentctl preset --help" for development-preset commands.
Run "agentctl statusline --help" for Claude status-line commands.
EOF
}

run_workspace() {
  require_node22 "agentctl workspace"
  [ -r "$WORKSPACE_CLIENT" ] ||
    die "Workspace client not found: $WORKSPACE_CLIENT"
  exec node "$WORKSPACE_CLIENT" "$@"
}

run_provider() {
  require_node22 "agentctl provider"
  [ -r "$PROVIDER_CLIENT" ] ||
    die "Provider Store client not found: $PROVIDER_CLIENT"
  exec node "$PROVIDER_CLIENT" "$@"
}

run_account() {
  require_node22 "agentctl account"
  [ -r "$ACCOUNT_CLIENT" ] ||
    die "Account controller not found: $ACCOUNT_CLIENT"
  exec node "$ACCOUNT_CLIENT" "$@"
}

run_failover() {
  require_node22 "agentctl failover"
  [ -r "$FAILOVER_CLIENT" ] ||
    die "Failover controller not found: $FAILOVER_CLIENT"
  exec node "$FAILOVER_CLIENT" "$@"
}

run_pricing() {
  require_node22 "agentctl pricing"
  [ -r "$PRICING_CLIENT" ] ||
    die "Pricing controller not found: $PRICING_CLIENT"
  exec node "$PRICING_CLIENT" "$@"
}

run_proxy() {
  require_node22 "agentctl proxy"
  [ -r "$PROXY_CLIENT" ] ||
    die "Proxy controller not found: $PROXY_CLIENT"
  exec node "$PROXY_CLIENT" "$@"
}

run_orchestrator() {
  require_node22 "agentctl presets and doctor"
  [ -r "$ORCHESTRATOR_CLIENT" ] ||
    die "Orchestration client not found: $ORCHESTRATOR_CLIENT"
  AGENTCTL_SELF="${SCRIPT_DIR}/agentctl" exec node "$ORCHESTRATOR_CLIENT" "$@"
}

resolve_agent_root() {
  local requested="${AGENTCTL_AGENT_ROOT:-$DEFAULT_AGENT_ROOT}"
  [ -d "$requested" ] || die "agent backend root does not exist: $requested"
  AGENT_ROOT="$(cd "$requested" && pwd)"
}

resolve_client() {
  if [ -z "${AGENT_ROOT:-}" ]; then
    resolve_agent_root
  fi
  case "$1" in
    claude|claude-code)
      CLIENT_ID="claude"
      CLIENT_DIR="claude-code"
      CLIENT_LABEL="Claude Code"
      ;;
    codex)
      CLIENT_ID="codex"
      CLIENT_DIR="codex"
      CLIENT_LABEL="Codex"
      ;;
    opencode|open-code)
      CLIENT_ID="opencode"
      CLIENT_DIR="opencode"
      CLIENT_LABEL="OpenCode"
      ;;
    pi)
      CLIENT_ID="pi"
      CLIENT_DIR="pi"
      CLIENT_LABEL="Pi"
      ;;
    *)
      die "unsupported client '$1'; choose claude, codex, opencode, or pi"
      ;;
  esac

  SETUP_SCRIPT="${AGENT_ROOT}/${CLIENT_DIR}/setup.sh"
  [ -f "$SETUP_SCRIPT" ] ||
    die "setup backend not found for ${CLIENT_LABEL}: $SETUP_SCRIPT"
  [ -x "$SETUP_SCRIPT" ] ||
    die "setup backend is not executable: $SETUP_SCRIPT"
}

select_client() {
  choose_menu \
    "Which coding agent?" 1 \
    "claude|Claude Code" \
    "codex|Codex" \
    "opencode|OpenCode" \
    "pi|Pi"
  resolve_client "$MENU_VALUE"
}

run_statusline() {
  local manager
  resolve_agent_root
  manager="${AGENT_ROOT}/claude-code/statusline-setup.sh"
  [ -f "$manager" ] ||
    die "Claude status-line manager not found: $manager"
  [ -x "$manager" ] ||
    die "Claude status-line manager is not executable: $manager"
  AGENTCTL_STATUSLINE_COMMAND="${SCRIPT_DIR}/agentctl statusline" \
    exec "$manager" "$@"
}

status_file_mode() {
  local path="$1" mode=""
  mode="$(stat -c '%a' "$path" 2>/dev/null || stat -f '%Lp' "$path" 2>/dev/null || true)"
  printf '%s' "$mode"
}

status_json_value() {
  local path="$1" filter="$2"
  [ -f "$path" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  jq -r "$filter" "$path" 2>/dev/null || true
}

status_toml_top_level_value() {
  local path="$1" wanted="$2"
  [ -f "$path" ] || return 0
  awk -v wanted="$wanted" '
    /^[[:space:]]*\[[^]]+\]/ { exit }
    {
      line = $0
      if (line ~ "^[[:space:]]*" wanted "[[:space:]]*=") {
        sub(/^[^=]*=[[:space:]]*/, "", line)
        sub(/[[:space:]]*#.*$/, "", line)
        sub(/[[:space:]]*$/, "", line)
        if (line ~ /^".*"$/) {
          sub(/^"/, "", line)
          sub(/"$/, "", line)
        }
        print line
        exit
      }
    }
  ' "$path"
}

status_safe_provider() {
  local value="$1"
  STATUS_SAFE_VALUE=""
  case "$CLIENT_ID" in
    claude)
      case "$value" in
        anthropic|deepseek|openrouter|minimax-cn|minimax-global|custom)
          STATUS_SAFE_VALUE="$value"
          ;;
      esac
      ;;
    codex)
      case "$value" in
        ""|*[!A-Za-z0-9._-]*) ;;
        *) STATUS_SAFE_VALUE="$(printf '%s' "$value" | cut -c1-96)" ;;
      esac
      ;;
    opencode|pi)
      case "$value" in
        ""|*[!A-Za-z0-9._-]*) ;;
        script-toolbox-*) STATUS_SAFE_VALUE="$value" ;;
      esac
      ;;
  esac
}

status_cli_version() {
  local command_name="$1" output pid attempts=0
  output="$(mktemp "${TMPDIR:-/tmp}/agentctl-version.XXXXXX")"
  (
    # A hostile or broken --version implementation must not fill the disk
    # during the bounded probe. The limit is ample for a version string.
    ulimit -f 128 2>/dev/null || true
    exec "$command_name" --version > "$output" 2>/dev/null
  ) &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$attempts" -ge 40 ]; then
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      rm -f "$output"
      return 124
    fi
    sleep 0.05
    attempts=$((attempts + 1))
  done
  if ! wait "$pid" 2>/dev/null; then
    rm -f "$output"
    return 1
  fi
  cat "$output"
  rm -f "$output"
}

status_set_metadata() {
  CONFIG_FILE_1=""
  CONFIG_FILE_2=""
  STATE_FILE=""
  AUTH_FILE=""
  CLI_COMMAND=""
  CREDENTIAL_KIND="file"
  CREDENTIAL_EXPECTED_PREFIX=""

  case "$CLIENT_ID" in
    claude)
      CLI_COMMAND="claude"
      CONFIG_FILE_1="${HOME}/.claude/settings.json"
      STATE_FILE="${HOME}/.claude/.script-toolbox-provider"
      CREDENTIAL_KIND="embedded"
      ;;
    codex)
      CLI_COMMAND="codex"
      CONFIG_FILE_1="${HOME}/.codex/config.toml"
      STATE_FILE="${HOME}/.codex/.script-toolbox-provider-key"
      AUTH_FILE="${HOME}/.codex/auth.json"
      CREDENTIAL_EXPECTED_PREFIX="${HOME}/.codex/provider-keys/"
      ;;
    opencode)
      CLI_COMMAND="opencode"
      CONFIG_FILE_1="${HOME}/.config/opencode/opencode.json"
      STATE_FILE="${HOME}/.config/opencode/.script-toolbox-provider"
      AUTH_FILE="${HOME}/.local/share/opencode/auth.json"
      CREDENTIAL_EXPECTED_PREFIX="${HOME}/.config/opencode/provider-keys/"
      ;;
    pi)
      CLI_COMMAND="pi"
      CONFIG_FILE_1="${HOME}/.pi/agent/settings.json"
      CONFIG_FILE_2="${HOME}/.pi/agent/models.json"
      STATE_FILE="${HOME}/.pi/agent/.script-toolbox-provider"
      CREDENTIAL_EXPECTED_PREFIX="${HOME}/.pi/agent/provider-keys/"
      ;;
  esac
}

status_prepare_identity() {
  IDENTITY_STATUS="not-applicable"
  IDENTITY_KIND=""
  IDENTITY_PROVIDER=""
  IDENTITY_ACCOUNT=""
  IDENTITY_SOURCE="none"
  IDENTITY_CREDENTIAL_FILE=""
  IDENTITY_CREDENTIAL_EXISTS=false
  IDENTITY_CREDENTIAL_MODE=""
  IDENTITY_CREDENTIAL_PRIVATE=false

  [ "$CLIENT_ID" = "codex" ] || return 0
  IDENTITY_STATUS="not-configured"
  [ -f "$AUTH_FILE" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0

  if jq -e '
    .auth_mode == "chatgpt"
    and ((.tokens // {}) | [.. | strings | select(length > 0)] | length > 0)
  ' "$AUTH_FILE" >/dev/null 2>&1; then
    IDENTITY_STATUS="configured"
    IDENTITY_KIND="chatgpt"
    IDENTITY_PROVIDER="openai"
    IDENTITY_ACCOUNT="current"
    IDENTITY_SOURCE="official-login"
    IDENTITY_CREDENTIAL_FILE="$AUTH_FILE"
    IDENTITY_CREDENTIAL_EXISTS=true
    IDENTITY_CREDENTIAL_MODE="$(status_file_mode "$AUTH_FILE")"
    case "$IDENTITY_CREDENTIAL_MODE" in
      ?00|??00) IDENTITY_CREDENTIAL_PRIVATE=true ;;
    esac
  fi
}

status_prepare() {
  local raw_value="" candidate="" raw_version="" native_provider="" native_selected=""

  status_set_metadata
  CLI_INSTALLED=false
  CLI_PATH=""
  CLI_VERSION=""
  CONFIG_EXISTS=false
  CONFIG_VALID=false
  STATE_EXISTS=false
  OWNERSHIP_MARKER=false
  PROVIDER_STATUS="not-configured"
  PROVIDER_SOURCE="none"
  STATUS_PROVIDER=""
  STATUS_MODEL=""
  CREDENTIAL_FILE=""
  CREDENTIAL_EXISTS=false
  CREDENTIAL_MODE=""
  CREDENTIAL_PRIVATE=false
  CREDENTIAL_PATH_VALID=true
  INFERENCE_PROVIDER=""
  INFERENCE_SOURCE="none"
  OFFICIAL_LOGIN_PRESERVED=false
  IDENTITY_INFERENCE_SPLIT=false

  if command -v "$CLI_COMMAND" >/dev/null 2>&1; then
    CLI_INSTALLED=true
    CLI_PATH="$(command -v "$CLI_COMMAND" 2>/dev/null | sed -n '1p')"
    raw_version="$(status_cli_version "$CLI_COMMAND" || true)"
    CLI_VERSION="$(printf '%s\n' "$raw_version" |
      LC_ALL=C tr -cd '\11\12\15\40-\176' |
      sed -n '1p' |
      cut -c1-160)"
  fi

  if [ -f "$CONFIG_FILE_1" ] &&
     { [ -z "$CONFIG_FILE_2" ] || [ -f "$CONFIG_FILE_2" ]; }; then
    CONFIG_EXISTS=true
    CONFIG_VALID=true
    if command -v jq >/dev/null 2>&1; then
      case "$CLIENT_ID" in
        claude|opencode)
          jq -e 'type == "object"' "$CONFIG_FILE_1" >/dev/null 2>&1 ||
            CONFIG_VALID=false
          ;;
        pi)
          jq -e 'type == "object"' "$CONFIG_FILE_1" >/dev/null 2>&1 &&
            jq -e 'type == "object"' "$CONFIG_FILE_2" >/dev/null 2>&1 ||
            CONFIG_VALID=false
          ;;
      esac
    fi
  fi
  [ ! -f "$STATE_FILE" ] || STATE_EXISTS=true
  status_prepare_identity

  case "$CLIENT_ID" in
    claude)
      if [ "$STATE_EXISTS" = true ]; then
        OWNERSHIP_MARKER=true
        PROVIDER_SOURCE="agentctl"
        raw_value="$(sed -n '1p' "$STATE_FILE")"
        status_safe_provider "$raw_value"
        STATUS_PROVIDER="$STATUS_SAFE_VALUE"
      fi
      STATUS_MODEL="$(status_json_value "$CONFIG_FILE_1" '
        .model
        // .env.ANTHROPIC_MODEL
        // .env.ANTHROPIC_DEFAULT_SONNET_MODEL
        // empty
      ')"
      CREDENTIAL_FILE="$CONFIG_FILE_1"
      if [ -f "$CONFIG_FILE_1" ]; then
        if command -v jq >/dev/null 2>&1; then
          if jq -e '
            ((.env.ANTHROPIC_API_KEY // "") | length > 0)
            or ((.env.ANTHROPIC_AUTH_TOKEN // "") | length > 0)
          ' "$CONFIG_FILE_1" >/dev/null 2>&1; then
            CREDENTIAL_EXISTS=true
          fi
        elif [ "$STATE_EXISTS" = true ]; then
          CREDENTIAL_EXISTS=true
        fi
      fi
      if [ "$OWNERSHIP_MARKER" != true ] &&
         [ "$CONFIG_VALID" = true ] &&
         [ "$CREDENTIAL_EXISTS" = true ]; then
        PROVIDER_SOURCE="external"
        if command -v jq >/dev/null 2>&1 &&
           jq -e '((.env.ANTHROPIC_BASE_URL // "") | length > 0)' \
             "$CONFIG_FILE_1" >/dev/null 2>&1; then
          STATUS_PROVIDER="external-endpoint"
        else
          STATUS_PROVIDER="anthropic"
        fi
      fi
      ;;
    codex)
      if grep -qF '# >>> agent/codex/setup.sh >>>' "$CONFIG_FILE_1" 2>/dev/null ||
         [ "$STATE_EXISTS" = true ]; then
        OWNERSHIP_MARKER=true
        PROVIDER_SOURCE="agentctl"
      fi
      raw_value="$(status_toml_top_level_value "$CONFIG_FILE_1" model_provider)"
      status_safe_provider "$raw_value"
      STATUS_PROVIDER="$STATUS_SAFE_VALUE"
      STATUS_MODEL="$(status_toml_top_level_value "$CONFIG_FILE_1" model)"
      if [ "$OWNERSHIP_MARKER" = true ] &&
         { [ -z "$STATUS_PROVIDER" ] || [ -z "$STATUS_MODEL" ]; }; then
        CONFIG_VALID=false
      fi
      if [ "$STATE_EXISTS" = true ]; then
        candidate="$(sed -n '1p' "$STATE_FILE")"
      fi
      if [ "$OWNERSHIP_MARKER" != true ] &&
         { [ -z "$STATUS_PROVIDER" ] || [ "$STATUS_PROVIDER" = "openai" ]; } &&
         [ "$IDENTITY_STATUS" = "configured" ]; then
          PROVIDER_SOURCE="official-login"
          STATUS_PROVIDER="openai-chatgpt"
          CREDENTIAL_KIND="official-auth"
          CREDENTIAL_FILE="$IDENTITY_CREDENTIAL_FILE"
          CREDENTIAL_EXISTS="$IDENTITY_CREDENTIAL_EXISTS"
          CREDENTIAL_MODE="$IDENTITY_CREDENTIAL_MODE"
          CREDENTIAL_PRIVATE="$IDENTITY_CREDENTIAL_PRIVATE"
      elif [ "$OWNERSHIP_MARKER" != true ] &&
           { [ -z "$STATUS_PROVIDER" ] || [ "$STATUS_PROVIDER" = "openai" ]; } &&
           [ -f "$AUTH_FILE" ] &&
           command -v jq >/dev/null 2>&1; then
        if jq -e '((.OPENAI_API_KEY // "") | length > 0)' \
          "$AUTH_FILE" >/dev/null 2>&1; then
          PROVIDER_SOURCE="official-login"
          STATUS_PROVIDER="openai"
          CREDENTIAL_KIND="official-auth"
          CREDENTIAL_FILE="$AUTH_FILE"
          CREDENTIAL_EXISTS=true
        fi
      elif [ "$OWNERSHIP_MARKER" != true ] && [ -n "$STATUS_PROVIDER" ]; then
        PROVIDER_SOURCE="external"
      fi
      ;;
    opencode)
      if grep -q '"script-toolbox-' "$CONFIG_FILE_1" 2>/dev/null ||
         [ "$STATE_EXISTS" = true ]; then
        OWNERSHIP_MARKER=true
        PROVIDER_SOURCE="agentctl"
      fi
      if [ "$STATE_EXISTS" = true ]; then
        raw_value="$(sed -n '1p' "$STATE_FILE")"
        status_safe_provider "$raw_value"
        STATUS_PROVIDER="$STATUS_SAFE_VALUE"
        candidate="$(sed -n '2p' "$STATE_FILE")"
      fi
      STATUS_MODEL="$(status_json_value "$CONFIG_FILE_1" '.model // empty')"
      if [ "$OWNERSHIP_MARKER" = true ]; then
        case "$STATUS_MODEL" in
          "${STATUS_PROVIDER}/"*) STATUS_MODEL="${STATUS_MODEL#"${STATUS_PROVIDER}/"}" ;;
        esac
      elif [ -f "$AUTH_FILE" ] && command -v jq >/dev/null 2>&1; then
        case "$STATUS_MODEL" in
          */*) native_selected="${STATUS_MODEL%%/*}" ;;
        esac
        native_provider="$(jq -r --arg selected "$native_selected" '
          def valid_record:
            type == "object"
            and ((.type // "") | type == "string");
          if ($selected | length) > 0 then
            if has($selected) and (.[$selected] | valid_record) then $selected else "" end
          else
            ([to_entries[] | select(.value | valid_record) | .key]
              | if length == 1 then .[0] else "" end)
          end
        ' "$AUTH_FILE" 2>/dev/null || true)"
        case "$native_provider" in
          anthropic) STATUS_PROVIDER="anthropic-api" ;;
          openai) STATUS_PROVIDER="openai-api" ;;
          google) STATUS_PROVIDER="google-gemini" ;;
          deepseek) STATUS_PROVIDER="deepseek" ;;
          openrouter) STATUS_PROVIDER="openrouter" ;;
          *) STATUS_PROVIDER="" ;;
        esac
        if [ -n "$STATUS_PROVIDER" ]; then
          PROVIDER_SOURCE="external-native-auth"
          CREDENTIAL_KIND="native-auth"
          CREDENTIAL_FILE="$AUTH_FILE"
          CREDENTIAL_EXISTS=true
          CREDENTIAL_MODE="$(status_file_mode "$AUTH_FILE")"
          case "$CREDENTIAL_MODE" in
            ?00|??00) CREDENTIAL_PRIVATE=true ;;
          esac
          if [ "$native_selected" = "$native_provider" ]; then
            STATUS_MODEL="${STATUS_MODEL#*/}"
          else
            STATUS_MODEL=""
          fi
        fi
      fi
      ;;
    pi)
      if grep -q '"script-toolbox-' "$CONFIG_FILE_2" 2>/dev/null ||
         [ "$STATE_EXISTS" = true ]; then
        OWNERSHIP_MARKER=true
      fi
      if [ "$STATE_EXISTS" = true ]; then
        raw_value="$(sed -n '1p' "$STATE_FILE")"
        status_safe_provider "$raw_value"
        STATUS_PROVIDER="$STATUS_SAFE_VALUE"
        candidate="$(sed -n '2p' "$STATE_FILE")"
      fi
      STATUS_MODEL="$(status_json_value "$CONFIG_FILE_1" '.defaultModel // empty')"
      ;;
  esac
  STATUS_MODEL="$(printf '%s' "$STATUS_MODEL" |
    tr '\r\n' '  ' |
    cut -c1-240)"

  if [ "$CREDENTIAL_KIND" = "file" ] && [ -n "$candidate" ]; then
    case "$candidate" in
      "$CREDENTIAL_EXPECTED_PREFIX"*.key)
        CREDENTIAL_FILE="$candidate"
        ;;
      *)
        CREDENTIAL_PATH_VALID=false
        ;;
    esac
  fi
  if [ "$CREDENTIAL_KIND" = "file" ] &&
     [ "$CREDENTIAL_PATH_VALID" = true ] &&
     [ -n "$CREDENTIAL_FILE" ] &&
     [ -f "$CREDENTIAL_FILE" ]; then
    CREDENTIAL_EXISTS=true
  fi
  if [ "$CREDENTIAL_EXISTS" = true ]; then
    CREDENTIAL_MODE="$(status_file_mode "$CREDENTIAL_FILE")"
    case "$CREDENTIAL_MODE" in
      ?00|??00) CREDENTIAL_PRIVATE=true ;;
    esac
  fi

  if [ "$OWNERSHIP_MARKER" = true ]; then
    if [ "$CONFIG_EXISTS" = true ] &&
       [ "$CONFIG_VALID" = true ] &&
       [ "$STATE_EXISTS" = true ] &&
       [ -n "$STATUS_PROVIDER" ] &&
       [ "$CREDENTIAL_EXISTS" = true ] &&
       [ "$CREDENTIAL_PRIVATE" = true ] &&
       [ "$CREDENTIAL_PATH_VALID" = true ]; then
      PROVIDER_STATUS="configured"
    else
      PROVIDER_STATUS="incomplete"
    fi
  elif [ "$PROVIDER_SOURCE" = "external-native-auth" ]; then
    if [ -n "$STATUS_PROVIDER" ] && [ "$CREDENTIAL_EXISTS" = true ]; then
      PROVIDER_STATUS="configured"
    else
      PROVIDER_STATUS="incomplete"
    fi
  elif [ "$PROVIDER_SOURCE" = "external" ]; then
    if [ "$CONFIG_VALID" = true ] &&
       [ -n "$STATUS_PROVIDER" ] &&
       [ "$CREDENTIAL_EXISTS" = true ]; then
      PROVIDER_STATUS="configured"
    else
      PROVIDER_STATUS="incomplete"
    fi
  elif [ "$PROVIDER_SOURCE" = "official-login" ]; then
    if [ -n "$STATUS_PROVIDER" ] && [ "$CREDENTIAL_EXISTS" = true ]; then
      PROVIDER_STATUS="configured"
    else
      PROVIDER_STATUS="incomplete"
    fi
  fi

  INFERENCE_PROVIDER="$STATUS_PROVIDER"
  INFERENCE_SOURCE="$PROVIDER_SOURCE"
  if [ "$CLIENT_ID" = "codex" ] &&
     [ "$PROVIDER_SOURCE" = "official-login" ] &&
     [ "$STATUS_PROVIDER" = "openai-chatgpt" ]; then
    INFERENCE_PROVIDER="openai-official"
    INFERENCE_SOURCE="official-account"
  fi
  if [ "$CLIENT_ID" = "codex" ] && [ "$IDENTITY_STATUS" = "configured" ]; then
    OFFICIAL_LOGIN_PRESERVED=true
    if [ "$PROVIDER_SOURCE" = "agentctl" ] || [ "$PROVIDER_SOURCE" = "external" ]; then
      IDENTITY_INFERENCE_SPLIT=true
    fi
  fi
}

status_emit_human() {
  log "${CLIENT_LABEL}"
  if [ "$CLI_INSTALLED" = true ]; then
    log "  CLI         : installed${CLI_VERSION:+ ($CLI_VERSION)}"
    log "  CLI path    : $CLI_PATH"
  else
    log "  CLI         : not installed"
  fi
  if [ "$CLIENT_ID" = "codex" ]; then
    log "  Identity    : ${IDENTITY_STATUS}${IDENTITY_KIND:+ ($IDENTITY_KIND / $IDENTITY_ACCOUNT)}"
    log "  Inference   : ${PROVIDER_STATUS}${INFERENCE_PROVIDER:+ ($INFERENCE_PROVIDER)}"
    log "  Source      : $INFERENCE_SOURCE"
    if [ "$IDENTITY_INFERENCE_SPLIT" = true ]; then
      log "  Integration : official login preserved for Remote Control"
    fi
  else
    log "  Provider    : ${PROVIDER_STATUS}${STATUS_PROVIDER:+ ($STATUS_PROVIDER)}"
    log "  Source      : $PROVIDER_SOURCE"
  fi
  log "  Model       : ${STATUS_MODEL:-not resolved}"
  log "  Config      : $CONFIG_FILE_1"
  [ -z "$CONFIG_FILE_2" ] || log "                $CONFIG_FILE_2"
  if [ "$CONFIG_EXISTS" = true ]; then
    log "  Config state: $([ "$CONFIG_VALID" = true ] && printf valid || printf invalid)"
  else
    log "  Config state: missing"
  fi
  log "  Ownership   : $([ "$OWNERSHIP_MARKER" = true ] && printf present || printf missing)"
  log "  State file  : $STATE_FILE ($([ "$STATE_EXISTS" = true ] && printf present || printf missing))"
  if [ "$CREDENTIAL_PATH_VALID" != true ]; then
    log "  Credential  : invalid path in ownership state (value hidden)"
  elif [ "$CREDENTIAL_EXISTS" = true ]; then
    log "  Credential  : $CREDENTIAL_KIND; $CREDENTIAL_FILE (mode ${CREDENTIAL_MODE:-unknown}, $([ "$CREDENTIAL_PRIVATE" = true ] && printf private || printf insecure))"
  else
    log "  Credential  : $CREDENTIAL_KIND; missing${CREDENTIAL_FILE:+ ($CREDENTIAL_FILE)}"
  fi
  if [ "$CLIENT_ID" = "codex" ] && [ "$IDENTITY_CREDENTIAL_EXISTS" = true ]; then
    log "  Official auth: $IDENTITY_CREDENTIAL_FILE (mode ${IDENTITY_CREDENTIAL_MODE:-unknown}, $([ "$IDENTITY_CREDENTIAL_PRIVATE" = true ] && printf private || printf insecure))"
  fi
}

