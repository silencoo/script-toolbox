#!/usr/bin/env bash
# agentctl — shared Shell frontend for coding-agent provider setup.
#
# Per-client setup.sh files remain the implementation and raw-URL-compatible
# entrypoints. This command selects one of them without taking ownership of
# MCP profiles, persistent instructions, or the installed CLI binary.

set -euo pipefail
umask 077

SOURCE_PATH="${BASH_SOURCE[0]}"
while [ -L "$SOURCE_PATH" ]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
  SOURCE_PATH="$(readlink "$SOURCE_PATH")"
  case "$SOURCE_PATH" in
    /*) ;;
    *) SOURCE_PATH="${SOURCE_DIR}/${SOURCE_PATH}" ;;
  esac
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
DEFAULT_AGENT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
VERSION="0.5.0"
WORKSPACE_CLIENT="${SCRIPT_DIR}/workspace-client.mjs"
ORCHESTRATOR_CLIENT="${SCRIPT_DIR}/orchestrator-client.mjs"
TUI_CLIENT="${SCRIPT_DIR}/../tui/dist/toolbox-tui.mjs"

# shellcheck source=../ctl-lib.sh
. "${SCRIPT_DIR}/../ctl-lib.sh"

usage() {
  cat <<'EOF'
agentctl — install coding agents and configure providers/models

Usage:
  agentctl
  agentctl tui
  agentctl interactive
  agentctl setup <claude|codex|opencode|pi> [setup options]
  agentctl status <claude|codex|opencode|pi|all> [--json]
  agentctl providers <claude|codex|opencode|pi>
  agentctl uninstall <claude|codex|opencode|pi> [--yes]
  agentctl help <claude|codex|opencode|pi>
  agentctl workspace <command> [options]
  agentctl preset <list|show|create|delete|plan|apply|current|rollback|push|pull> ...
  agentctl doctor [claude|codex|all] [--target <target>] [--json]

Commands:
  setup       Install the selected CLI when missing, then configure its
              provider, model, and credential. "init" and "configure" are
              accepted aliases.
  status      Read CLI/provider configuration source and credential metadata,
              including external Claude config and official Codex login.
              Secret values are never emitted.
  providers   Show the selected client's provider/model presets.
  uninstall   Remove only provider/model/credential state owned by setup.sh.
              It does not remove MCP state, Promptctl files, or the CLI binary.
  help        Show the selected client's setup options.
  workspace   Manage one encrypted recovery key that opens attached MCP,
              Skills, and Prompts stores. Existing isolated stores remain
              independently usable.
  preset      Bind one MCP profile, Skills pack, and Prompt profile into a
              transactional development preset with plan/apply/rollback.
  doctor      Inspect providers, local selections, preset drift, secrets,
              remote stores, and session-restart guidance.

Run without arguments in a terminal for the unified TUI. Use "interactive"
for the guided Shell menu. Setup options after the
client name are passed unchanged to that client's existing setup.sh backend.
Run "agentctl workspace --help" for Workspace commands.
Run "agentctl preset --help" for development-preset commands.
EOF
}

run_workspace() {
  require_node22 "agentctl workspace"
  [ -r "$WORKSPACE_CLIENT" ] ||
    die "Workspace client not found: $WORKSPACE_CLIENT"
  exec node "$WORKSPACE_CLIENT" "$@"
}

run_orchestrator() {
  require_node22 "agentctl presets and doctor"
  [ -r "$ORCHESTRATOR_CLIENT" ] ||
    die "Orchestration client not found: $ORCHESTRATOR_CLIENT"
  AGENTCTL_SELF="${SCRIPT_DIR}/agentctl" exec node "$ORCHESTRATOR_CLIENT" "$@"
}

resolve_agent_root() {
  local requested="${AGENTCTL_AGENT_ROOT:-$DEFAULT_AGENT_ROOT}"
  [ -d "$requested" ] || die "agent backend root does not exist: $requested"
  AGENT_ROOT="$(cd "$requested" && pwd)"
}

resolve_client() {
  if [ -z "${AGENT_ROOT:-}" ]; then
    resolve_agent_root
  fi
  case "$1" in
    claude|claude-code)
      CLIENT_ID="claude"
      CLIENT_DIR="claude-code"
      CLIENT_LABEL="Claude Code"
      ;;
    codex)
      CLIENT_ID="codex"
      CLIENT_DIR="codex"
      CLIENT_LABEL="Codex"
      ;;
    opencode|open-code)
      CLIENT_ID="opencode"
      CLIENT_DIR="opencode"
      CLIENT_LABEL="OpenCode"
      ;;
    pi)
      CLIENT_ID="pi"
      CLIENT_DIR="pi"
      CLIENT_LABEL="Pi"
      ;;
    *)
      die "unsupported client '$1'; choose claude, codex, opencode, or pi"
      ;;
  esac

  SETUP_SCRIPT="${AGENT_ROOT}/${CLIENT_DIR}/setup.sh"
  [ -f "$SETUP_SCRIPT" ] ||
    die "setup backend not found for ${CLIENT_LABEL}: $SETUP_SCRIPT"
  [ -x "$SETUP_SCRIPT" ] ||
    die "setup backend is not executable: $SETUP_SCRIPT"
}

select_client() {
  choose_menu \
    "Which coding agent?" 1 \
    "claude|Claude Code" \
    "codex|Codex" \
    "opencode|OpenCode" \
    "pi|Pi"
  resolve_client "$MENU_VALUE"
}

run_setup() {
  local requested="$1"
  shift
  resolve_client "$requested"
  if [ "${1:-}" = "--" ]; then
    shift
  fi
  log "Opening ${CLIENT_LABEL} provider setup..."
  AGENTCTL_SETUP_COMMAND="${SCRIPT_DIR}/agentctl setup ${CLIENT_ID}" \
    AGENTCTL_UNINSTALL_COMMAND="${SCRIPT_DIR}/agentctl uninstall ${CLIENT_ID}" \
    exec "$SETUP_SCRIPT" "$@"
}

run_providers() {
  local requested="$1"
  shift
  [ $# -eq 0 ] || die "providers accepts only a client name"
  resolve_client "$requested"
  exec "$SETUP_SCRIPT" --list-providers
}

run_client_help() {
  local requested="$1"
  shift
  [ $# -eq 0 ] || die "help accepts only a client name"
  resolve_client "$requested"
  AGENTCTL_SETUP_COMMAND="${SCRIPT_DIR}/agentctl setup ${CLIENT_ID}" \
    AGENTCTL_UNINSTALL_COMMAND="${SCRIPT_DIR}/agentctl uninstall ${CLIENT_ID}" \
    exec "$SETUP_SCRIPT" --help
}

status_file_mode() {
  local path="$1" mode=""
  mode="$(stat -c '%a' "$path" 2>/dev/null || stat -f '%Lp' "$path" 2>/dev/null || true)"
  printf '%s' "$mode"
}

status_json_value() {
  local path="$1" filter="$2"
  [ -f "$path" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  jq -r "$filter" "$path" 2>/dev/null || true
}

status_toml_top_level_value() {
  local path="$1" wanted="$2"
  [ -f "$path" ] || return 0
  awk -v wanted="$wanted" '
    /^[[:space:]]*\[[^]]+\]/ { exit }
    {
      line = $0
      if (line ~ "^[[:space:]]*" wanted "[[:space:]]*=") {
        sub(/^[^=]*=[[:space:]]*/, "", line)
        sub(/[[:space:]]*#.*$/, "", line)
        sub(/[[:space:]]*$/, "", line)
        if (line ~ /^".*"$/) {
          sub(/^"/, "", line)
          sub(/"$/, "", line)
        }
        print line
        exit
      }
    }
  ' "$path"
}

status_safe_provider() {
  local value="$1"
  STATUS_SAFE_VALUE=""
  case "$CLIENT_ID" in
    claude)
      case "$value" in
        anthropic|deepseek|openrouter|minimax-cn|minimax-global|custom)
          STATUS_SAFE_VALUE="$value"
          ;;
      esac
      ;;
    codex)
      case "$value" in
        ""|*[!A-Za-z0-9._-]*) ;;
        script_toolbox_*) STATUS_SAFE_VALUE="$value" ;;
      esac
      ;;
    opencode|pi)
      case "$value" in
        ""|*[!A-Za-z0-9._-]*) ;;
        script-toolbox-*) STATUS_SAFE_VALUE="$value" ;;
      esac
      ;;
  esac
}

status_set_metadata() {
  CONFIG_FILE_1=""
  CONFIG_FILE_2=""
  STATE_FILE=""
  AUTH_FILE=""
  CLI_COMMAND=""
  CREDENTIAL_KIND="file"
  CREDENTIAL_EXPECTED_PREFIX=""

  case "$CLIENT_ID" in
    claude)
      CLI_COMMAND="claude"
      CONFIG_FILE_1="${HOME}/.claude/settings.json"
      STATE_FILE="${HOME}/.claude/.script-toolbox-provider"
      CREDENTIAL_KIND="embedded"
      ;;
    codex)
      CLI_COMMAND="codex"
      CONFIG_FILE_1="${HOME}/.codex/config.toml"
      STATE_FILE="${HOME}/.codex/.script-toolbox-provider-key"
      AUTH_FILE="${HOME}/.codex/auth.json"
      CREDENTIAL_EXPECTED_PREFIX="${HOME}/.codex/provider-keys/"
      ;;
    opencode)
      CLI_COMMAND="opencode"
      CONFIG_FILE_1="${HOME}/.config/opencode/opencode.json"
      STATE_FILE="${HOME}/.config/opencode/.script-toolbox-provider"
      CREDENTIAL_EXPECTED_PREFIX="${HOME}/.config/opencode/provider-keys/"
      ;;
    pi)
      CLI_COMMAND="pi"
      CONFIG_FILE_1="${HOME}/.pi/agent/settings.json"
      CONFIG_FILE_2="${HOME}/.pi/agent/models.json"
      STATE_FILE="${HOME}/.pi/agent/.script-toolbox-provider"
      CREDENTIAL_EXPECTED_PREFIX="${HOME}/.pi/agent/provider-keys/"
      ;;
  esac
}

status_prepare() {
  local raw_value="" candidate="" raw_version=""

  status_set_metadata
  CLI_INSTALLED=false
  CLI_PATH=""
  CLI_VERSION=""
  CONFIG_EXISTS=false
  CONFIG_VALID=false
  STATE_EXISTS=false
  OWNERSHIP_MARKER=false
  PROVIDER_STATUS="not-configured"
  PROVIDER_SOURCE="none"
  STATUS_PROVIDER=""
  STATUS_MODEL=""
  CREDENTIAL_FILE=""
  CREDENTIAL_EXISTS=false
  CREDENTIAL_MODE=""
  CREDENTIAL_PRIVATE=false
  CREDENTIAL_PATH_VALID=true

  if command -v "$CLI_COMMAND" >/dev/null 2>&1; then
    CLI_INSTALLED=true
    CLI_PATH="$(command -v "$CLI_COMMAND" 2>/dev/null | sed -n '1p')"
    raw_version="$("$CLI_COMMAND" --version 2>/dev/null || true)"
    CLI_VERSION="$(printf '%s\n' "$raw_version" |
      LC_ALL=C tr -cd '\11\12\15\40-\176' |
      sed -n '1p' |
      cut -c1-160)"
  fi

  if [ -f "$CONFIG_FILE_1" ] &&
     { [ -z "$CONFIG_FILE_2" ] || [ -f "$CONFIG_FILE_2" ]; }; then
    CONFIG_EXISTS=true
    CONFIG_VALID=true
    if command -v jq >/dev/null 2>&1; then
      case "$CLIENT_ID" in
        claude|opencode)
          jq -e 'type == "object"' "$CONFIG_FILE_1" >/dev/null 2>&1 ||
            CONFIG_VALID=false
          ;;
        pi)
          jq -e 'type == "object"' "$CONFIG_FILE_1" >/dev/null 2>&1 &&
            jq -e 'type == "object"' "$CONFIG_FILE_2" >/dev/null 2>&1 ||
            CONFIG_VALID=false
          ;;
      esac
    fi
  fi
  [ ! -f "$STATE_FILE" ] || STATE_EXISTS=true

  case "$CLIENT_ID" in
    claude)
      if [ "$STATE_EXISTS" = true ]; then
        OWNERSHIP_MARKER=true
        PROVIDER_SOURCE="agentctl"
        raw_value="$(sed -n '1p' "$STATE_FILE")"
        status_safe_provider "$raw_value"
        STATUS_PROVIDER="$STATUS_SAFE_VALUE"
      fi
      STATUS_MODEL="$(status_json_value "$CONFIG_FILE_1" '
        .model
        // .env.ANTHROPIC_MODEL
        // .env.ANTHROPIC_DEFAULT_SONNET_MODEL
        // empty
      ')"
      CREDENTIAL_FILE="$CONFIG_FILE_1"
      if [ -f "$CONFIG_FILE_1" ]; then
        if command -v jq >/dev/null 2>&1; then
          if jq -e '
            ((.env.ANTHROPIC_API_KEY // "") | length > 0)
            or ((.env.ANTHROPIC_AUTH_TOKEN // "") | length > 0)
          ' "$CONFIG_FILE_1" >/dev/null 2>&1; then
            CREDENTIAL_EXISTS=true
          fi
        elif [ "$STATE_EXISTS" = true ]; then
          CREDENTIAL_EXISTS=true
        fi
      fi
      if [ "$OWNERSHIP_MARKER" != true ] &&
         [ "$CONFIG_VALID" = true ] &&
         [ "$CREDENTIAL_EXISTS" = true ]; then
        PROVIDER_SOURCE="external"
        if command -v jq >/dev/null 2>&1 &&
           jq -e '((.env.ANTHROPIC_BASE_URL // "") | length > 0)' \
             "$CONFIG_FILE_1" >/dev/null 2>&1; then
          STATUS_PROVIDER="external-endpoint"
        else
          STATUS_PROVIDER="anthropic"
        fi
      fi
      ;;
    codex)
      if grep -qF '# >>> agent/codex/setup.sh >>>' "$CONFIG_FILE_1" 2>/dev/null ||
         [ "$STATE_EXISTS" = true ]; then
        OWNERSHIP_MARKER=true
        PROVIDER_SOURCE="agentctl"
      fi
      raw_value="$(status_toml_top_level_value "$CONFIG_FILE_1" model_provider)"
      status_safe_provider "$raw_value"
      STATUS_PROVIDER="$STATUS_SAFE_VALUE"
      STATUS_MODEL="$(status_toml_top_level_value "$CONFIG_FILE_1" model)"
      if [ "$OWNERSHIP_MARKER" = true ] &&
         { [ -z "$STATUS_PROVIDER" ] || [ -z "$STATUS_MODEL" ]; }; then
        CONFIG_VALID=false
      fi
      if [ "$STATE_EXISTS" = true ]; then
        candidate="$(sed -n '1p' "$STATE_FILE")"
      fi
      if [ "$OWNERSHIP_MARKER" != true ] &&
         [ -f "$AUTH_FILE" ] &&
         command -v jq >/dev/null 2>&1; then
        if jq -e '
          .auth_mode == "chatgpt"
          and ((.tokens // {}) | [.. | strings | select(length > 0)] | length > 0)
        ' "$AUTH_FILE" >/dev/null 2>&1; then
          PROVIDER_SOURCE="official-login"
          STATUS_PROVIDER="openai-chatgpt"
          CREDENTIAL_KIND="official-auth"
          CREDENTIAL_FILE="$AUTH_FILE"
          CREDENTIAL_EXISTS=true
        elif jq -e '((.OPENAI_API_KEY // "") | length > 0)' \
          "$AUTH_FILE" >/dev/null 2>&1; then
          PROVIDER_SOURCE="official-login"
          STATUS_PROVIDER="openai"
          CREDENTIAL_KIND="official-auth"
          CREDENTIAL_FILE="$AUTH_FILE"
          CREDENTIAL_EXISTS=true
        fi
      fi
      ;;
    opencode)
      if grep -q '"script-toolbox-' "$CONFIG_FILE_1" 2>/dev/null ||
         [ "$STATE_EXISTS" = true ]; then
        OWNERSHIP_MARKER=true
      fi
      if [ "$STATE_EXISTS" = true ]; then
        raw_value="$(sed -n '1p' "$STATE_FILE")"
        status_safe_provider "$raw_value"
        STATUS_PROVIDER="$STATUS_SAFE_VALUE"
        candidate="$(sed -n '2p' "$STATE_FILE")"
      fi
      STATUS_MODEL="$(status_json_value "$CONFIG_FILE_1" '.model // empty')"
      case "$STATUS_MODEL" in
        "${STATUS_PROVIDER}/"*) STATUS_MODEL="${STATUS_MODEL#"${STATUS_PROVIDER}/"}" ;;
      esac
      ;;
    pi)
      if grep -q '"script-toolbox-' "$CONFIG_FILE_2" 2>/dev/null ||
         [ "$STATE_EXISTS" = true ]; then
        OWNERSHIP_MARKER=true
      fi
      if [ "$STATE_EXISTS" = true ]; then
        raw_value="$(sed -n '1p' "$STATE_FILE")"
        status_safe_provider "$raw_value"
        STATUS_PROVIDER="$STATUS_SAFE_VALUE"
        candidate="$(sed -n '2p' "$STATE_FILE")"
      fi
      STATUS_MODEL="$(status_json_value "$CONFIG_FILE_1" '.defaultModel // empty')"
      ;;
  esac
  STATUS_MODEL="$(printf '%s' "$STATUS_MODEL" |
    tr '\r\n' '  ' |
    cut -c1-240)"

  if [ "$CREDENTIAL_KIND" = "file" ] && [ -n "$candidate" ]; then
    case "$candidate" in
      "$CREDENTIAL_EXPECTED_PREFIX"*.key)
        CREDENTIAL_FILE="$candidate"
        ;;
      *)
        CREDENTIAL_PATH_VALID=false
        ;;
    esac
  fi
  if [ "$CREDENTIAL_KIND" = "file" ] &&
     [ "$CREDENTIAL_PATH_VALID" = true ] &&
     [ -n "$CREDENTIAL_FILE" ] &&
     [ -f "$CREDENTIAL_FILE" ]; then
    CREDENTIAL_EXISTS=true
  fi
  if [ "$CREDENTIAL_EXISTS" = true ]; then
    CREDENTIAL_MODE="$(status_file_mode "$CREDENTIAL_FILE")"
    case "$CREDENTIAL_MODE" in
      ?00|??00) CREDENTIAL_PRIVATE=true ;;
    esac
  fi

  if [ "$OWNERSHIP_MARKER" = true ]; then
    if [ "$CONFIG_EXISTS" = true ] &&
       [ "$CONFIG_VALID" = true ] &&
       [ "$STATE_EXISTS" = true ] &&
       [ -n "$STATUS_PROVIDER" ] &&
       [ "$CREDENTIAL_EXISTS" = true ] &&
       [ "$CREDENTIAL_PRIVATE" = true ] &&
       [ "$CREDENTIAL_PATH_VALID" = true ]; then
      PROVIDER_STATUS="configured"
    else
      PROVIDER_STATUS="incomplete"
    fi
  elif [ "$PROVIDER_SOURCE" = "external" ]; then
    if [ "$CONFIG_VALID" = true ] &&
       [ -n "$STATUS_PROVIDER" ] &&
       [ "$CREDENTIAL_EXISTS" = true ]; then
      PROVIDER_STATUS="configured"
    else
      PROVIDER_STATUS="incomplete"
    fi
  elif [ "$PROVIDER_SOURCE" = "official-login" ]; then
    if [ -n "$STATUS_PROVIDER" ] && [ "$CREDENTIAL_EXISTS" = true ]; then
      PROVIDER_STATUS="configured"
    else
      PROVIDER_STATUS="incomplete"
    fi
  fi
}

status_emit_human() {
  log "${CLIENT_LABEL}"
  if [ "$CLI_INSTALLED" = true ]; then
    log "  CLI         : installed${CLI_VERSION:+ ($CLI_VERSION)}"
    log "  CLI path    : $CLI_PATH"
  else
    log "  CLI         : not installed"
  fi
  log "  Provider    : ${PROVIDER_STATUS}${STATUS_PROVIDER:+ ($STATUS_PROVIDER)}"
  log "  Source      : $PROVIDER_SOURCE"
  log "  Model       : ${STATUS_MODEL:-not resolved}"
  log "  Config      : $CONFIG_FILE_1"
  [ -z "$CONFIG_FILE_2" ] || log "                $CONFIG_FILE_2"
  if [ "$CONFIG_EXISTS" = true ]; then
    log "  Config state: $([ "$CONFIG_VALID" = true ] && printf valid || printf invalid)"
  else
    log "  Config state: missing"
  fi
  log "  Ownership   : $([ "$OWNERSHIP_MARKER" = true ] && printf present || printf missing)"
  log "  State file  : $STATE_FILE ($([ "$STATE_EXISTS" = true ] && printf present || printf missing))"
  if [ "$CREDENTIAL_PATH_VALID" != true ]; then
    log "  Credential  : invalid path in ownership state (value hidden)"
  elif [ "$CREDENTIAL_EXISTS" = true ]; then
    log "  Credential  : $CREDENTIAL_KIND; $CREDENTIAL_FILE (mode ${CREDENTIAL_MODE:-unknown}, $([ "$CREDENTIAL_PRIVATE" = true ] && printf private || printf insecure))"
  else
    log "  Credential  : $CREDENTIAL_KIND; missing${CREDENTIAL_FILE:+ ($CREDENTIAL_FILE)}"
  fi
}

status_emit_json() {
  jq -n \
    --arg client "$CLIENT_ID" \
    --arg label "$CLIENT_LABEL" \
    --arg cli_path "$CLI_PATH" \
    --arg cli_version "$CLI_VERSION" \
    --arg provider_status "$PROVIDER_STATUS" \
    --arg provider_source "$PROVIDER_SOURCE" \
    --arg provider "$STATUS_PROVIDER" \
    --arg model "$STATUS_MODEL" \
    --arg config_file_1 "$CONFIG_FILE_1" \
    --arg config_file_2 "$CONFIG_FILE_2" \
    --arg state_file "$STATE_FILE" \
    --arg credential_kind "$CREDENTIAL_KIND" \
    --arg credential_file "$CREDENTIAL_FILE" \
    --arg credential_mode "$CREDENTIAL_MODE" \
    --argjson cli_installed "$CLI_INSTALLED" \
    --argjson config_exists "$CONFIG_EXISTS" \
    --argjson config_valid "$CONFIG_VALID" \
    --argjson state_exists "$STATE_EXISTS" \
    --argjson ownership_marker "$OWNERSHIP_MARKER" \
    --argjson credential_exists "$CREDENTIAL_EXISTS" \
    --argjson credential_private "$CREDENTIAL_PRIVATE" \
    --argjson credential_path_valid "$CREDENTIAL_PATH_VALID" '
      {
        client: $client,
        label: $label,
        cli_installed: $cli_installed,
        cli_path: (if $cli_path == "" then null else $cli_path end),
        cli_version: (if $cli_version == "" then null else $cli_version end),
        provider_status: $provider_status,
        provider_source: $provider_source,
        provider: (if $provider == "" then null else $provider end),
        model: (if $model == "" then null else $model end),
        config_files: (
          [$config_file_1, $config_file_2] | map(select(length > 0))
        ),
        config_exists: $config_exists,
        config_valid: $config_valid,
        state_file: $state_file,
        state_exists: $state_exists,
        ownership_marker: $ownership_marker,
        credential_kind: $credential_kind,
        credential_file: (
          if $credential_file == "" then null else $credential_file end
        ),
        credential_exists: $credential_exists,
        credential_private: $credential_private,
        credential_mode: (
          if $credential_mode == "" then null else $credential_mode end
        ),
        credential_path_valid: $credential_path_valid
      }
    '
}

run_status() {
  local requested="" json_output=0 client first=1

  while [ $# -gt 0 ]; do
    case "$1" in
      --json)
        json_output=1
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        [ -z "$requested" ] || die "status accepts one client name and optional --json"
        requested="$1"
        shift
        ;;
    esac
  done
  [ -n "$requested" ] || die "status requires a client name or all"
  if [ "$json_output" = 1 ]; then
    command -v jq >/dev/null 2>&1 ||
      die "jq is required for status --json; install jq and re-run"
  fi

  if [ "$requested" = "all" ]; then
    if [ "$json_output" = 1 ]; then
      {
        for client in claude codex opencode pi; do
          resolve_client "$client"
          status_prepare
          status_emit_json
        done
      } | jq -s '.'
    else
      for client in claude codex opencode pi; do
        resolve_client "$client"
        status_prepare
        if [ "$first" -ne 1 ]; then
          log ""
        fi
        status_emit_human
        first=0
      done
    fi
    return 0
  fi

  resolve_client "$requested"
  status_prepare
  if [ "$json_output" = 1 ]; then
    status_emit_json
  else
    status_emit_human
  fi
}

run_uninstall() {
  local requested="$1" assume_yes=0
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes|-y)
        assume_yes=1
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        die "uninstall accepts only --yes after the client name"
        ;;
    esac
  done

  resolve_client "$requested"
  if [ "$assume_yes" -ne 1 ]; then
    log "This removes only agentctl-managed ${CLIENT_LABEL} provider state."
    log "MCP configuration, Promptctl instructions, and the CLI stay installed."
    if ! ask_yes_no "Continue with ${CLIENT_LABEL} provider uninstall?" "no"; then
      log "[cancelled] no provider configuration was changed"
      return 0
    fi
  fi
  exec "$SETUP_SCRIPT" --uninstall
}

run_interactive() {
  local action
  if [ $# -gt 0 ]; then
    [ $# -eq 1 ] || die "interactive mode does not accept options"
    case "$1" in
      -h|--help) usage; return 0 ;;
      *) die "interactive mode does not accept options" ;;
    esac
  fi

  log "Agentctl guided Shell setup"
  log "Agent providers and the encrypted Toolbox Workspace are managed here."

  choose_menu \
    "What would you like to do?" 1 \
    "setup|Install or configure a coding agent" \
    "status|Inspect client and provider status" \
    "providers|List provider and model presets" \
    "workspace|Inspect the unified MCP / Skills / Prompts Workspace" \
    "uninstall|Remove managed provider configuration" \
    "exit|Exit without changes"
  action="$MENU_VALUE"
  if [ "$action" = "exit" ]; then
    log "No changes were made."
    return 0
  fi

  if [ "$action" = "workspace" ]; then
    run_workspace status
  fi

  select_client
  case "$action" in
    setup)
      log "Opening ${CLIENT_LABEL} provider setup..."
      AGENTCTL_SETUP_COMMAND="${SCRIPT_DIR}/agentctl setup ${CLIENT_ID}" \
        AGENTCTL_UNINSTALL_COMMAND="${SCRIPT_DIR}/agentctl uninstall ${CLIENT_ID}" \
        exec "$SETUP_SCRIPT"
      ;;
    status)
      run_status "$CLIENT_ID"
      ;;
    providers)
      exec "$SETUP_SCRIPT" --list-providers
      ;;
    uninstall)
      run_uninstall "$CLIENT_ID"
      ;;
  esac
}

case "${1:-}" in
  "")
    if [ -t 0 ] && [ -t 1 ]; then
      run_agent_tui "$TUI_CLIENT" overview
    else
      run_interactive
    fi
    ;;
  tui)
    shift
    run_agent_tui "$TUI_CLIENT" overview "$@"
    ;;
  interactive)
    shift
    run_interactive "$@"
    ;;
  setup|init|configure)
    [ $# -ge 2 ] || die "$1 requires a client name"
    shift
    run_setup "$@"
    ;;
  status)
    shift
    run_status "$@"
    ;;
  providers|list-providers)
    [ $# -eq 2 ] || die "$1 requires exactly one client name"
    shift
    run_providers "$@"
    ;;
  uninstall|remove)
    [ $# -ge 2 ] || die "$1 requires a client name"
    shift
    run_uninstall "$@"
    ;;
  help)
    [ $# -eq 2 ] || die "help requires exactly one client name"
    shift
    run_client_help "$@"
    ;;
  workspace)
    shift
    run_workspace "$@"
    ;;
  preset)
    run_orchestrator "$@"
    ;;
  doctor)
    run_orchestrator "$@"
    ;;
  -h|--help)
    usage
    ;;
  -V|--version)
    printf 'agentctl %s\n' "$VERSION"
    ;;
  *)
    die "unknown command '$1'; use --help"
    ;;
esac
