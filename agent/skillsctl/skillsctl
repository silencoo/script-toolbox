#!/usr/bin/env bash
# skillsctl — guided frontend for portable skill packs and recovery.

set -euo pipefail
umask 077

SOURCE_PATH="${BASH_SOURCE[0]}"
while [ -L "$SOURCE_PATH" ]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
  SOURCE_PATH="$(readlink "$SOURCE_PATH")"
  case "$SOURCE_PATH" in
    /*) ;;
    *) SOURCE_PATH="${SOURCE_DIR}/${SOURCE_PATH}" ;;
  esac
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
ENGINE="${SCRIPT_DIR}/skillsctl.mjs"
TUI_CLIENT="${SCRIPT_DIR}/../tui/dist/toolbox-tui.mjs"

# shellcheck source=../ctl-lib.sh
. "${SCRIPT_DIR}/../ctl-lib.sh"

if ! command -v node >/dev/null 2>&1; then
  printf '✗ skillsctl requires Node.js 22 or newer\n' >&2
  exit 1
fi

node_major="$(node -p 'Number(process.versions.node.split(".")[0])' 2>/dev/null || printf '0')"
if [ "$node_major" -lt 22 ]; then
  printf '✗ skillsctl requires Node.js 22 or newer (found %s)\n' "$node_major" >&2
  exit 1
fi

if [ $# -eq 0 ] && [ -t 0 ] && [ -t 1 ]; then
  run_agent_tui "$TUI_CLIENT" skills
fi
if [ "${1:-}" = "tui" ]; then
  shift
  run_agent_tui "$TUI_CLIENT" skills "$@"
fi
if [ "${1:-}" = "update" ]; then
  shift
  run_ctl_update "${SCRIPT_DIR}/../update-commands.sh" skillsctl "$@"
fi

exec node "$ENGINE" "$@"
