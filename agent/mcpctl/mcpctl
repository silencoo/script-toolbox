if [ "$COMMAND" = "secrets-status" ]; then
  printf 'Store:          %s\n' "$STORE_DIR"
  printf 'Encrypted file: %s (%s)\n' \
    "$SECRETS_FILE" \
    "$([ -f "$SECRETS_FILE" ] && printf 'present' || printf 'not created')"
  printf 'Remote cache:   %s (%s)\n' \
    "$REMOTE_SECRETS_FILE" \
    "$([ -f "$REMOTE_SECRETS_FILE" ] && printf 'present' || printf 'not restored')"
  log "Secret sources:"
  while IFS=$'\t' read -r server secret_name env_name required; do
    [ -n "$server" ] || continue
    if [ -n "$env_name" ] &&
       [ -n "$(printenv "$env_name" 2>/dev/null || true)" ]; then
      printf '  - %s / %s: env %s (available)\n' \
        "$server" "$secret_name" "$env_name"
    elif [ -f "$SECRETS_FILE" ]; then
      printf '  - %s / %s: encrypted SOPS file present\n' \
        "$server" "$secret_name"
    elif [ -f "$REMOTE_SECRETS_FILE" ]; then
      printf '  - %s / %s: encrypted remote cache present\n' \
        "$server" "$secret_name"
    elif [ "$required" = "true" ]; then
      printf '  - %s / %s: missing%s\n' \
        "$server" "$secret_name" \
        "$([ -n "$env_name" ] && printf ' (env %s)' "$env_name")"
    else
      printf '  - %s / %s: optional and not configured%s\n' \
        "$server" "$secret_name" \
        "$([ -n "$env_name" ] && printf ' (env %s)' "$env_name")"
    fi
  done < <(
    jq -r '
      [
        .servers
        | to_entries[]
        | . as $server
        | (
            [$server.value]
            + (($server.value.target_overrides // {}) | [.[]])
          )[]
        | . as $definition
        | (
            ($definition.auth // empty),
            (($definition.environment // {})[] | select(type == "object")),
            (($definition.headers // {})[] | select(type == "object")),
            (($definition.command // [])[] | select(type == "object"))
          )
        | select(
            type == "object"
            and (.secret | type == "string" and length > 0)
          )
        | {
            server: $server.key,
            secret: .secret,
            env: (.env // ""),
            required: (if has("required") then .required else true end)
          }
      ]
      | unique_by([.server, .secret])
      | sort_by([.server, .secret])
      | .[]
      | [.server, .secret, .env, .required]
      | @tsv
    ' "$CATALOG_FILE"
  )
  exit 0
fi

if [ "$COMMAND" = "secrets-edit" ]; then
  sops_bin="${MCPCTL_SOPS_BIN:-sops}"
  command -v "$sops_bin" >/dev/null 2>&1 ||
    die "sops is required; install SOPS, configure an age/KMS recipient, and retry"
  [ ! -L "$SECRETS_FILE" ] ||
    die "refusing to edit encrypted Secrets through symlink $SECRETS_FILE"
  secrets_dir="$(dirname "$SECRETS_FILE")"
  secrets_name="$(basename "$SECRETS_FILE")"
  mkdir -p "$secrets_dir"

  if [ ! -e "$SECRETS_FILE" ]; then
    make_temp_near "$SECRETS_FILE"
    output="$TEMP_RESULT"
    if ! printf '%s\n' '{"schema":1,"secrets":{}}' |
      (
        cd "$secrets_dir"
        "$sops_bin" encrypt \
          --filename-override "$secrets_name" \
          --input-type json \
          --output-type json
      ) > "$output"; then
      die "could not create $SECRETS_FILE; configure .sops.yaml or SOPS encryption recipients"
    fi
    chmod 600 "$output"
    mv "$output" "$SECRETS_FILE"
    ok "created encrypted Secret file at $SECRETS_FILE"
  else
    [ -f "$SECRETS_FILE" ] ||
      die "encrypted Secret path is not a regular file: $SECRETS_FILE"
  fi

  (
    cd "$secrets_dir"
    "$sops_bin" edit "$secrets_name"
  )
  chmod 600 "$SECRETS_FILE"
  if ! "$sops_bin" decrypt --output-type json "$SECRETS_FILE" |
    jq -e '
      type == "object"
      and .schema == 1
      and (.secrets | type == "object")
      and all(.secrets[]; type == "string")
    ' >/dev/null; then
    die "decrypted $SECRETS_FILE must contain schema 1 and a string-valued .secrets object"
  fi
  ok "validated encrypted Secrets without printing their values"
  exit 0
fi

if [ "$COMMAND" = "sync" ]; then
  [ ! -L "$CATALOG_FILE" ] ||
    die "refusing to replace symlink $CATALOG_FILE"
  [ -d "$STORE_DIR/profiles" ] ||
    die "store is incomplete: missing $STORE_DIR/profiles"
  [ ! -L "$STORE_DIR/profiles" ] ||
    die "refusing to update symlinked profile directory $STORE_DIR/profiles"
  jq -e '
    type == "object"
    and .schema == 1
    and (.servers | type == "object")
  ' "$TEMPLATE_STORE/catalog.json" >/dev/null 2>&1 ||
    die "bundled MCP catalog is invalid"

  added_servers="$(
    jq -nr \
      --slurpfile current "$CATALOG_FILE" \
      --slurpfile bundled "$TEMPLATE_STORE/catalog.json" '
        [
          $bundled[0].servers
          | keys[]
          | select($current[0].servers[.] == null)
        ]
        | .[]
      '
  )"
  added_server_count="$(
    if [ -n "$added_servers" ]; then
      printf '%s\n' "$added_servers" | awk 'NF { count += 1 } END { print count + 0 }'
    else
      printf '0'
    fi
  )"

  if [ "$added_server_count" -gt 0 ]; then
    make_temp_near "$CATALOG_FILE"
    output="$TEMP_RESULT"
    jq --slurpfile bundled "$TEMPLATE_STORE/catalog.json" '
      .servers = ($bundled[0].servers + .servers)
    ' "$CATALOG_FILE" > "$output"
    chmod 600 "$output"
    mv "$output" "$CATALOG_FILE"
  fi

  host_metadata_before="$(jq '[.servers[] | select(.host != null)] | length' \
    "$CATALOG_FILE")"
  make_temp_near "$CATALOG_FILE"
  output="$TEMP_RESULT"
  jq --slurpfile bundled "$TEMPLATE_STORE/catalog.json" '
    def can_adopt_host($current; $reference):
      ($reference.host.install.type // "") as $installer
      | ($reference.host.install.package // "") as $package
      | ($current.command // []) as $command
      | ($reference.host != null)
      and ($current.host == null)
      and (
        (($current.homepage // "") == ($reference.homepage // ""))
        or (
          ($current.homepage // "") == ""
          and ($installer == "npm" or $installer == "uv")
          and (($command | index($package)) != null)
        )
      )
      and (($current.transport // "") == ($reference.transport // ""))
      and (
        if $installer == "npm" or $installer == "uv" then
          (($command | index($package)) != null)
          or ($current.command == $reference.command)
        elif $installer == "manual" then
          ($current.command // null) == ($reference.command // null)
        elif $installer == "none" then
          ($current.url // "") == ($reference.url // "")
        else
          false
        end
      );

    reduce ($bundled[0].servers | keys[]) as $name (.;
      .servers[$name] as $current
      | $bundled[0].servers[$name] as $reference
      | if $current != null and can_adopt_host($current; $reference) then
          .servers[$name].host = $reference.host
          | ($current.command // []) as $command
          | ($reference.host.install.package // "") as $package
          | if ($command[0] == "npx"
                and $command[1] == "-y"
                and $command[2] == $package) then
              .servers[$name].command =
                (($reference.command[0:6]) + $command[3:])
            elif ($command[0] == "uvx"
                  and $command[1] == $package) then
              .servers[$name].command =
                (($reference.command[0:6]) + $command[2:])
            elif ($command[0] == "@mcpctl/adapters/mcp-host"
                  and $command[1] == "js-reverse"
                  and $command[2] == $package) then
              .servers[$name].command =
                ([$command[0], $command[1], $name] + $command[2:])
            else
              .
            end
        else
          .
        end
    )
  ' "$CATALOG_FILE" > "$output"
  host_metadata_after="$(jq '[.servers[] | select(.host != null)] | length' \
    "$output")"
  host_metadata_count=$((host_metadata_after - host_metadata_before))
  if ! cmp -s "$CATALOG_FILE" "$output"; then
    chmod 600 "$output"
    mv "$output" "$CATALOG_FILE"
  fi

  added_profile_count=0
  added_profiles=""
  while IFS= read -r source; do
    [ -n "$source" ] || continue
    filename="$(basename "$source")"
    target_path="$STORE_DIR/profiles/$filename"
    if [ -e "$target_path" ] || [ -L "$target_path" ]; then
      continue
    fi
    make_temp_near "$target_path"
    output="$TEMP_RESULT"
    cp "$source" "$output"
    chmod 600 "$output"
    mv "$output" "$target_path"
    profile_name="${filename%.json}"
    added_profiles="${added_profiles}${profile_name}
"
    added_profile_count=$((added_profile_count + 1))
  done < <(
    find "$TEMPLATE_STORE/profiles" -maxdepth 1 -type f -name '*.json' -print |
      LC_ALL=C sort
  )

  if [ "$added_server_count" -eq 0 ] &&
     [ "$host_metadata_count" -eq 0 ] &&
     [ "$added_profile_count" -eq 0 ]; then
    ok "store already contains every bundled server and profile"
  else
    ok "added ${added_server_count} server(s), ${host_metadata_count} host lifecycle definition(s), and ${added_profile_count} profile(s) to $STORE_DIR"
    if [ "$added_server_count" -gt 0 ]; then
      log "Added servers:"
      while IFS= read -r server; do
        [ -n "$server" ] && printf '  %s\n' "$server"
      done <<< "$added_servers"
    fi
    if [ "$added_profile_count" -gt 0 ]; then
      log "Added profiles:"
      while IFS= read -r profile_name; do
        [ -n "$profile_name" ] && printf '  %s\n' "$profile_name"
      done <<< "$added_profiles"
    fi
  fi
  log "Existing same-name servers and profiles were preserved."
  if [ "$host_metadata_count" -gt 0 ]; then
    log "Recognized legacy launchers received isolated-install metadata; custom package versions were not changed."
  fi
  exit 0
fi

case "$COMMAND" in
  remote-init)
    run_remote_init
    exit 0
    ;;
  backup|remote-backup)
    require_remote_node
    node "$REMOTE_CLIENT" backup \
      --store "$STORE_DIR" \
      --remote-config "$REMOTE_CONFIG_FILE" \
      --sops-file "$SECRETS_FILE"
    exit 0
    ;;
esac

profile_path() {
  validate_id "profile name" "$1"
  printf '%s/profiles/%s.json' "$STORE_DIR" "$1"
}

validate_profile_file() {
  local name="$1" path="$2"
  jq -e --arg expected "$name" '
    type == "object"
    and (.schema // 1) == 1
    and (.name == $expected)
    and ((.extends // []) | type == "array")
    and ((.enable // []) | type == "array")
    and ((.disable // []) | type == "array")
    and ((.target_overrides // {}) | type == "object")
    and all((.extends // [])[]; type == "string")
    and all((.enable // [])[]; type == "string")
    and all((.disable // [])[]; type == "string")
    and all((.target_overrides // {})[];
      type == "object"
      and ((.enable // []) | type == "array")
      and ((.disable // []) | type == "array")
      and all((.enable // [])[]; type == "string")
      and all((.disable // [])[]; type == "string")
    )
  ' "$path" >/dev/null 2>&1 ||
    die "$path is not a valid profile named '$name'"
}

PROFILE_ORDER=()
PROFILE_VISITING=" "
PROFILE_VISITED=" "

word_set_has() {
  case "$1" in
    *" $2 "*) return 0 ;;
    *) return 1 ;;
  esac
}

collect_profile_order() {
  local name="$1" path parent old_visiting
  validate_id "profile name" "$name"

  word_set_has "$PROFILE_VISITING" "$name" &&
    die "profile inheritance cycle detected at '$name'"
  word_set_has "$PROFILE_VISITED" "$name" && return 0

  path="$(profile_path "$name")"
  [ -f "$path" ] || die "unknown profile '$name' (missing $path)"
  validate_profile_file "$name" "$path"

  old_visiting="$PROFILE_VISITING"
  PROFILE_VISITING="${PROFILE_VISITING}${name} "
  while IFS= read -r parent; do
    [ -n "$parent" ] || continue
    collect_profile_order "$parent"
  done < <(jq -r '.extends[]?' "$path")
  PROFILE_VISITING="$old_visiting"

  PROFILE_VISITED="${PROFILE_VISITED}${name} "
  PROFILE_ORDER+=("$name")
}

apply_profile_layer() {
  local name="$1" path server
  path="$(profile_path "$name")"

  while IFS= read -r server; do
    [ -n "$server" ] || continue
    validate_id "server name" "$server"
    enable_server "$server"
  done < <(jq -r '.enable[]?' "$path")

  while IFS= read -r server; do
    [ -n "$server" ] || continue
    validate_id "server name" "$server"
    disable_server "$server"
  done < <(jq -r '.disable[]?' "$path")

  while IFS= read -r server; do
    [ -n "$server" ] || continue
    validate_id "server name" "$server"
    enable_server "$server"
  done < <(jq -r --arg target "$TARGET" \
    '.target_overrides[$target].enable[]?' "$path")

  while IFS= read -r server; do
    [ -n "$server" ] || continue
    validate_id "server name" "$server"
    disable_server "$server"
  done < <(jq -r --arg target "$TARGET" \
    '.target_overrides[$target].disable[]?' "$path")
}

effective_server() {
  local server="$1"
  jq -c --arg server "$server" --arg target "$TARGET" '
    .servers[$server] as $base
    | if $base == null then
        error("unknown server: " + $server)
      else
        ($base * (($base.target_overrides // {})[$target] // {}))
        | del(.target_overrides)
      end
  ' "$CATALOG_FILE"
}

resolved_effective_server() {
  local server="$1"
  effective_server "$server" | jq -c \
    --arg mcpctl_dir "$SCRIPT_DIR" \
    --arg store_dir "$STORE_DIR" '
    if (.command // null | type) == "array" then
      .command |= map(
        if type == "string" and startswith("@mcpctl/") then
          $mcpctl_dir + "/" + ltrimstr("@mcpctl/")
        elif type == "string" and startswith("@mcpctl-store/") then
          $store_dir + "/" + ltrimstr("@mcpctl-store/")
        else
          .
        end
      )
    else
      .
    end
  '
}

resolve_suppressed_servers() {
  local server
  SUPPRESSED=()
  [ "$TARGET" = "codex" ] || return 0
  while IFS= read -r server; do
    [ -n "$server" ] || continue
    array_has "$server" ${ENABLED[@]+"${ENABLED[@]}"} || SUPPRESSED+=("$server")
  done < <(
    jq -r --arg target "$TARGET" '
      [
        .servers
        | to_entries[]
        | . as $entry
        | ($entry.value * (($entry.value.target_overrides // {})[$target] // {}))
          as $definition
        | select(
            (((($definition.supported_targets // []) | length) == 0)
              or (($definition.supported_targets // []) | index($target)) != null)
            and (($definition.suppress_when_disabled // false) == true)
          )
        | $entry.key
      ]
      | sort[]
    ' "$CATALOG_FILE"
  )
}

validate_effective_server() {
  local server="$1" definition="$2" package_ref artifact expected_sha actual_sha requirement
  if ! printf '%s' "$definition" | jq -e --arg target "$TARGET" '
    type == "object"
    and (
      ((.supported_targets // []) | length) == 0
      or ((.supported_targets // []) | index($target)) != null
    )
    and (
      (.transport == "http" and (.url | type == "string") and (.url | length > 0))
      or
      (.transport == "stdio"
        and (.command | type == "array")
        and (.command | length > 0)
        and (.command[0] | type == "string" and length > 0)
        and all(.command[1:][];
          (type == "string" and length > 0)
          or (
            type == "object"
            and (.secret | type == "string" and length > 0)
            and ((.env // "") | type == "string")
            and ((.prefix // "") | type == "string")
            and ((.suffix // "") | type == "string")
            and ((if has("required") then .required else true end)
              | type == "boolean")
          )
        ))
    )
    and (
      (.auth // null) == null
      or (
        (.transport == "http")
        and (.auth.type == "header")
        and (.auth.header | type == "string" and length > 0)
        and (.auth.secret | type == "string" and length > 0)
        and ((.auth.env // "") | type == "string")
        and ((.auth.prefix // "") | type == "string")
        and ((if (.auth | has("required")) then .auth.required else true end)
          | type == "boolean")
      )
    )
    and ((.environment // {}) | type == "object")
    and all((.environment // {})[];
      type == "string"
      or (
        type == "object"
        and (.secret | type == "string" and length > 0)
        and ((.env // "") | type == "string")
        and ((.prefix // "") | type == "string")
        and ((.suffix // "") | type == "string")
        and ((if has("required") then .required else true end) | type == "boolean")
      )
    )
    and ((.headers // {}) | type == "object")
    and all((.headers // {})[];
      type == "string"
      or (
        type == "object"
        and (.secret | type == "string" and length > 0)
        and ((.env // "") | type == "string")
        and ((.prefix // "") | type == "string")
        and ((.suffix // "") | type == "string")
        and ((if has("required") then .required else true end) | type == "boolean")
      )
    )
    and ((.cwd // "") | type == "string")
    and ((.env_vars // []) | type == "array")
    and all((.env_vars // [])[];
      type == "string"
      or (
        type == "object"
        and (.name | type == "string" and length > 0)
        and ((.source // "local") == "local" or .source == "remote")
      )
    )
    and ((.startup_timeout_sec // 1) | type == "number" and . > 0)
    and ((.tool_timeout_sec // 1) | type == "number" and . > 0)
    and ((.required // false) | type == "boolean")
    and ((.enabled_tools // []) | type == "array")
    and all((.enabled_tools // [])[]; type == "string")
    and ((.disabled_tools // []) | type == "array")
    and all((.disabled_tools // [])[]; type == "string")
    and ((.suppress_when_disabled // false) | type == "boolean")
    and ((.provider // "") | type == "string")
    and ((.auth_mode // "") | type == "string")
    and ((.variant_group // "") | type == "string")
    and ((.variant_label // "") | type == "string")
  ' >/dev/null 2>&1; then
    die "server '$server' is invalid or unsupported by target '$TARGET'"
  fi

  package_ref="$(printf '%s' "$definition" | jq -r '.host.install.package // empty')"
  case "$package_ref" in
    @mcpctl-store/artifacts/*)
      artifact="${package_ref#@mcpctl-store/artifacts/}"
      case "$artifact" in
        ""|.|..|*/*|*\\*|*[!A-Za-z0-9._-]*)
          die "server '$server' has an invalid portable artifact reference"
          ;;
      esac
      artifact="$STORE_DIR/artifacts/$artifact"
      [ -f "$artifact" ] && [ ! -L "$artifact" ] ||
        die "server '$server' portable artifact is missing or unsafe: $artifact"
      expected_sha="$(printf '%s' "$definition" | jq -r '.host.install.sha256 // empty')"
      case "$expected_sha" in
        ""|*[!A-Fa-f0-9]*)
          die "server '$server' portable artifact has no valid SHA-256"
          ;;
      esac
      [ "${#expected_sha}" -eq 64 ] ||
        die "server '$server' portable artifact has no valid SHA-256"
      printf '%s' "$definition" | jq -e --arg digest "sha256:$expected_sha" \
        '(.command // []) | index($digest) != null' >/dev/null 2>&1 ||
        die "server '$server' command does not pin its portable artifact digest"
      printf '%s' "$definition" | jq -e '
        (.host.install.with // []) as $with
        | ($with | type) == "array"
        and all($with[]; type == "string" and length > 0 and (startswith("-") | not))
      ' >/dev/null 2>&1 ||
        die "server '$server' has invalid uv companion requirements"
      while IFS= read -r requirement; do
        [ -n "$requirement" ] || continue
        printf '%s' "$definition" | jq -e --arg option "with:$requirement" \
          '(.command // []) | index($option) != null' >/dev/null 2>&1 ||
          die "server '$server' command omits uv companion requirement '$requirement'"
      done < <(printf '%s' "$definition" | jq -r '.host.install.with[]?')
      if command -v shasum >/dev/null 2>&1; then
        actual_sha="$(shasum -a 256 -- "$artifact" | awk '{print $1}')"
      elif command -v sha256sum >/dev/null 2>&1; then
        actual_sha="$(sha256sum -- "$artifact" | awk '{print $1}')"
      else
        die "shasum or sha256sum is required to verify portable MCP artifacts"
      fi
      [ "$(printf '%s' "$actual_sha" | tr 'A-F' 'a-f')" = \
        "$(printf '%s' "$expected_sha" | tr 'A-F' 'a-f')" ] ||
        die "server '$server' portable artifact failed SHA-256 verification"
      ;;
    @mcpctl-store/*)
      die "server '$server' has an unsupported portable Store reference"
      ;;
  esac
}

validate_enabled_variant_groups() {
  local enabled_json variant_group variants
  enabled_json="$(json_array_from_values \
    ${ENABLED[@]+"${ENABLED[@]}"})"
  while IFS=$'\t' read -r variant_group variants; do
    [ -n "$variant_group" ] || continue
    die "profile '$PROFILE' enables mutually exclusive variants in group '$variant_group': $variants; keep exactly one variant enabled"
  done < <(
    jq -r --argjson enabled "$enabled_json" '
      [
        .servers
        | to_entries[]
        | select(.key as $name | $enabled | index($name))
        | select((.value.variant_group // "") != "")
        | {group: .value.variant_group, name: .key}
      ]
      | sort_by(.group, .name)
      | group_by(.group)
      | map(select(length > 1))
      | .[]
      | [.[0].group, (map(.name) | join(", "))]
      | @tsv
    ' "$CATALOG_FILE"
  )
}

resolve_profile() {
  local layer server definition
  [ -n "$PROFILE" ] || die "--profile is required"
  validate_id "profile name" "$PROFILE"

  ENABLED=()
  PROFILE_ORDER=()
  PROFILE_VISITING=" "
  PROFILE_VISITED=" "
  collect_profile_order "$PROFILE"

  for layer in ${PROFILE_ORDER[@]+"${PROFILE_ORDER[@]}"}; do
    apply_profile_layer "$layer"
  done

  for server in ${CLI_ENABLE[@]+"${CLI_ENABLE[@]}"}; do
    validate_id "server name" "$server"
    enable_server "$server"
  done
  for server in ${CLI_DISABLE[@]+"${CLI_DISABLE[@]}"}; do
    validate_id "server name" "$server"
    disable_server "$server"
  done

  for server in ${ENABLED[@]+"${ENABLED[@]}"}; do
    if ! definition="$(resolved_effective_server "$server" 2>/dev/null)"; then
      die "profile '$PROFILE' references unknown server '$server'"
    fi
    validate_effective_server "$server" "$definition"
  done
  validate_enabled_variant_groups
}

json_array_from_values() {
  if [ $# -eq 0 ]; then
    printf '[]'
    return 0
  fi
  printf '%s\n' "$@" | jq -Rsc '
    split("\n")
    | map(select(length > 0))
    | unique
  '
}

if [ "$COMMAND" = "profile-create" ]; then
  validate_id "profile name" "$ENTITY_NAME"
  validate_id "profile name" "$PARENT_PROFILE"
  path="$(profile_path "$ENTITY_NAME")"
  [ ! -e "$path" ] && [ ! -L "$path" ] ||
    die "profile '$ENTITY_NAME' already exists at $path"

  parent_path="$(profile_path "$PARENT_PROFILE")"
  [ -f "$parent_path" ] || die "unknown parent profile '$PARENT_PROFILE'"
  PROFILE_ORDER=()
  PROFILE_VISITING=" "
  PROFILE_VISITED=" "
  collect_profile_order "$PARENT_PROFILE"

  if [ -n "$TARGET" ]; then
    TARGET="$(canonical_target "$TARGET")"
  fi

  for server in \
    ${CLI_ENABLE[@]+"${CLI_ENABLE[@]}"} \
    ${CLI_DISABLE[@]+"${CLI_DISABLE[@]}"}; do
    validate_id "server name" "$server"
    jq -e --arg server "$server" '.servers[$server] != null' \
      "$CATALOG_FILE" >/dev/null 2>&1 ||
      die "unknown server '$server'"
    if [ -n "$TARGET" ]; then
      definition="$(resolved_effective_server "$server")"
      validate_effective_server "$server" "$definition"
    fi
  done

  enable_json="$(json_array_from_values \
    ${CLI_ENABLE[@]+"${CLI_ENABLE[@]}"})"
  disable_json="$(json_array_from_values \
    ${CLI_DISABLE[@]+"${CLI_DISABLE[@]}"})"
  enable_json="$(jq -cn \
    --argjson enabled "$enable_json" \
    --argjson disabled "$disable_json" \
    '$enabled - $disabled')"
  [ -n "$DESCRIPTION" ] ||
    DESCRIPTION="Custom profile extending ${PARENT_PROFILE}"

  make_temp_near "$path"
  output="$TEMP_RESULT"
  if [ -n "$TARGET" ]; then
    jq -n \
      --arg name "$ENTITY_NAME" \
      --arg description "$DESCRIPTION" \
      --arg parent "$PARENT_PROFILE" \
      --arg target "$TARGET" \
      --argjson enabled "$enable_json" \
      --argjson disabled "$disable_json" '
        {
          schema: 1,
          name: $name,
          description: $description,
          extends: [$parent],
          enable: [],
          disable: [],
          target_overrides: {
            ($target): {
              enable: $enabled,
              disable: $disabled
            }
          }
        }
      ' > "$output"
  else
    jq -n \
      --arg name "$ENTITY_NAME" \
      --arg description "$DESCRIPTION" \
      --arg parent "$PARENT_PROFILE" \
      --argjson enabled "$enable_json" \
      --argjson disabled "$disable_json" '
        {
          schema: 1,
          name: $name,
          description: $description,
          extends: [$parent],
          enable: $enabled,
          disable: $disabled,
          target_overrides: {}
        }
      ' > "$output"
  fi
  validate_profile_file "$ENTITY_NAME" "$output"
  chmod 600 "$output"
  mv "$output" "$path"
  ok "created profile '$ENTITY_NAME' at $path"
  exit 0
fi

if [ "$COMMAND" = "profile-list" ]; then
  find "$STORE_DIR/profiles" -maxdepth 1 -type f -name '*.json' -print |
    LC_ALL=C sort |
    while IFS= read -r path; do
      jq -r '"\(.name)\t\(.description // "")"' "$path"
    done
  exit 0
fi

if [ "$COMMAND" = "profile-show" ]; then
  validate_id "profile name" "$ENTITY_NAME"
  PROFILE="$ENTITY_NAME"
  path="$(profile_path "$PROFILE")"
  [ -f "$path" ] || die "unknown profile '$PROFILE'"
  validate_profile_file "$PROFILE" "$path"
  if [ -z "$TARGET" ]; then
    jq . "$path"
  else
    TARGET="$(canonical_target "$TARGET")"
    resolve_profile
    resolve_suppressed_servers
    printf 'Profile: %s\nTarget: %s\nServers:\n' "$PROFILE" "$TARGET"
    for server in ${ENABLED[@]+"${ENABLED[@]}"}; do printf '  %s\n' "$server"; done
    if [ ${#SUPPRESSED[@]} -gt 0 ]; then
      log "Suppressed when disabled:"
      for server in ${SUPPRESSED[@]+"${SUPPRESSED[@]}"}; do
        printf '  %s\n' "$server"
      done
    fi
  fi
  exit 0
fi

if [ "$COMMAND" = "server-list" ]; then
  jq -r '.servers | to_entries[] | "\(.key)\t\(.value.description // "")"' \
    "$CATALOG_FILE"
  exit 0
fi

if [ "$COMMAND" = "server-show" ]; then
  validate_id "server name" "$ENTITY_NAME"
  if [ -z "$TARGET" ]; then
    jq --arg server "$ENTITY_NAME" '
      if .servers[$server] == null then error("unknown server: " + $server)
      else .servers[$server]
      end
    ' "$CATALOG_FILE"
  else
    TARGET="$(canonical_target "$TARGET")"
    resolved_effective_server "$ENTITY_NAME" | jq .
  fi
  exit 0
fi

[ -n "$TARGET" ] || die "--target is required"
TARGET="$(canonical_target "$TARGET")"

case "$TARGET" in
  claude)
    CONFIG_FILE="${MCPCTL_CLAUDE_CONFIG:-${HOME}/.claude.json}"
    ;;
  codex)
    CONFIG_FILE="${MCPCTL_CODEX_CONFIG:-${HOME}/.codex/config.toml}"
    ;;
  opencode)
    CONFIG_FILE="${MCPCTL_OPENCODE_CONFIG:-${HOME}/.config/opencode/opencode.json}"
    ;;
esac

strip_owned_codex_block() {
  local input="$1" output="$2"
  awk -v begin="$CODEX_BEGIN" -v end="$CODEX_END" '
    $0 == begin { in_owned = 1; next }
    $0 == end && in_owned { in_owned = 0; next }
    in_owned { next }
    { print }
    END { if (in_owned) exit 2 }
  ' "$input" > "$output"
}

codex_has_server() {
  local input="$1" wanted="$2"
  awk -v wanted="$wanted" '
    /^\[[^]]+\][[:space:]]*$/ {
      section = $0
      sub(/^[[]/, "", section)
      sub(/[]][[:space:]]*$/, "", section)
      if (section ~ /^mcp_servers\.[A-Za-z0-9_-]+([.]|$)/) {
        name = section
        sub(/^mcp_servers\./, "", name)
        sub(/[.].*$/, "", name)
        if (name == wanted) found = 1
      }
    }
    END { exit(found ? 0 : 1) }
  ' "$input"
}

strip_selected_codex_blocks() {
  local input="$1" output="$2" selected="$3"
  awk -v selected=" $selected " '
    /^\[[^]]+\][[:space:]]*$/ {
      section = $0
      sub(/^[[]/, "", section)
      sub(/[]][[:space:]]*$/, "", section)
      name = section
      sub(/^mcp_servers\./, "", name)
      sub(/[.].*$/, "", name)
      skip = (section ~ /^mcp_servers\.[A-Za-z0-9_-]+([.]|$)/ && index(selected, " " name " ") > 0)
    }
    skip { next }
    { print }
  ' "$input" > "$output"
}

CURRENT=()
CURRENT_SUPPRESSED=()

load_current_servers() {
  local status server marker_check
  CURRENT=()
  CURRENT_SUPPRESSED=()
  [ -f "$CONFIG_FILE" ] || return 0

  if [ "$TARGET" = "codex" ]; then
    make_temp
    marker_check="$TEMP_RESULT"
    strip_owned_codex_block "$CONFIG_FILE" "$marker_check" ||
      die "$CONFIG_FILE has an unclosed $CODEX_BEGIN block"
    while IFS=$'\t' read -r status server; do
      [ -n "$server" ] || continue
      if [ "$status" = "suppressed" ]; then
        array_has "$server" ${CURRENT_SUPPRESSED[@]+"${CURRENT_SUPPRESSED[@]}"} ||
          CURRENT_SUPPRESSED+=("$server")
      else
        array_has "$server" ${CURRENT[@]+"${CURRENT[@]}"} || CURRENT+=("$server")
      fi
    done < <(
      awk -v begin="$CODEX_BEGIN" -v end="$CODEX_END" '
        function flush_server() {
          if (server == "") return
          if (disabled) print "suppressed\t" server
          else print "enabled\t" server
          server = ""
          disabled = 0
        }
        $0 == begin { in_owned = 1; next }
        $0 == end {
          if (in_owned) flush_server()
          in_owned = 0
          next
        }
        !in_owned { next }
        /^\[mcp_servers\.[A-Za-z0-9_-]+\][[:space:]]*$/ {
          flush_server()
          section = $0
          sub(/^[[]mcp_servers\./, "", section)
          sub(/[]][[:space:]]*$/, "", section)
          server = section
          next
        }
        /^\[/ { flush_server(); next }
        server != "" &&
          /^[[:space:]]*enabled[[:space:]]*=[[:space:]]*false([[:space:]]*(#.*)?)?$/ {
          disabled = 1
        }
        END { if (in_owned) flush_server() }
      ' "$CONFIG_FILE" | awk '!seen[$0]++'
    )
    return 0
  fi

  jq -e 'type == "object"' "$CONFIG_FILE" >/dev/null 2>&1 ||
    die "$CONFIG_FILE is not a valid JSON object; it was left unchanged"

  if [ "$TARGET" = "claude" ]; then
    while IFS= read -r server; do
      [ -n "$server" ] && CURRENT+=("$server")
    done < <(jq -r --arg manager "$MANAGED_BY" '
      (.mcpServers // {})
      | to_entries[]
      | select(.value._managed_by? == $manager)
      | .key
    ' "$CONFIG_FILE")
  else
    while IFS= read -r server; do
      [ -n "$server" ] && CURRENT+=("$server")
    done < <(jq -r --arg manager "$MANAGED_BY" '
      (.mcp // {})
      | to_entries[]
      | select(.value._managed_by? == $manager)
      | .key
    ' "$CONFIG_FILE")
  fi
}

CONFLICTS=()

detect_conflicts() {
  local server owner stripped
  CONFLICTS=()
  [ -f "$CONFIG_FILE" ] || return 0

  if [ "$TARGET" = "codex" ]; then
    make_temp
    stripped="$TEMP_RESULT"
    strip_owned_codex_block "$CONFIG_FILE" "$stripped" ||
      die "$CONFIG_FILE has an unclosed $CODEX_BEGIN block"
    for server in \
      ${ENABLED[@]+"${ENABLED[@]}"} \
      ${SUPPRESSED[@]+"${SUPPRESSED[@]}"}; do
      if codex_has_server "$stripped" "$server"; then
        CONFLICTS+=("$server")
      fi
    done
    return 0
  fi

  for server in ${ENABLED[@]+"${ENABLED[@]}"}; do
    if [ "$TARGET" = "claude" ]; then
      owner="$(jq -r --arg server "$server" \
        '.mcpServers[$server] as $entry
         | if ($entry | type) == "object"
           then ($entry._managed_by // "__unmanaged__")
           else "__unmanaged__"
           end' "$CONFIG_FILE")"
      jq -e --arg server "$server" '.mcpServers[$server] != null' \
        "$CONFIG_FILE" >/dev/null 2>&1 || continue
    else
      owner="$(jq -r --arg server "$server" \
        '.mcp[$server] as $entry
         | if ($entry | type) == "object"
           then ($entry._managed_by // "__unmanaged__")
           else "__unmanaged__"
           end' "$CONFIG_FILE")"
      jq -e --arg server "$server" '.mcp[$server] != null' \
        "$CONFIG_FILE" >/dev/null 2>&1 || continue
    fi
    [ "$owner" = "$MANAGED_BY" ] || CONFLICTS+=("$server")
  done
}

print_named_group() {
  local label="$1" marker="$2"
  shift 2
  [ $# -gt 0 ] || return 0
  printf '%s\n' "$label"
  while [ $# -gt 0 ]; do
    printf '  %s %s\n' "$marker" "$1"
    shift
  done
}

print_plan() {
  local server
  local additions=() removals=() unchanged=()

  for server in ${ENABLED[@]+"${ENABLED[@]}"}; do
    if array_has "$server" ${CURRENT[@]+"${CURRENT[@]}"}; then
      unchanged+=("$server")
    else
      additions+=("$server")
    fi
  done
  for server in ${CURRENT[@]+"${CURRENT[@]}"}; do
    array_has "$server" ${ENABLED[@]+"${ENABLED[@]}"} || removals+=("$server")
  done

  printf 'Target:  %s\n' "$TARGET"
  printf 'Profile: %s\n' "$PROFILE"
  printf 'Config:  %s\n' "$CONFIG_FILE"
  print_named_group "Add:" "+" ${additions[@]+"${additions[@]}"}
  print_named_group "Remove:" "-" ${removals[@]+"${removals[@]}"}
  print_named_group "Keep:" "=" ${unchanged[@]+"${unchanged[@]}"}
  print_named_group "Suppress:" "x" ${SUPPRESSED[@]+"${SUPPRESSED[@]}"}
  if [ ${#ENABLED[@]} -eq 0 ] && [ ${#CURRENT[@]} -eq 0 ] &&
     [ ${#SUPPRESSED[@]} -eq 0 ]; then
    log "No managed MCP servers."
  fi
  if [ ${#CONFLICTS[@]} -gt 0 ]; then
    print_named_group "Conflicts:" "!" ${CONFLICTS[@]+"${CONFLICTS[@]}"}
    if [ "$FORCE" -eq 1 ]; then
      warn "--force will replace only these same-name entries"
    else
      warn "apply will stop; use --force only if mcpctl should replace these names"
    fi
  fi

  if [ ${#ENABLED[@]} -gt 0 ]; then
    log "Secrets:"
    for server in ${ENABLED[@]+"${ENABLED[@]}"}; do
      describe_secret_source "$server"
    done
    print_setup_notes
  fi
}

SOPS_CACHE_LOADED=0
SOPS_CACHE=""
REMOTE_SECRETS_CACHE_LOADED=0
REMOTE_SECRETS_CACHE=""

load_sops_cache() {
  local sops_bin
  [ "$SOPS_CACHE_LOADED" -eq 0 ] || return 0
  [ -f "$SECRETS_FILE" ] ||
    die "missing secret and encrypted secret file: $SECRETS_FILE"
  sops_bin="${MCPCTL_SOPS_BIN:-sops}"
  command -v "$sops_bin" >/dev/null 2>&1 ||
    die "sops is required to decrypt $SECRETS_FILE"
  if ! SOPS_CACHE="$("$sops_bin" decrypt --output-type json "$SECRETS_FILE")"; then
    die "could not decrypt $SECRETS_FILE"
  fi
  printf '%s' "$SOPS_CACHE" | jq -e '
    type == "object"
    and (.secrets | type == "object")
    and all(.secrets[]; type == "string")
  ' >/dev/null 2>&1 ||
    die "decrypted $SECRETS_FILE must contain a .secrets object"
  SOPS_CACHE_LOADED=1
}

load_remote_secrets_cache() {
  [ "$REMOTE_SECRETS_CACHE_LOADED" -eq 0 ] || return 0
  [ -f "$REMOTE_SECRETS_FILE" ] ||
    die "encrypted remote secret cache not found: $REMOTE_SECRETS_FILE"
  [ -f "$REMOTE_CONFIG_FILE" ] ||
    die "remote configuration required to decrypt $REMOTE_SECRETS_FILE"
  require_remote_node
  if ! REMOTE_SECRETS_CACHE="$(
    node "$REMOTE_CLIENT" secrets \
      --store "$STORE_DIR" \
      --remote-config "$REMOTE_CONFIG_FILE"
  )"; then
    die "could not decrypt $REMOTE_SECRETS_FILE"
  fi
  printf '%s' "$REMOTE_SECRETS_CACHE" | jq -e '
    type == "object"
    and .schema == 1
    and (.secrets | type == "object")
    and all(.secrets[]; type == "string")
  ' >/dev/null 2>&1 ||
    die "$REMOTE_SECRETS_FILE decrypted to an invalid secrets document"
  REMOTE_SECRETS_CACHE_LOADED=1
}

RESOLVED_SECRET=""

resolve_named_secret() {
  local server="$1" descriptor="$2"
  local env_name secret_name required env_value value

  RESOLVED_SECRET=""
  [ "$(printf '%s' "$descriptor" | jq -r 'type')" = "object" ] ||
    return 0

  env_name="$(printf '%s' "$descriptor" | jq -r '.env // empty')"
  secret_name="$(printf '%s' "$descriptor" | jq -r '.secret')"
  required="$(printf '%s' "$descriptor" | jq -r '
    if has("required") then .required else true end
  ')"

  if [ -n "$env_name" ]; then
    env_value="$(printenv "$env_name" 2>/dev/null || true)"
    if [ -n "$env_value" ]; then
      RESOLVED_SECRET="$env_value"
      return 0
    fi
  fi

  if [ -f "$SECRETS_FILE" ]; then
    load_sops_cache
    value="$(printf '%s' "$SOPS_CACHE" |
      jq -r --arg secret "$secret_name" '.secrets[$secret] // empty')"
    if [ -n "$value" ]; then
      RESOLVED_SECRET="$value"
      return 0
    fi
  fi

  if [ -f "$REMOTE_SECRETS_FILE" ]; then
    load_remote_secrets_cache
    value="$(printf '%s' "$REMOTE_SECRETS_CACHE" |
      jq -r --arg secret "$secret_name" '.secrets[$secret] // empty')"
    if [ -n "$value" ]; then
      RESOLVED_SECRET="$value"
      return 0
    fi
  fi

  if [ "$required" = "true" ]; then
    if [ -n "$env_name" ]; then
      die "no secret '$secret_name' for '$server'; set \$$env_name, add it to $SECRETS_FILE, or restore an encrypted remote cache"
    fi
    die "no secret '$secret_name' for '$server' in local encrypted secret sources"
  fi
}

resolve_server_secret() {
  local server="$1" definition="$2" descriptor
  descriptor="$(printf '%s' "$definition" | jq -c '.auth // null')"
  [ "$descriptor" != "null" ] || {
    RESOLVED_SECRET=""
    return 0
  }
  resolve_named_secret "$server" "$descriptor"
}

RESOLVED_VALUE=""
RESOLVED_VALUE_PRESENT=0

resolve_descriptor_value() {
  local server="$1" descriptor="$2" descriptor_type prefix suffix
  RESOLVED_VALUE=""
  RESOLVED_VALUE_PRESENT=0
  descriptor_type="$(printf '%s' "$descriptor" | jq -r 'type')"
  if [ "$descriptor_type" = "string" ]; then
    RESOLVED_VALUE="$(printf '%s' "$descriptor" | jq -r '.')"
    RESOLVED_VALUE_PRESENT=1
    return 0
  fi

  resolve_named_secret "$server" "$descriptor"
  [ -n "$RESOLVED_SECRET" ] || return 0
  prefix="$(printf '%s' "$descriptor" | jq -r '.prefix // empty')"
  suffix="$(printf '%s' "$descriptor" | jq -r '.suffix // empty')"
  RESOLVED_VALUE="${prefix}${RESOLVED_SECRET}${suffix}"
  RESOLVED_VALUE_PRESENT=1
}

describe_named_secret() {
  local server="$1" label="$2" descriptor="$3"
  local env_name secret_name required
  env_name="$(printf '%s' "$descriptor" | jq -r '.env // empty')"
  secret_name="$(printf '%s' "$descriptor" | jq -r '.secret')"
  required="$(printf '%s' "$descriptor" | jq -r '
    if has("required") then .required else true end
  ')"
  if [ -n "$env_name" ] && [ -n "$(printenv "$env_name" 2>/dev/null || true)" ]; then
    printf '  - %s%s: env %s (available)\n' "$server" "$label" "$env_name"
  elif [ -f "$SECRETS_FILE" ]; then
    printf '  - %s%s: SOPS key %s (encrypted file present)\n' \
      "$server" "$label" "$secret_name"
  elif [ -f "$REMOTE_SECRETS_FILE" ]; then
    printf '  - %s%s: remote key %s (encrypted cache present)\n' \
      "$server" "$label" "$secret_name"
  elif [ "$required" = "true" ]; then
    printf '  - %s%s: missing (%s, SOPS key %s, or remote cache)\n' \
      "$server" "$label" "${env_name:-no environment fallback}" "$secret_name"
  else
    printf '  - %s%s: optional; not configured\n' "$server" "$label"
  fi
}

describe_secret_source() {
  local server="$1" definition descriptor encoded_key encoded_descriptor key
  local printed=0
  definition="$(resolved_effective_server "$server")"
  if [ "$(printf '%s' "$definition" | jq -r '.auth // null | type')" = "object" ]; then
    descriptor="$(printf '%s' "$definition" | jq -c '.auth')"
    describe_named_secret "$server" "" "$descriptor"
    printed=1
  fi

  while IFS=$'\t' read -r encoded_key encoded_descriptor; do
    [ -n "$encoded_key" ] || continue
    key="$(printf '%s' "$encoded_key" | jq -Rr '@base64d')"
    descriptor="$(printf '%s' "$encoded_descriptor" | jq -Rr '@base64d')"
    [ "$(printf '%s' "$descriptor" | jq -r 'type')" = "object" ] || continue
    describe_named_secret "$server" " / $key" "$descriptor"
    printed=1
  done < <(
    printf '%s' "$definition" | jq -r '
      [(.environment // {}), (.headers // {})]
      | add
      | to_entries[]
      | [(.key | @base64), (.value | tojson | @base64)]
      | @tsv
    '
  )
  while IFS=$'\t' read -r key encoded_descriptor; do
    [ -n "$encoded_descriptor" ] || continue
    descriptor="$(printf '%s' "$encoded_descriptor" | jq -Rr '@base64d')"
    describe_named_secret "$server" " / arg[$key]" "$descriptor"
    printed=1
  done < <(
    printf '%s' "$definition" | jq -r '
      (.command // [])
      | to_entries[]
      | select(.value | type == "object")
      | [.key, (.value | tojson | @base64)]
      | @tsv
    '
  )
  [ "$printed" -eq 1 ] || printf '  - %s: none\n' "$server"
}

print_setup_notes() {
  local server definition setup printed=0
  for server in ${ENABLED[@]+"${ENABLED[@]}"}; do
    definition="$(resolved_effective_server "$server")"
    setup="$(printf '%s' "$definition" | jq -r '.setup // empty')"
    [ -n "$setup" ] || continue
    if [ "$printed" -eq 0 ]; then
      log "Setup:"
      printed=1
    fi
    printf '  - %s: %s\n' "$server" "$setup"
  done
}

build_resolved_map() {
  local server="$1" definition="$2" field="$3" output="$4"
  local encoded_key encoded_descriptor key descriptor secret_file next
  printf '{}\n' > "$output"
  while IFS=$'\t' read -r encoded_key encoded_descriptor; do
    [ -n "$encoded_key" ] || continue
    key="$(printf '%s' "$encoded_key" | jq -Rr '@base64d')"
    descriptor="$(printf '%s' "$encoded_descriptor" | jq -Rr '@base64d')"
    resolve_descriptor_value "$server" "$descriptor"
    [ "$RESOLVED_VALUE_PRESENT" -eq 1 ] || continue

    make_temp
    secret_file="$TEMP_RESULT"
    printf '%s' "$RESOLVED_VALUE" > "$secret_file"
    make_temp
    next="$TEMP_RESULT"
    jq --arg key "$key" --rawfile value "$secret_file" \
      '. + {($key): $value}' "$output" > "$next"
    mv "$next" "$output"
    rm -f "$secret_file"
  done < <(
    printf '%s' "$definition" | jq -r --arg field "$field" '
      (.[$field] // {})
      | to_entries[]
      | [(.key | @base64), (.value | tojson | @base64)]
      | @tsv
    '
  )
}

build_resolved_headers() {
  local server="$1" definition="$2" output="$3"
  local descriptor header secret_file next
  build_resolved_map "$server" "$definition" "headers" "$output"
  [ "$(printf '%s' "$definition" | jq -r '.auth // null | type')" = "object" ] ||
    return 0

  descriptor="$(printf '%s' "$definition" | jq -c '
    .auth
    | {
        secret,
        env: (.env // ""),
        prefix: (.prefix // ""),
        suffix: "",
        required: (if has("required") then .required else true end)
      }
  ')"
  resolve_descriptor_value "$server" "$descriptor"
  [ "$RESOLVED_VALUE_PRESENT" -eq 1 ] || return 0
  header="$(printf '%s' "$definition" | jq -r '.auth.header')"
  make_temp
  secret_file="$TEMP_RESULT"
  printf '%s' "$RESOLVED_VALUE" > "$secret_file"
  make_temp
  next="$TEMP_RESULT"
  jq --arg header "$header" --rawfile value "$secret_file" \
    '. + {($header): $value}' "$output" > "$next"
  mv "$next" "$output"
  rm -f "$secret_file"
}

build_resolved_command() {
  local server="$1" definition="$2" output="$3"
  local encoded_descriptor descriptor secret_file next
  printf '[]\n' > "$output"
  while IFS= read -r encoded_descriptor; do
    [ -n "$encoded_descriptor" ] || continue
    descriptor="$(printf '%s' "$encoded_descriptor" | jq -Rr '@base64d')"
    resolve_descriptor_value "$server" "$descriptor"
    [ "$RESOLVED_VALUE_PRESENT" -eq 1 ] ||
      die "command argument for '$server' could not be resolved"

    make_temp
    secret_file="$TEMP_RESULT"
    printf '%s' "$RESOLVED_VALUE" > "$secret_file"
    make_temp
    next="$TEMP_RESULT"
    jq --rawfile value "$secret_file" '. + [$value]' "$output" > "$next"
    mv "$next" "$output"
    rm -f "$secret_file"
  done < <(
    printf '%s' "$definition" | jq -r '
      .command[]
      | tojson
      | @base64
    '
  )
}

make_json_entry() {
  local server="$1" output="$2"
  local definition transport resolved_map resolved_command next map_key
  definition="$(resolved_effective_server "$server")"
  transport="$(printf '%s' "$definition" | jq -r '.transport')"

  if [ "$transport" = "stdio" ]; then
    make_temp
    resolved_command="$TEMP_RESULT"
    build_resolved_command "$server" "$definition" "$resolved_command"
    if [ "$TARGET" = "claude" ]; then
      jq --arg manager "$MANAGED_BY" '
        {
          command: .[0],
          args: (.[1:] // []),
          _managed_by: $manager
        }
      ' "$resolved_command" > "$output"
    else
      jq --arg manager "$MANAGED_BY" '
        {
          type: "local",
          command: .,
          _managed_by: $manager
        }
      ' "$resolved_command" > "$output"
    fi

    make_temp
    resolved_map="$TEMP_RESULT"
    build_resolved_map "$server" "$definition" "environment" "$resolved_map"
    if [ "$(jq 'length' "$resolved_map")" -gt 0 ]; then
      if [ "$TARGET" = "claude" ]; then map_key="env"; else map_key="environment"; fi
      make_temp
      next="$TEMP_RESULT"
      jq --arg key "$map_key" --slurpfile values "$resolved_map" \
        '. + {($key): $values[0]}' "$output" > "$next"
      mv "$next" "$output"
    fi

    make_temp
    next="$TEMP_RESULT"
    if [ "$TARGET" = "claude" ]; then
      jq --argjson definition "$definition" '
        if ($definition.startup_timeout_sec // null) != null then
          .startup_timeout_sec = $definition.startup_timeout_sec
        else . end
      ' "$output" > "$next"
    else
      jq --argjson definition "$definition" '
        if ($definition.cwd // "") != "" then .cwd = $definition.cwd else . end
      ' "$output" > "$next"
    fi
    mv "$next" "$output"
    return 0
  fi

  if [ "$TARGET" = "claude" ]; then
    printf '%s' "$definition" | jq --arg manager "$MANAGED_BY" '
      {
        type: (.client_type // "http"),
        url: .url,
        _managed_by: $manager
      }
    ' > "$output"
  else
    printf '%s' "$definition" | jq --arg manager "$MANAGED_BY" '
      {type: "remote", url: .url, _managed_by: $manager}
    ' > "$output"
  fi

  make_temp
  resolved_map="$TEMP_RESULT"
  build_resolved_headers "$server" "$definition" "$resolved_map"
  [ "$(jq 'length' "$resolved_map")" -gt 0 ] || return 0
  next="$TEMP_RESULT"
  make_temp
  next="$TEMP_RESULT"
  jq --slurpfile headers "$resolved_map" \
    '. + {headers: $headers[0]}' "$output" > "$next"
  mv "$next" "$output"
}

build_desired_json() {
  local desired="$1" server entry next
  printf '{}\n' > "$desired"
  for server in ${ENABLED[@]+"${ENABLED[@]}"}; do
    make_temp
    entry="$TEMP_RESULT"
    make_json_entry "$server" "$entry"
    make_temp
    next="$TEMP_RESULT"
    jq --arg server "$server" --slurpfile entry "$entry" \
      '. + {($server): $entry[0]}' "$desired" > "$next"
    mv "$next" "$desired"
  done
}

write_toml_map_table() {
  local server="$1" table="$2" map_file="$3" output="$4"
  local encoded_key encoded_value key value
  [ "$(jq 'length' "$map_file")" -gt 0 ] || return 0
  printf '\n[mcp_servers.%s.%s]\n' "$server" "$table" >> "$output"
  while IFS=$'\t' read -r encoded_key encoded_value; do
    [ -n "$encoded_key" ] || continue
    key="$(printf '%s' "$encoded_key" | jq -Rr '@base64d')"
    value="$(printf '%s' "$encoded_value" | jq -Rr '@base64d')"
    printf '%s = %s\n' "$(toml_quote "$key")" "$(toml_quote "$value")" \
      >> "$output"
  done < <(
    jq -r '
      to_entries[]
      | [(.key | @base64), (.value | @base64)]
      | @tsv
    ' "$map_file"
  )
}

write_codex_common_options() {
  local definition="$1" output="$2" value
  for option in startup_timeout_sec tool_timeout_sec; do
    value="$(printf '%s' "$definition" | jq -r --arg option "$option" '
      if has($option) and .[$option] != null then .[$option] else empty end
    ')"
    [ -z "$value" ] || printf '%s = %s\n' "$option" "$value" >> "$output"
  done

  if [ "$(printf '%s' "$definition" |
    jq -r 'has("required") and .required != null')" = "true" ]; then
    value="$(printf '%s' "$definition" | jq -r '.required')"
    printf 'required = %s\n' "$value" >> "$output"
  fi
  for option in enabled_tools disabled_tools; do
    if [ "$(printf '%s' "$definition" |
      jq -r --arg option "$option" \
        'has($option) and .[$option] != null')" = "true" ]; then
      value="$(printf '%s' "$definition" | jq -c --arg option "$option" '.[$option]')"
      printf '%s = %s\n' "$option" "$value" >> "$output"
    fi
  done
  value="$(printf '%s' "$definition" |
    jq -r '.default_tools_approval_mode // empty')"
  [ -z "$value" ] ||
    printf 'default_tools_approval_mode = %s\n' "$(toml_quote "$value")" \
      >> "$output"
}

build_codex_block() {
  local output="$1" server definition transport url command args value
  local disabled_entry
  local resolved_command resolved_environment resolved_headers
  : > "$output"
  if [ ${#ENABLED[@]} -eq 0 ] && [ ${#SUPPRESSED[@]} -eq 0 ]; then
    return 0
  fi

  printf '\n%s\n' "$CODEX_BEGIN" >> "$output"
  for server in \
    ${ENABLED[@]+"${ENABLED[@]}"} \
    ${SUPPRESSED[@]+"${SUPPRESSED[@]}"}; do
    disabled_entry=0
    array_has "$server" ${SUPPRESSED[@]+"${SUPPRESSED[@]}"} && disabled_entry=1
    definition="$(resolved_effective_server "$server")"
    transport="$(printf '%s' "$definition" | jq -r '.transport')"
    printf '\n[mcp_servers.%s]\n' "$server" >> "$output"
    if [ "$transport" = "stdio" ]; then
      make_temp
      resolved_command="$TEMP_RESULT"
      build_resolved_command "$server" "$definition" "$resolved_command"
      command="$(jq -r '.[0]' "$resolved_command")"
      args="$(jq -c '.[1:]' "$resolved_command")"
      printf 'command = %s\n' "$(toml_quote "$command")" >> "$output"
      printf 'args = %s\n' "$args" >> "$output"
      value="$(printf '%s' "$definition" | jq -r '.cwd // empty')"
      [ -z "$value" ] ||
        printf 'cwd = %s\n' "$(toml_quote "$value")" >> "$output"
      if [ "$(printf '%s' "$definition" | jq -r '(.env_vars // []) | length')" \
        -gt 0 ]; then
        value="$(printf '%s' "$definition" | jq -r '
          (.env_vars // [])
          | map(
              if type == "string" then
                @json
              else
                "{ name = " + (.name | @json)
                + ", source = " + ((.source // "local") | @json) + " }"
              end
            )
          | "[" + join(", ") + "]"
        ')"
        printf 'env_vars = %s\n' "$value" >> "$output"
      fi
      [ "$disabled_entry" -eq 0 ] || printf 'enabled = false\n' >> "$output"
      write_codex_common_options "$definition" "$output"
      make_temp
      resolved_environment="$TEMP_RESULT"
      build_resolved_map \
        "$server" "$definition" "environment" "$resolved_environment"
      write_toml_map_table \
        "$server" "env" "$resolved_environment" "$output"
      continue
    fi

    url="$(printf '%s' "$definition" | jq -r '.url')"
    printf 'url = %s\n' "$(toml_quote "$url")" >> "$output"
    [ "$disabled_entry" -eq 0 ] || printf 'enabled = false\n' >> "$output"
    write_codex_common_options "$definition" "$output"
    make_temp
    resolved_headers="$TEMP_RESULT"
    build_resolved_headers "$server" "$definition" "$resolved_headers"
    write_toml_map_table \
      "$server" "http_headers" "$resolved_headers" "$output"
  done
  printf '%s\n' "$CODEX_END" >> "$output"
}

STATE_SELECTION_MODE="profile"
STATE_BASE_PROFILE=""

validate_state_file() {
  [ ! -L "$STATE_FILE" ] || die "refusing to replace symlink $STATE_FILE"
  [ -f "$STATE_FILE" ] || return 0
  jq -e '
    type == "object"
    and ((.targets // {}) | type == "object")
  ' "$STATE_FILE" >/dev/null 2>&1 ||
    die "$STATE_FILE is invalid; fix or move it before applying"
}

update_state() {
  local input output server_json state_dir
  validate_state_file
  state_dir="$(dirname "$STATE_FILE")"
  mkdir -p "$state_dir"

  if [ -f "$STATE_FILE" ]; then
    input="$STATE_FILE"
  else
    make_temp
    input="$TEMP_RESULT"
    printf '{"schema":1,"targets":{}}\n' > "$input"
  fi

  server_json="$(
    for server in ${ENABLED[@]+"${ENABLED[@]}"}; do printf '%s\n' "$server"; done |
      jq -Rsc 'split("\n") | map(select(length > 0))'
  )"
  make_temp_near "$STATE_FILE"
  output="$TEMP_RESULT"
  jq --arg target "$TARGET" \
     --arg profile "$PROFILE" \
     --arg config "$CONFIG_FILE" \
     --arg selection_mode "$STATE_SELECTION_MODE" \
     --arg base_profile "$STATE_BASE_PROFILE" \
     --argjson servers "$server_json" '
    .schema = 1
    | .targets = (.targets // {})
    | .targets[$target] = ({
        profile: $profile,
        servers: $servers,
        config: $config
      }
      + if $selection_mode == "manual" then
          {
            selection_mode: "manual",
            base_profile: $base_profile
          }
        else
          {}
        end)
  ' "$input" > "$output"
  chmod 600 "$output"
  mv "$output" "$STATE_FILE"
}

apply_json_target() {
  local input desired output config_dir force_json root_key
  config_dir="$(dirname "$CONFIG_FILE")"
  mkdir -p "$config_dir"
  [ ! -L "$CONFIG_FILE" ] || die "refusing to replace symlink $CONFIG_FILE"

  if [ -f "$CONFIG_FILE" ]; then
    input="$CONFIG_FILE"
    jq -e 'type == "object"' "$input" >/dev/null 2>&1 ||
      die "$CONFIG_FILE is not a valid JSON object; it was left unchanged"
  else
    make_temp
    input="$TEMP_RESULT"
    printf '{}\n' > "$input"
  fi

  make_temp
  desired="$TEMP_RESULT"
  build_desired_json "$desired"
  make_temp_near "$CONFIG_FILE"
  output="$TEMP_RESULT"
  force_json="$FORCE"

  if [ "$TARGET" = "claude" ]; then
    root_key="mcpServers"
  else
    root_key="mcp"
  fi

  jq --arg root "$root_key" \
     --arg manager "$MANAGED_BY" \
     --argjson force "$force_json" \
     --slurpfile desired "$desired" '
    .[$root] = (.[$root] // {})
    | .[$root] |= with_entries(
        select(
          (.value | type) != "object"
          or (.value._managed_by // "") != $manager
        )
      )
    | reduce ($desired[0] | keys[]) as $key (.;
        if $force == 1 then del(.[$root][$key]) else . end
      )
    | .[$root] += $desired[0]
    | if (.[$root] | length) == 0 then del(.[$root]) else . end
  ' "$input" > "$output"
  chmod 600 "$output"
  mv "$output" "$CONFIG_FILE"
}

apply_codex_target() {
  local input stripped selected stripped_forced block output config_dir
  config_dir="$(dirname "$CONFIG_FILE")"
  mkdir -p "$config_dir"
  [ ! -L "$CONFIG_FILE" ] || die "refusing to replace symlink $CONFIG_FILE"

  if [ -f "$CONFIG_FILE" ]; then
    input="$CONFIG_FILE"
  else
    make_temp
    input="$TEMP_RESULT"
    printf '# Codex configuration created by mcpctl.\n' > "$input"
  fi

  make_temp
  stripped="$TEMP_RESULT"
  strip_owned_codex_block "$input" "$stripped" ||
    die "$CONFIG_FILE has an unclosed $CODEX_BEGIN block"

  if [ "$FORCE" -eq 1 ] && [ ${#CONFLICTS[@]} -gt 0 ]; then
    selected="${CONFLICTS[*]}"
    make_temp
    stripped_forced="$TEMP_RESULT"
    strip_selected_codex_blocks "$stripped" "$stripped_forced" "$selected"
    stripped="$stripped_forced"
  fi

  make_temp
  block="$TEMP_RESULT"
  build_codex_block "$block"

  make_temp_near "$CONFIG_FILE"
  output="$TEMP_RESULT"
  {
    cat "$stripped"
    cat "$block"
  } > "$output"
  chmod 600 "$output"
  mv "$output" "$CONFIG_FILE"
}

if [ "$COMMAND" = "server-enable" ] ||
   [ "$COMMAND" = "server-disable" ]; then
  validate_id "server name" "$ENTITY_NAME"
  resolved_effective_server "$ENTITY_NAME" >/dev/null 2>&1 ||
    die "unknown server '$ENTITY_NAME'"
  load_current_servers

  if [ "$COMMAND" = "server-enable" ] &&
     array_has "$ENTITY_NAME" ${CURRENT[@]+"${CURRENT[@]}"}; then
    ok "server '$ENTITY_NAME' is already enabled for $TARGET"
    exit 0
  fi
  if [ "$COMMAND" = "server-disable" ] &&
     ! array_has "$ENTITY_NAME" ${CURRENT[@]+"${CURRENT[@]}"}; then
    ok "server '$ENTITY_NAME' is already disabled for $TARGET"
    exit 0
  fi

  ENABLED=(${CURRENT[@]+"${CURRENT[@]}"})
  if [ "$COMMAND" = "server-enable" ]; then
    selected_group="$(effective_server "$ENTITY_NAME" |
      jq -r '.variant_group // empty')"
    if [ -n "$selected_group" ]; then
      for server in ${CURRENT[@]+"${CURRENT[@]}"}; do
        current_group="$(effective_server "$server" 2>/dev/null |
          jq -r '.variant_group // empty' 2>/dev/null || true)"
        if [ "$current_group" = "$selected_group" ]; then
          disable_server "$server"
        fi
      done
    fi
    enable_server "$ENTITY_NAME"
  else
    disable_server "$ENTITY_NAME"
  fi

  resolve_suppressed_servers

  STATE_BASE_PROFILE=""
  if [ -f "$STATE_FILE" ]; then
    STATE_BASE_PROFILE="$(jq -r --arg target "$TARGET" '
      .targets[$target] as $state
      | if $state == null then ""
        elif ($state.base_profile // "") != "" then $state.base_profile
        elif ($state.profile // "") != "custom" then ($state.profile // "")
        else ""
        end
    ' "$STATE_FILE" 2>/dev/null || true)"
  fi
  PROFILE="custom"
  STATE_SELECTION_MODE="manual"

  for server in ${ENABLED[@]+"${ENABLED[@]}"}; do
    definition="$(resolved_effective_server "$server" 2>/dev/null)" ||
      die "currently managed server '$server' is no longer in the catalog; apply a profile before editing the selection"
    validate_effective_server "$server" "$definition"
  done
  validate_enabled_variant_groups
  detect_conflicts
  print_plan

  if [ "$DRY_RUN" -eq 1 ]; then
    exit 0
  fi
  if [ ${#CONFLICTS[@]} -gt 0 ] && [ "$FORCE" -ne 1 ]; then
    die "same-name MCP entries are not owned by mcpctl; re-run with --force to replace only those names"
  fi
  validate_state_file
  if [ "$TARGET" = "codex" ]; then
    apply_codex_target
  else
    apply_json_target
  fi
  update_state
  action_word="enabled"
  [ "$COMMAND" = "server-enable" ] || action_word="disabled"
  ok "${action_word} server '$ENTITY_NAME' for $TARGET"
  exit 0
fi

if [ "$COMMAND" = "current" ]; then
  load_current_servers
  if [ "$JSON_OUTPUT" -eq 1 ]; then
    current_servers_json="$(
      for server in ${CURRENT[@]+"${CURRENT[@]}"}; do printf '%s\n' "$server"; done |
        jq -Rsc 'split("\n") | map(select(length > 0))'
    )"
    current_suppressed_json="$(
      for server in ${CURRENT_SUPPRESSED[@]+"${CURRENT_SUPPRESSED[@]}"}; do
        printf '%s\n' "$server"
      done | jq -Rsc 'split("\n") | map(select(length > 0))'
    )"
    if [ -f "$STATE_FILE" ] &&
       jq -e --arg target "$TARGET" '.targets[$target] != null' \
         "$STATE_FILE" >/dev/null 2>&1; then
      current_selection_mode="$(jq -r --arg target "$TARGET" \
        '.targets[$target].selection_mode // "profile"' "$STATE_FILE")"
      if [ "$current_selection_mode" = "manual" ]; then
        expected_servers_json="$(jq -c --arg target "$TARGET" \
          '.targets[$target].servers // []' "$STATE_FILE")"
        ENABLED=()
        while IFS= read -r server; do
          [ -n "$server" ] && enable_server "$server"
        done < <(printf '%s' "$expected_servers_json" | jq -r '.[]')
        resolve_suppressed_servers
      else
        PROFILE="$(jq -r --arg target "$TARGET" \
          '.targets[$target].profile // empty' "$STATE_FILE")"
        resolve_profile
        resolve_suppressed_servers
        expected_servers_json="$(
          for server in ${ENABLED[@]+"${ENABLED[@]}"}; do printf '%s\n' "$server"; done |
            jq -Rsc 'split("\n") | map(select(length > 0))'
        )"
      fi
      expected_suppressed_json="$(
        for server in ${SUPPRESSED[@]+"${SUPPRESSED[@]}"}; do
          printf '%s\n' "$server"
        done | jq -Rsc 'split("\n") | map(select(length > 0))'
      )"
      jq --arg target "$TARGET" \
         --arg config "$CONFIG_FILE" \
         --argjson servers "$current_servers_json" \
         --argjson expected "$expected_servers_json" \
         --argjson suppressed "$current_suppressed_json" \
         --argjson expected_suppressed "$expected_suppressed_json" '
        .targets[$target] as $state
        | {
            schema: 1,
            target: $target,
            config: $config,
            selection_mode: ($state.selection_mode // "profile"),
            profile: ($state.profile // null),
            base_profile: ($state.base_profile // null),
            servers: $servers,
            expected_servers: $expected,
            suppressed_servers: $suppressed,
            expected_suppressed_servers: $expected_suppressed,
            drift: (
              (($expected | sort) != ($servers | sort))
              or (($expected_suppressed | sort) != ($suppressed | sort))
            ),
            healthy: (
              (($expected | sort) == ($servers | sort))
              and (($expected_suppressed | sort) == ($suppressed | sort))
            )
          }
      ' "$STATE_FILE"
    else
      jq -n --arg target "$TARGET" \
        --arg config "$CONFIG_FILE" \
        --argjson servers "$current_servers_json" \
        --argjson suppressed "$current_suppressed_json" '{
          schema: 1,
          target: $target,
          config: $config,
          selection_mode: "unknown",
          profile: null,
          base_profile: null,
          servers: $servers,
          expected_servers: [],
          suppressed_servers: $suppressed,
          expected_suppressed_servers: [],
          drift: ((($servers | length) > 0) or (($suppressed | length) > 0)),
          healthy: ((($servers | length) == 0) and (($suppressed | length) == 0))
        }'
    fi
    exit 0
  fi
  printf 'Target: %s\nConfig: %s\n' "$TARGET" "$CONFIG_FILE"
  if [ -f "$STATE_FILE" ] &&
     jq -e --arg target "$TARGET" '.targets[$target] != null' \
       "$STATE_FILE" >/dev/null 2>&1; then
    jq -r --arg target "$TARGET" '
      .targets[$target] as $state
      | if ($state.selection_mode // "") == "manual" then
          "Profile: custom" +
          (if ($state.base_profile // "") == "" then ""
           else " (based on " + $state.base_profile + ")"
           end)
        else
          "Profile: " + ($state.profile // "unknown")
        end
    ' "$STATE_FILE"
  else
    log "Profile: unknown"
  fi
  log "Managed servers:"
  if [ ${#CURRENT[@]} -eq 0 ]; then
    log "  (none)"
  else
    for server in ${CURRENT[@]+"${CURRENT[@]}"}; do printf '  %s\n' "$server"; done
  fi
  if [ ${#CURRENT_SUPPRESSED[@]} -gt 0 ]; then
    log "Suppressed servers:"
    for server in ${CURRENT_SUPPRESSED[@]+"${CURRENT_SUPPRESSED[@]}"}; do
      printf '  %s\n' "$server"
    done
  fi
  exit 0
fi

resolve_profile
resolve_suppressed_servers
load_current_servers
detect_conflicts
print_plan

if [ "$COMMAND" = "plan" ]; then
  exit 0
fi

[ "$COMMAND" = "apply" ] || die "internal error: unsupported command '$COMMAND'"
if [ ${#CONFLICTS[@]} -gt 0 ] && [ "$FORCE" -ne 1 ]; then
  die "same-name MCP entries are not owned by mcpctl; re-run with --force to replace only those names"
fi

validate_state_file
if [ "$TARGET" = "codex" ]; then
  apply_codex_target
else
  apply_json_target
fi
update_state
ok "applied profile '$PROFILE' to $TARGET"
