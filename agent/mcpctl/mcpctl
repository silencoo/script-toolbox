#!/usr/bin/env bash
# mcpctl — apply task-oriented MCP profiles to supported coding agents.
#
# The existing per-agent mcp.sh scripts remain independent. mcpctl owns only
# entries marked with MANAGED_BY (JSON clients) or its explicit TOML markers.

set -euo pipefail
umask 077

SOURCE_PATH="${BASH_SOURCE[0]}"
while [ -L "$SOURCE_PATH" ]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
  SOURCE_PATH="$(readlink "$SOURCE_PATH")"
  case "$SOURCE_PATH" in
    /*) ;;
    *) SOURCE_PATH="${SOURCE_DIR}/${SOURCE_PATH}" ;;
  esac
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
MANAGED_BY="agent/mcpctl"
CODEX_BEGIN="# >>> ${MANAGED_BY} >>>"
CODEX_END="# <<< ${MANAGED_BY} <<<"
TEMPLATE_STORE="${SCRIPT_DIR}/template-store"
TUI_CLIENT="${SCRIPT_DIR}/../tui/dist/toolbox-tui.mjs"

# shellcheck source=../ctl-lib.sh
. "${SCRIPT_DIR}/../ctl-lib.sh"

TMP_FILES=()

cleanup() {
  local path
  for path in ${TMP_FILES[@]+"${TMP_FILES[@]}"}; do
    [ -n "$path" ] && rm -f "$path"
  done
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

usage() {
  cat <<'EOF'
mcpctl — apply task-oriented MCP profiles to coding agents

Usage:
  mcpctl
  mcpctl tui
  mcpctl interactive [--store <directory>] [--secrets <file>]
                     [--remote-config <file>]
  mcpctl update [--check|--yes]
  mcpctl --target <claude|codex|opencode> --profile <name> [options]
  mcpctl apply   --target <target> --profile <name> [options]
  mcpctl plan    --target <target> --profile <name> [options]
  mcpctl current --target <target> [--json] [options]
  mcpctl init [--store <directory>]
  mcpctl sync [--store <directory>]
  mcpctl import --target <claude|codex> [--profile <name>] [options]
  mcpctl remote init --endpoint <https-url> [options]
  mcpctl remote status
  mcpctl remote ui <status|enable|disable>
  mcpctl remote recovery
  mcpctl backup [options]
  mcpctl restore [--version <id>] [--recovery-file <file>] [--force]
  mcpctl versions
  mcpctl profile list [--store <directory>]
  mcpctl profile show <name> [--target <target>] [--store <directory>]
  mcpctl profile create <name> [--extends <profile>] [options]
  mcpctl server list [--store <directory>]
  mcpctl server show <name> [--target <target>] [--store <directory>]
  mcpctl server doctor [<name>|--all] [--store <directory>]
  mcpctl server install <name> [--dry-run] [--store <directory>]
  mcpctl server uninstall <name> [--dry-run] [--store <directory>]
  mcpctl server status [<name>|--all] [--store <directory>]
  mcpctl server start|stop|restart <name> [--store <directory>]
  mcpctl server enable|disable <name> --target <target> [options]
  mcpctl secrets status [options]
  mcpctl secrets edit [options]

Options:
  --target <name>       Target client: claude, codex, or opencode.
  --profile <name>      Task profile to resolve and apply.
  --enable <server>     Enable one extra server after profile resolution.
                        Repeatable.
  --disable <server>    Disable one server after profile resolution.
                        Repeatable; disable wins over enable.
  --extends <profile>   Parent profile for "profile create" (default: base).
  --description <text>  Description for "profile create".
  --source <file>       Import source override. For Codex, use saved output
                        from "codex mcp list --json".
  --scope <name>        Import scope (currently user only).
  --write               Commit an import plan to the local store.
  --all                 Select every catalog server for doctor or status.
  --store <directory>   Store containing catalog.json and profiles/.
  --secrets <file>      SOPS-encrypted JSON secret file.
  --endpoint <url>      HTTPS endpoint for "remote init".
  --create-token-file <file>
                        Read the service's store-creation token from a file.
  --remote-config <file>
                        Local mode-0600 remote capability configuration.
  --version <id>        Restore a specific remote backup version.
  --recovery-file <file>
                        Read a recovery code from a file instead of prompting.
  --force               Replace same-name entries not owned by mcpctl.
                        For restore, overwrite an existing local store.
                        For import, adopt differing target definitions and
                        replace changed encrypted Secret values.
  --dry-run             Alias for plan.
  --json                Emit machine-readable output where supported.
  -h, --help            Show this help.

Environment:
  MCPCTL_STORE                  Default store directory.
  MCPCTL_SECRETS_FILE           Default encrypted secret file.
  MCPCTL_PREFERENCES            Saved path preferences (no secret values).
  MCPCTL_CREATE_TOKEN_FILE      Store-creation token file for remote init.
  MCPCTL_REMOTE_CONFIG          Default remote capability configuration.
  MCPCTL_STATE_FILE             Override local applied-state path.
  MCPCTL_HOST_ROOT              Isolated package installs (default:
                                ~/.local/share/mcpctl/servers).
  MCPCTL_HOST_TRASH             Recoverable uninstall destination.
  MCPCTL_CLAUDE_CONFIG          Override Claude user MCP configuration path.
  MCPCTL_CLAUDE_IMPORT_CONFIG   Override Claude user MCP import source.
  MCPCTL_CODEX_CONFIG           Override Codex config path.
  MCPCTL_CODEX_BIN              Codex executable used for structured import.
  MCPCTL_OPENCODE_CONFIG        Override OpenCode config path.
  MCPCTL_SOPS_BIN               SOPS executable (default: sops).

Secrets:
  An auth or imported Secret descriptor names a secret and, optionally, an
  environment variable. The environment variable wins. Otherwise mcpctl reads
  .secrets["<name>"] from the SOPS-encrypted secrets file, then from the
  encrypted cache created by remote restore. Secret values are never shown by
  plan.
EOF
}

make_temp() {
  local path
  path="$(mktemp "${TMPDIR:-/tmp}/mcpctl.XXXXXX")"
  chmod 600 "$path"
  TMP_FILES+=("$path")
  TEMP_RESULT="$path"
}

make_temp_near() {
  local target="$1" path
  path="$(mktemp "${target}.tmp.XXXXXX")"
  chmod 600 "$path"
  TMP_FILES+=("$path")
  TEMP_RESULT="$path"
}

require_jq() {
  command -v jq >/dev/null 2>&1 ||
    die "jq is required; install jq and re-run"
}

validate_id() {
  local kind="$1" value="$2"
  if [ "$kind" = "server name" ]; then
    case "$value" in
      ""|*[!A-Za-z0-9_-]*)
        die "invalid ${kind} '${value}'; use letters, numbers, underscore, or hyphen"
        ;;
    esac
    return 0
  fi
  case "$value" in
    ""|*[!A-Za-z0-9._-]*)
      die "invalid ${kind} '${value}'; use letters, numbers, dot, underscore, or hyphen"
      ;;
  esac
}

canonical_target() {
  case "$1" in
    claude|claude-code) printf '%s' "claude" ;;
    codex)              printf '%s' "codex" ;;
    opencode)           printf '%s' "opencode" ;;
    *) die "unsupported target '$1'; choose claude, codex, or opencode" ;;
  esac
}

json_quote() {
  printf '%s' "$1" | jq -Rs .
}

toml_quote() {
  # JSON and TOML basic strings share the escapes emitted by jq for the values
  # accepted by this catalog.
  printf '%s' "$1" | jq -Rs .
}

array_has() {
  local wanted="$1" item
  shift
  for item in "$@"; do
    [ "$item" = "$wanted" ] && return 0
  done
  return 1
}

PREFERENCE_STORE=""
PREFERENCE_SECRETS_FILE=""
PREFERENCE_REMOTE_CONFIG=""

load_preferences() {
  local preferences_file="$1"
  PREFERENCE_STORE=""
  PREFERENCE_SECRETS_FILE=""
  PREFERENCE_REMOTE_CONFIG=""
  [ -e "$preferences_file" ] || return 0
  [ -f "$preferences_file" ] ||
    die "preferences path is not a regular file: $preferences_file"
  [ ! -L "$preferences_file" ] ||
    die "refusing to read preferences through symlink $preferences_file"
  jq -e '
    type == "object"
    and .schema == 1
    and ((.store // "") | type == "string")
    and ((.secrets_file // "") | type == "string")
    and ((.remote_config // "") | type == "string")
  ' "$preferences_file" >/dev/null 2>&1 ||
    die "$preferences_file is not a valid mcpctl preferences file"
  PREFERENCE_STORE="$(jq -r '.store // empty' "$preferences_file")"
  PREFERENCE_SECRETS_FILE="$(jq -r '.secrets_file // empty' "$preferences_file")"
  PREFERENCE_REMOTE_CONFIG="$(jq -r '.remote_config // empty' "$preferences_file")"
}

save_preferences() {
  local preferences_file="$1" store_dir="$2"
  local secrets_file="$3" remote_config="$4" output
  [ ! -L "$preferences_file" ] ||
    die "refusing to replace preferences symlink $preferences_file"
  mkdir -p "$(dirname "$preferences_file")"
  make_temp_near "$preferences_file"
  output="$TEMP_RESULT"
  jq -n \
    --arg store "$store_dir" \
    --arg secrets_file "$secrets_file" \
    --arg remote_config "$remote_config" '
      {
        schema: 1,
        store: $store,
        secrets_file: $secrets_file,
        remote_config: $remote_config
      }
    ' > "$output"
  chmod 600 "$output"
  mv "$output" "$preferences_file"
}

preferred_secrets_for_store() {
  local store_dir="$1"
  if [ -n "$PREFERENCE_STORE" ] &&
     [ "$store_dir" = "$PREFERENCE_STORE" ] &&
     [ -n "$PREFERENCE_SECRETS_FILE" ]; then
    printf '%s' "$PREFERENCE_SECRETS_FILE"
  else
    printf '%s/secrets.sops.json' "$store_dir"
  fi
}

expand_interactive_path() {
  local path="$1"
  case "$path" in
    "~") path="$HOME" ;;
    "~/"*) path="${HOME}/${path#\~/}" ;;
    "~"*) die "only the current user's ~/ path is supported" ;;
  esac
  case "$path" in
    /*) ;;
    *) path="${PWD}/${path}" ;;
  esac
  printf '%s' "$path"
}

write_age_creation_rule() {
  local secrets_file="$1" recipient="$2" config_file output
  config_file="$(dirname "$secrets_file")/.sops.yaml"
  [ ! -e "$config_file" ] && [ ! -L "$config_file" ] ||
    die "$config_file already exists; edit it directly to change recipients"
  case "$recipient" in
    age1*|ssh-ed25519\ *|ssh-rsa\ *) ;;
    *) die "recipient must be an age1... or supported SSH public recipient" ;;
  esac
  mkdir -p "$(dirname "$config_file")"
  make_temp_near "$config_file"
  output="$TEMP_RESULT"
  {
    printf '%s\n' "creation_rules:"
    printf '%s\n' "  - path_regex: .*\\.sops\\.json$"
    printf '%s\n' "    age:"
    printf '      - %s\n' "$(json_quote "$recipient")"
  } > "$output"
  chmod 600 "$output"
  mv "$output" "$config_file"
  ok "wrote public age recipient rule to $config_file"
  log "Keep the matching age private identity outside the MCP store."
}

INTERACTIVE_SELECTED=()

interactive_select_server() {
  local server="$1" catalog_file="${2:-}" variant_group sibling
  if [ -n "$catalog_file" ] && [ -f "$catalog_file" ]; then
    variant_group="$(jq -r --arg server "$server" \
      '.servers[$server].variant_group // empty' "$catalog_file")"
    if [ -n "$variant_group" ]; then
      while IFS= read -r sibling; do
        [ -n "$sibling" ] || continue
        interactive_deselect_server "$sibling"
      done < <(
        jq -r --arg server "$server" --arg group "$variant_group" '
          .servers
          | to_entries[]
          | select(.key != $server and (.value.variant_group // "") == $group)
          | .key
        ' "$catalog_file"
      )
    fi
  fi
  array_has "$server" ${INTERACTIVE_SELECTED[@]+"${INTERACTIVE_SELECTED[@]}"} ||
    INTERACTIVE_SELECTED+=("$server")
}

interactive_deselect_server() {
  local server="$1" item
  local next=()
  for item in ${INTERACTIVE_SELECTED[@]+"${INTERACTIVE_SELECTED[@]}"}; do
    [ "$item" = "$server" ] || next+=("$item")
  done
  INTERACTIVE_SELECTED=(${next[@]+"${next[@]}"})
}

run_interactive_remote_configuration() {
  local store_dir="$1" secrets_file="$2" remote_config="$3"
  local preferences_file="$4" action endpoint new_path

  while true; do
    printf '\nRemote configuration: %s (%s)\n' \
      "$remote_config" \
      "$([ -f "$remote_config" ] && printf 'configured' || printf 'not configured')" >&2
    if [ -f "$remote_config" ]; then
      choose_menu "Encrypted remote backup" 1 \
        "status|Show redacted remote status" \
        "ui-status|Show Web UI access status" \
        "ui-enable|Enable Web UI access for this store" \
        "ui-disable|Disable Web UI access for this store" \
        "backup|Back up the store now" \
        "versions|List available backup versions" \
        "path|Change the remote capability file path" \
        "back|Back to configuration"
    else
      choose_menu "Encrypted remote backup" 1 \
        "init|Initialize a remote store" \
        "restore-help|Show the fresh-machine restore command" \
        "path|Change the remote capability file path" \
        "back|Back to configuration"
    fi
    action="$MENU_VALUE"
    case "$action" in
      status)
        "$0" remote status --remote-config "$remote_config"
        ;;
      ui-status|ui-enable|ui-disable)
        "$0" remote ui "${action#ui-}" --remote-config "$remote_config"
        ;;
      backup)
        "$0" backup \
          --store "$store_dir" \
          --secrets "$secrets_file" \
          --remote-config "$remote_config"
        ;;
      versions)
        "$0" versions --remote-config "$remote_config"
        ;;
      init)
        prompt_value "Remote HTTPS endpoint" "https://toolbox-store.example.workers.dev"
        endpoint="$PROMPT_REPLY"
        case "$endpoint" in
          https://*) ;;
          *) warn "remote endpoint must use https://"; continue ;;
        esac
        log "The store-creation token will be read without echo."
        if ask_yes_no "Create the encrypted remote store now?" "no"; then
          "$0" remote init \
            --endpoint "$endpoint" \
            --store "$store_dir" \
            --secrets "$secrets_file" \
            --remote-config "$remote_config"
        fi
        ;;
      restore-help)
        log "Restore into a missing store with:"
        printf '  mcpctl restore --store %s --remote-config %s\n' \
          "$(json_quote "$store_dir")" "$(json_quote "$remote_config")"
        log "Without a remote capability file, restore securely prompts for the recovery code."
        ;;
      path)
        prompt_value "Remote capability file" "$remote_config"
        new_path="$(expand_interactive_path "$PROMPT_REPLY")"
        remote_config="$new_path"
        save_preferences \
          "$preferences_file" "$store_dir" "$secrets_file" "$remote_config"
        ok "saved remote configuration path"
        ;;
      back)
        INTERACTIVE_REMOTE_CONFIG_RESULT="$remote_config"
        return 0
        ;;
    esac
  done
}

run_interactive_configuration() {
  local store_dir="$1" secrets_file="$2" remote_config="$3"
  local preferences_file="$4" action new_path recipient

  while true; do
    printf '\n%s\n' "mcpctl configuration" >&2
    printf '  Store:       %s\n' "$store_dir" >&2
    printf '  Secrets:     %s (%s)\n' \
      "$secrets_file" \
      "$([ -f "$secrets_file" ] && printf 'encrypted file present' || printf 'not created')" >&2
    printf '  Remote:      %s (%s)\n' \
      "$remote_config" \
      "$([ -f "$remote_config" ] && printf 'configured' || printf 'not configured')" >&2
    printf '  Preferences: %s\n' "$preferences_file" >&2

    choose_menu "Configure mcpctl" 1 \
      "store|Switch or initialize the local MCP store" \
      "secret-status|Show redacted Secret status" \
      "secret-edit|Create or edit encrypted Secrets with SOPS" \
      "secret-path|Change the encrypted Secret file path" \
      "age|Create an age recipient rule for SOPS" \
      "remote|Configure encrypted remote backup" \
      "back|Back to the main menu"
    action="$MENU_VALUE"
    case "$action" in
      store)
        prompt_value "Local MCP store" "$store_dir"
        new_path="$(expand_interactive_path "$PROMPT_REPLY")"
        if [ -e "$new_path" ] && [ ! -f "$new_path/catalog.json" ]; then
          warn "that path exists but is not an initialized MCP store"
          continue
        fi
        if [ ! -e "$new_path" ]; then
          if ask_yes_no "Initialize the starter store at $new_path?" "yes"; then
            "$0" init --store "$new_path"
          else
            continue
          fi
        fi
        if [ "$secrets_file" = "$store_dir/secrets.sops.json" ]; then
          secrets_file="$new_path/secrets.sops.json"
        fi
        store_dir="$new_path"
        save_preferences \
          "$preferences_file" "$store_dir" "$secrets_file" "$remote_config"
        ok "saved local store preference"
        exec "$0" interactive \
          --store "$store_dir" \
          --secrets "$secrets_file" \
          --remote-config "$remote_config"
        ;;
      secret-status)
        "$0" secrets status \
          --store "$store_dir" \
          --secrets "$secrets_file" \
          --remote-config "$remote_config"
        ;;
      secret-edit)
        "$0" secrets edit \
          --store "$store_dir" \
          --secrets "$secrets_file" \
          --remote-config "$remote_config"
        ;;
      secret-path)
        prompt_value "SOPS-encrypted Secret file" "$secrets_file"
        secrets_file="$(expand_interactive_path "$PROMPT_REPLY")"
        save_preferences \
          "$preferences_file" "$store_dir" "$secrets_file" "$remote_config"
        ok "saved encrypted Secret file preference"
        ;;
      age)
        prompt_value "Public age recipient (never enter the private identity)" ""
        recipient="$PROMPT_REPLY"
        [ -n "$recipient" ] || {
          warn "recipient must not be empty"
          continue
        }
        write_age_creation_rule "$secrets_file" "$recipient"
        ;;
      remote)
        run_interactive_remote_configuration \
          "$store_dir" "$secrets_file" "$remote_config" "$preferences_file"
        remote_config="$INTERACTIVE_REMOTE_CONFIG_RESULT"
        ;;
      back)
        save_preferences \
          "$preferences_file" "$store_dir" "$secrets_file" "$remote_config"
        exec "$0" interactive \
          --store "$store_dir" \
          --secrets "$secrets_file" \
          --remote-config "$remote_config"
        ;;
    esac
  done
}

prompt_missing_session_secrets() {
  local plan_output="$1" catalog_file="$2"
  local server env_name secret_name missing_servers
  missing_servers="$(
    printf '%s\n' "$plan_output" |
      sed -n 's/^  - \([^:][^:]*\): missing (.*/\1/p'
  )"
  for server in $missing_servers; do
    [ -n "$server" ] || continue
    env_name="$(jq -r --arg server "$server" \
      '.servers[$server].auth.env // empty' "$catalog_file")"
    secret_name="$(jq -r --arg server "$server" \
      '.servers[$server].auth.secret // empty' "$catalog_file")"
    case "$env_name" in
      ""|[0-9]*|*[!A-Za-z0-9_]*)
        warn "$server has no safe environment-variable fallback; use encrypted SOPS Secrets"
        return 1
        ;;
    esac
    prompt_secret_value "Secret for ${server} (${env_name}; stored only for this run)"
    [ -n "$SECRET_REPLY" ] || {
      warn "Secret for $server must not be empty"
      return 1
    }
    export "${env_name}=${SECRET_REPLY}"
    SECRET_REPLY=""
    ok "loaded $secret_name into this mcpctl process"
  done
}

run_interactive() {
  local store_arg="" secrets_arg="" remote_config_arg=""
  local default_config_home default_state_home preferences_file
  local store_dir secrets_file remote_config state_file missing_action
  local action target profile_rows current_profile default_profile_index
  local name description category entry plan_output server selected mark
  local profile saved_profile persistence default_done_index
  local profile_names profile_entries command_args force_args
  local server_names server_categories server_descriptions toggle_entries
  local base_servers custom_enable custom_disable create_args

  while [ $# -gt 0 ]; do
    case "$1" in
      --store)
        [ $# -ge 2 ] || die "--store requires a directory"
        store_arg="$2"
        shift 2
        ;;
      --store=*)
        store_arg="${1#*=}"
        shift
        ;;
      --secrets)
        [ $# -ge 2 ] || die "--secrets requires a file"
        secrets_arg="$2"
        shift 2
        ;;
      --secrets=*)
        secrets_arg="${1#*=}"
        shift
        ;;
      --remote-config)
        [ $# -ge 2 ] || die "--remote-config requires a file"
        remote_config_arg="$2"
        shift 2
        ;;
      --remote-config=*)
        remote_config_arg="${1#*=}"
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        die "unknown interactive option '$1'; use --help"
        ;;
    esac
  done

  require_jq
  default_config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
  default_state_home="${XDG_STATE_HOME:-${HOME}/.local/state}"
  preferences_file="${MCPCTL_PREFERENCES:-${default_config_home}/mcpctl/preferences.json}"
  load_preferences "$preferences_file"
  store_dir="${store_arg:-${MCPCTL_STORE:-${PREFERENCE_STORE:-${default_config_home}/mcpctl/store}}}"
  secrets_file="${secrets_arg:-${MCPCTL_SECRETS_FILE:-$(preferred_secrets_for_store "$store_dir")}}"
  remote_config="${remote_config_arg:-${MCPCTL_REMOTE_CONFIG:-${PREFERENCE_REMOTE_CONFIG:-${default_config_home}/mcpctl/remote.json}}}"
  state_file="${MCPCTL_STATE_FILE:-${default_state_home}/mcpctl/applied.json}"

  printf '%s\n' "mcpctl interactive setup" >&2
  printf '%s\n' "Every apply is previewed and requires confirmation." >&2
  printf 'Store: %s\n' "$store_dir" >&2
  printf 'Secrets: %s\n' "$secrets_file" >&2
  printf 'Remote config: %s\n' "$remote_config" >&2

  if [ ! -f "$store_dir/catalog.json" ]; then
    [ ! -e "$store_dir" ] ||
      die "store exists but is incomplete: missing $store_dir/catalog.json"
    choose_menu "The selected MCP store is not initialized." 1 \
      "init|Initialize the starter store at $store_dir" \
      "restore|Restore an encrypted remote backup into this path" \
      "change|Choose and remember a different store path" \
      "exit|Exit without changes"
    action="$MENU_VALUE"
    case "$action" in
      init)
        "$0" init --store "$store_dir"
        ;;
      restore)
        "$0" restore \
          --store "$store_dir" \
          --remote-config "$remote_config"
        ;;
      change)
        prompt_value "Local MCP store" "$store_dir"
        store_dir="$(expand_interactive_path "$PROMPT_REPLY")"
        secrets_file="$store_dir/secrets.sops.json"
        save_preferences \
          "$preferences_file" "$store_dir" "$secrets_file" "$remote_config"
        exec "$0" interactive \
          --store "$store_dir" \
          --secrets "$secrets_file" \
          --remote-config "$remote_config"
        ;;
      exit)
        log "No changes were made."
        return 0
        ;;
    esac
  fi

  choose_menu "What would you like to do?" 1 \
    "apply|Apply or switch an MCP profile" \
    "plan|Preview a profile without applying" \
    "current|Show the currently managed profile" \
    "list|List available profiles" \
    "customize|Enable or disable individual MCP servers" \
    "servers|List available MCP servers" \
    "sync|Add newly bundled servers and profiles to this store" \
    "configure|Configure store, Secrets, and encrypted remote backup" \
    "exit|Exit without changes"
  action="$MENU_VALUE"
  case "$action" in
    list)
      exec "$0" profile list --store "$store_dir"
      ;;
    servers)
      exec "$0" server list --store "$store_dir"
      ;;
    sync)
      exec "$0" sync --store "$store_dir"
      ;;
    configure)
      run_interactive_configuration \
        "$store_dir" "$secrets_file" "$remote_config" "$preferences_file"
      return 0
      ;;
    exit)
      log "No changes were made."
      return 0
      ;;
  esac

  choose_menu "Which agent should mcpctl manage?" 1 \
    "claude|Claude Code" \
    "codex|Codex" \
    "opencode|OpenCode"
  target="$MENU_VALUE"

  if [ "$action" = "current" ]; then
    exec "$0" current --target "$target" --store "$store_dir"
  fi

  if ! profile_rows="$("$0" profile list --store "$store_dir")"; then
    return 1
  fi
  profile_names=()
  profile_entries=()
  while IFS=$'\t' read -r name description; do
    [ -n "$name" ] || continue
    profile_names+=("$name")
    profile_entries+=("${name}|${name} — ${description}")
  done <<< "$profile_rows"
  [ ${#profile_names[@]} -gt 0 ] ||
    die "no profiles found in $store_dir/profiles"

  current_profile=""
  if [ -f "$state_file" ]; then
    current_profile="$(jq -r --arg target "$target" \
      '.targets[$target].profile // empty' "$state_file" 2>/dev/null || true)"
  fi
  default_profile_index=1
  for entry in "${!profile_names[@]}"; do
    if [ -n "$current_profile" ] &&
       [ "${profile_names[$entry]}" = "$current_profile" ]; then
      default_profile_index=$((entry + 1))
      break
    fi
    if [ -z "$current_profile" ] &&
       [ "${profile_names[$entry]}" = "frontend" ]; then
      default_profile_index=$((entry + 1))
    fi
  done

  choose_menu "Which profile?" "$default_profile_index" "${profile_entries[@]}"
  profile="$MENU_VALUE"
  command_args=(
    --target "$target"
    --profile "$profile"
    --store "$store_dir"
    --secrets "$secrets_file"
    --remote-config "$remote_config"
  )

  if [ "$action" = "customize" ]; then
    base_servers=()
    while IFS= read -r server; do
      [ -n "$server" ] || continue
      base_servers+=("$server")
    done < <(
      "$0" profile show "$profile" --target "$target" --store "$store_dir" |
        awk '/^Servers:$/ { found = 1; next } found && /^  / { sub(/^  /, ""); print }'
    )
    INTERACTIVE_SELECTED=(${base_servers[@]+"${base_servers[@]}"})

    server_names=()
    server_categories=()
    server_descriptions=()
    while IFS=$'\t' read -r name category description; do
      [ -n "$name" ] || continue
      server_names+=("$name")
      server_categories+=("${category:-other}")
      server_descriptions+=("$description")
    done < <(
      jq -r --arg target "$target" '
        .servers
        | to_entries
        | map(select(
            (((.value.supported_targets // []) | length) == 0)
            or (((.value.supported_targets // []) | index($target)) != null)
          ))
        | sort_by(.value.category // "other", .key)
        | .[]
        | [
            .key,
            (.value.category // "other"),
            (.value.description // "")
          ]
        | @tsv
      ' "$store_dir/catalog.json"
    )
    [ ${#server_names[@]} -gt 0 ] ||
      die "no MCP servers in the catalog support target '$target'"

    while true; do
      toggle_entries=()
      entry=0
      while [ "$entry" -lt "${#server_names[@]}" ]; do
        server="${server_names[$entry]}"
        mark=" "
        if array_has "$server" \
          ${INTERACTIVE_SELECTED[@]+"${INTERACTIVE_SELECTED[@]}"}; then
          mark="x"
        fi
        toggle_entries+=(
          "toggle:${server}|[${mark}] ${server_categories[$entry]}/${server} — ${server_descriptions[$entry]}"
        )
        entry=$((entry + 1))
      done
      default_done_index=$((${#toggle_entries[@]} + 1))
      choose_menu \
        "Toggle MCP servers; selected entries will be managed for ${target}." \
        "$default_done_index" \
        "${toggle_entries[@]}" \
        "done|Done — preview this selection" \
        "reset|Reset to the ${profile} profile" \
        "cancel|Cancel without changes"
      selected="$MENU_VALUE"
      case "$selected" in
        toggle:*)
          server="${selected#toggle:}"
          if array_has "$server" \
            ${INTERACTIVE_SELECTED[@]+"${INTERACTIVE_SELECTED[@]}"}; then
            interactive_deselect_server "$server"
          else
            interactive_select_server "$server" "$store_dir/catalog.json"
          fi
          ;;
        reset)
          INTERACTIVE_SELECTED=(${base_servers[@]+"${base_servers[@]}"})
          ;;
        cancel)
          log "No changes were made."
          return 0
          ;;
        done)
          break
          ;;
      esac
    done

    custom_enable=()
    for server in ${INTERACTIVE_SELECTED[@]+"${INTERACTIVE_SELECTED[@]}"}; do
      array_has "$server" ${base_servers[@]+"${base_servers[@]}"} ||
        custom_enable+=("$server")
    done
    custom_disable=()
    for server in ${base_servers[@]+"${base_servers[@]}"}; do
      array_has "$server" \
        ${INTERACTIVE_SELECTED[@]+"${INTERACTIVE_SELECTED[@]}"} ||
        custom_disable+=("$server")
    done

    choose_menu "How should this selection be kept?" 1 \
      "once|Apply once without changing the saved profile" \
      "save|Save as a reusable target-specific profile and apply it" \
      "cancel|Cancel without changes"
    persistence="$MENU_VALUE"
    case "$persistence" in
      cancel)
        log "No changes were made."
        return 0
        ;;
      once)
        for server in ${custom_enable[@]+"${custom_enable[@]}"}; do
          command_args+=(--enable "$server")
        done
        for server in ${custom_disable[@]+"${custom_disable[@]}"}; do
          command_args+=(--disable "$server")
        done
        ;;
      save)
        prompt_value "New profile name" "${profile}-${target}-custom"
        saved_profile="$PROMPT_REPLY"
        create_args=(
          profile create "$saved_profile"
          --extends "$profile"
          --target "$target"
          --description "Custom ${target} selection based on ${profile}"
          --store "$store_dir"
        )
        for server in ${custom_enable[@]+"${custom_enable[@]}"}; do
          create_args+=(--enable "$server")
        done
        for server in ${custom_disable[@]+"${custom_disable[@]}"}; do
          create_args+=(--disable "$server")
        done
        "$0" "${create_args[@]}"
        profile="$saved_profile"
        command_args=(
          --target "$target"
          --profile "$profile"
          --store "$store_dir"
          --secrets "$secrets_file"
          --remote-config "$remote_config"
        )
        ;;
    esac
  fi

  if ! plan_output="$("$0" plan "${command_args[@]}")"; then
    return 1
  fi
  printf '\n%s\n' "$plan_output"
  case "$action" in
    apply|customize) ;;
    *) return 0 ;;
  esac

  while printf '%s\n' "$plan_output" | grep -q ': missing ('; do
    choose_menu "Required Secrets are missing." 1 \
      "session|Enter missing Secrets for this run only" \
      "encrypted|Create or edit the encrypted SOPS Secret file" \
      "cancel|Cancel without changes"
    missing_action="$MENU_VALUE"
    case "$missing_action" in
      session)
        prompt_missing_session_secrets "$plan_output" "$store_dir/catalog.json" ||
          continue
        ;;
      encrypted)
        "$0" secrets edit \
          --store "$store_dir" \
          --secrets "$secrets_file" \
          --remote-config "$remote_config"
        ;;
      cancel)
        log "No changes were made; required Secrets remain missing."
        return 0
        ;;
    esac
    if ! plan_output="$("$0" plan "${command_args[@]}")"; then
      return 1
    fi
    printf '\n%s\n' "$plan_output"
  done

  force_args=()
  if printf '%s\n' "$plan_output" | grep -q '^Conflicts:$'; then
    if ! ask_yes_no "Replace only the reported same-name conflicts?" "no"; then
      log "No changes were made."
      return 0
    fi
    force_args=(--force)
  fi

  if ! ask_yes_no "Apply this MCP profile?" "no"; then
    log "No changes were made."
    return 0
  fi
  exec "$0" apply "${command_args[@]}" \
    ${force_args[@]+"${force_args[@]}"}
}

