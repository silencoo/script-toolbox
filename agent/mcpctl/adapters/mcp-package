#!/usr/bin/env bash
# Run a package-backed MCP from mcpctl's isolated install when present, with
# the catalog's lazy package-manager command as a portable fallback.

set -euo pipefail

die() {
  printf 'mcpctl package adapter: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 ||
    die "required command '$1' was not found on PATH"
}

[ $# -ge 5 ] ||
  die "usage: mcp-package <npm|uv> <server> <package> <bin> [with:<requirement> ...] [sha256:<digest>] -- [arguments...]"

manager="$1"
server="$2"
package="$3"
binary="$4"
shift 4
digest=""
with_requirements=()
while [ $# -gt 0 ]; do
  option="$1"
  shift
  case "$option" in
    --) break ;;
    sha256:*)
      [ -z "$digest" ] || die "package SHA-256 digest was provided more than once"
      digest="${option#sha256:}"
      ;;
    with:*)
      requirement="${option#with:}"
      case "$requirement" in ""|-*) die "invalid uv companion requirement" ;; esac
      with_requirements+=("$requirement")
      ;;
    *) die "unknown package adapter option '$option'" ;;
  esac
done
[ "$option" = "--" ] || die "expected -- before package arguments"

case "$server" in
  ""|*[!A-Za-z0-9_-]*) die "invalid server name '$server'" ;;
esac
case "$binary" in
  ""|*/*|*\\*) die "invalid package executable '$binary'" ;;
esac
case "$package" in
  ""|-*) die "invalid package reference '$package'" ;;
esac
if [ -n "$digest" ]; then
  case "$digest" in
    *[!A-Fa-f0-9]*) die "invalid package SHA-256 digest" ;;
  esac
  [ "${#digest}" -eq 64 ] || die "invalid package SHA-256 digest"
  [ -f "$package" ] && [ ! -L "$package" ] ||
    die "verified package artifact is missing or unsafe: $package"
  if command -v shasum >/dev/null 2>&1; then
    actual_digest="$(shasum -a 256 -- "$package" | awk '{print $1}')"
  elif command -v sha256sum >/dev/null 2>&1; then
    actual_digest="$(sha256sum -- "$package" | awk '{print $1}')"
  else
    die "shasum or sha256sum is required to verify a package artifact"
  fi
  [ "$(printf '%s' "$actual_digest" | tr 'A-F' 'a-f')" = \
    "$(printf '%s' "$digest" | tr 'A-F' 'a-f')" ] ||
    die "package artifact failed SHA-256 verification"
fi

data_home="${XDG_DATA_HOME:-${HOME}/.local/share}"
servers_root="${MCPCTL_HOST_ROOT:-${data_home}/mcpctl/servers}"
case "$servers_root" in
  /*) ;;
  *) die "MCPCTL_HOST_ROOT must be an absolute path" ;;
esac

case "$manager" in
  npm)
    [ ${#with_requirements[@]} -eq 0 ] ||
      die "with: requirements are supported only for uv packages"
    owned_entry="${servers_root}/${server}/node_modules/.bin/${binary}"
    owned_manifest="${servers_root}/${server}/manifest.json"
    if [ -x "$owned_entry" ] && [ -f "$owned_manifest" ] &&
       command -v jq >/dev/null 2>&1 &&
       jq -e --arg manager "$manager" --arg package "$package" \
         --arg binary "$binary" '
           .schema == 1
           and .managed_by == "agent/mcpctl"
           and .manager == $manager
           and .package == $package
           and .binary == $binary
         ' "$owned_manifest" >/dev/null 2>&1; then
      exec "$owned_entry" "$@"
    fi
    require_command npx
    exec npx -y "$package" "$@"
    ;;
  uv)
    if [ ${#with_requirements[@]} -eq 0 ]; then
      with_json='[]'
    else
      require_command jq
      with_json="$(printf '%s\n' "${with_requirements[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')"
    fi
    owned_entry="${servers_root}/${server}/bin/${binary}"
    owned_manifest="${servers_root}/${server}/manifest.json"
    if [ -x "$owned_entry" ] && [ -f "$owned_manifest" ] &&
       command -v jq >/dev/null 2>&1 &&
       jq -e --arg manager "$manager" --arg package "$package" \
         --arg binary "$binary" --arg digest "$digest" --argjson with "$with_json" '
           .package as $installed_package
           | .schema == 1
           and .managed_by == "agent/mcpctl"
           and .manager == $manager
           and .binary == $binary
           and (.with // []) == $with
           and (
             .package == $package
             or (
               $digest != ""
               and ($installed_package | startswith("@mcpctl-store/artifacts/"))
               and ($package | endswith("/" + ($installed_package | ltrimstr("@mcpctl-store/artifacts/"))))
               and ((.sha256 // "") | ascii_downcase) == ($digest | ascii_downcase)
             )
           )
         ' "$owned_manifest" >/dev/null 2>&1; then
      exec "$owned_entry" "$@"
    fi
    require_command uvx
    # --from keeps distribution references and executable names separate.
    # This is required for wheels such as ghidra-mcp-bridge whose console
    # script is named bridge-mcp-ghidra, and also works for registry packages.
    uvx_args=(--from "$package")
    for requirement in ${with_requirements[@]+"${with_requirements[@]}"}; do
      uvx_args+=(--with "$requirement")
    done
    exec uvx "${uvx_args[@]}" "$binary" "$@"
    ;;
  *)
    die "unsupported package manager '$manager'"
    ;;
esac
