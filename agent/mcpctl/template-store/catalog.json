{
  "schema": 1,
  "servers": {
    "context7": {
      "category": "core",
      "description": "Library and framework documentation",
      "homepage": "https://github.com/upstash/context7",
      "transport": "http",
      "url": "https://mcp.context7.com/mcp",
      "auth": {
        "type": "header",
        "header": "Authorization",
        "prefix": "Bearer ",
        "secret": "context7_api_key",
        "env": "CONTEXT7_API_KEY",
        "required": false
      },
      "supported_targets": [
        "claude",
        "codex",
        "opencode"
      ]
    },
    "github": {
      "category": "core",
      "description": "GitHub repositories, issues, and pull requests",
      "homepage": "https://github.com/github/github-mcp-server",
      "transport": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "auth": {
        "type": "header",
        "header": "Authorization",
        "prefix": "Bearer ",
        "secret": "github_mcp_pat",
        "env": "GITHUB_MCP_PAT",
        "required": true
      },
      "supported_targets": [
        "claude",
        "codex",
        "opencode"
      ]
    },
    "brave": {
      "category": "search",
      "description": "Brave Search remote MCP",
      "homepage": "https://api-dashboard.search.brave.com/",
      "transport": "http",
      "url": "https://api.search.brave.com/mcp",
      "auth": {
        "type": "header",
        "header": "X-Subscription-Token",
        "prefix": "",
        "secret": "brave_api_key",
        "env": "BRAVE_API_KEY",
        "required": true
      },
      "supported_targets": [
        "claude",
        "codex",
        "opencode"
      ]
    },
    "exa": {
      "category": "search",
      "description": "Exa search and research",
      "homepage": "https://github.com/exa-labs/exa-mcp-server",
      "transport": "http",
      "url": "https://mcp.exa.ai/mcp",
      "auth": {
        "type": "header",
        "header": "Authorization",
        "prefix": "Bearer ",
        "secret": "exa_api_key",
        "env": "EXA_API_KEY",
        "required": true
      },
      "supported_targets": [
        "claude",
        "codex",
        "opencode"
      ]
    },
    "keenable": {
      "category": "search",
      "description": "Keenable search and page fetch; anonymous by default with an optional API key",
      "homepage": "https://docs.keenable.ai/mcp-server",
      "provider": "keenable",
      "auth_mode": "optional-api-key",
      "transport": "http",
      "url": "https://api.keenable.ai/mcp",
      "auth": {
        "type": "header",
        "header": "X-API-Key",
        "prefix": "",
        "secret": "keenable_api_key",
        "env": "KEENABLE_API_KEY",
        "required": false
      },
      "setup": "Works anonymously when no key is configured. Add a Keenable API key to remove the anonymous hourly limit.",
      "supported_targets": [
        "claude",
        "codex",
        "opencode"
      ]
    },
    "tavily-keyless": {
      "category": "search",
      "description": "Tavily Search and Extract without an account or API key",
      "homepage": "https://docs.tavily.com/documentation/keyless",
      "provider": "tavily",
      "auth_mode": "keyless",
      "variant_group": "tavily-auth",
      "variant_label": "Keyless",
      "transport": "http",
      "url": "https://mcp.tavily.com/mcp/",
      "headers": {
        "X-Tavily-Access-Mode": "keyless"
      },
      "setup": "Free rate-limited access to Tavily Search and Extract. Choose tavily-api for account credits and the complete tool set.",
      "supported_targets": [
        "claude",
        "codex",
        "opencode"
      ]
    },
    "tavily-api": {
      "category": "search",
      "description": "Tavily Search, Extract, Crawl, Map, and Research with an API key",
      "homepage": "https://docs.tavily.com/documentation/mcp",
      "provider": "tavily",
      "auth_mode": "api-key",
      "variant_group": "tavily-auth",
      "variant_label": "API key",
      "transport": "http",
      "url": "https://mcp.tavily.com/mcp/",
      "auth": {
        "type": "header",
        "header": "Authorization",
        "prefix": "Bearer ",
        "secret": "tavily_api_key",
        "env": "TAVILY_API_KEY",
        "required": true
      },
      "setup": "Create a Tavily key in the dashboard. mcpctl sends it in an Authorization header and never places it in the URL.",
      "supported_targets": [
        "claude",
        "codex",
        "opencode"
      ]
    },
    "tavily-oauth": {
      "category": "search",
      "description": "Tavily account access through each MCP client's OAuth login",
      "homepage": "https://docs.tavily.com/documentation/mcp",
      "provider": "tavily",
      "auth_mode": "oauth",
      "variant_group": "tavily-auth",
      "variant_label": "OAuth",
      "transport": "http",
      "url": "https://mcp.tavily.com/mcp/",
      "setup": "OAuth credentials stay in each client and are not backed up. After restore, authenticate with the client's MCP login command.",
      "supported_targets": [
        "claude",
        "codex",
        "opencode"
      ]
    },
    "chrome-devtools": {
      "category": "browser",
      "description": "Chrome DevTools debugging and performance analysis",
      "homepage": "https://github.com/ChromeDevTools/chrome-devtools-mcp",
    "transport": "stdio",
    "command": [
      "@mcpctl/adapters/mcp-package",
      "npm",
      "chrome-devtools",
      "chrome-devtools-mcp@1.6.0",
      "chrome-devtools-mcp",
      "--"
    ],
    "setup": "Requires Node.js LTS and a supported local Chrome installation.",
    "host": {
      "lifecycle": "client",
      "install": {
        "type": "npm",
        "package": "chrome-devtools-mcp@1.6.0",
        "bin": "chrome-devtools-mcp"
      },
      "requirements": [
        {
          "type": "command",
          "name": "node",
          "label": "Node.js LTS"
        }
      ]
    },
      "supported_targets": [
        "claude",
        "codex",
        "opencode"
      ]
    },
    "playwright": {
      "category": "browser",
      "description": "Playwright accessibility-driven browser automation",
      "homepage": "https://github.com/microsoft/playwright-mcp",
      "provider": "playwright",
      "variant_group": "playwright-runtime",
      "variant_label": "Persistent headed browser",
    "transport": "stdio",
    "command": [
      "@mcpctl/adapters/mcp-package",
      "npm",
      "playwright",
      "@playwright/mcp@0.0.78",
      "playwright-mcp",
      "--"
    ],
    "setup": "Requires Node.js 18 or newer; the MCP maintains its own browser profile.",
    "host": {
      "lifecycle": "client",
      "install": {
        "type": "npm",
        "package": "@playwright/mcp@0.0.78",
        "bin": "playwright-mcp"
      },
      "requirements": [
        {
          "type": "command",
          "name": "node",
          "label": "Node.js 18+"
        }
      ]
    },
      "supported_targets": [
        "claude",
        "codex",
        "opencode"
      ]
    },
    "playwright-headless": {
      "category": "browser",
      "description": "Playwright browser automation for display-free servers",
      "homepage": "https://github.com/microsoft/playwright-mcp",
      "provider": "playwright",
      "variant_group": "playwright-runtime",
      "variant_label": "Headless isolated browser",
    "transport": "stdio",
    "command": [
      "@mcpctl/adapters/mcp-package",
      "npm",
      "playwright-headless",
      "@playwright/mcp@0.0.78",
      "playwright-mcp",
      "--",
      "--headless",
      "--isolated"
    ],
    "setup": "Requires Node.js 18 or newer and Playwright browser dependencies. Runs without DISPLAY and keeps each MCP session isolated.",
    "host": {
      "lifecycle": "client",
      "install": {
        "type": "npm",
        "package": "@playwright/mcp@0.0.78",
        "bin": "playwright-mcp"
      },
      "requirements": [
        {
          "type": "command",
          "name": "node",
          "label": "Node.js 18+"
        }
      ]
    },
      "supported_targets": [
        "claude",
        "codex",
        "opencode"
      ]
    },
    "js-reverse": {
      "category": "web-reverse",
      "description": "JavaScript debugging, breakpoints, network, and WebSocket analysis in persistent headed Chrome",
      "homepage": "https://github.com/zhizhuodemao/js-reverse-mcp",
      "provider": "js-reverse",
      "variant_group": "js-reverse-runtime",
      "variant_label": "Persistent system Chrome",
      "transport": "stdio",
      "command": [
      "@mcpctl/adapters/mcp-host",
      "js-reverse",
      "js-reverse",
      "js-reverse-mcp@4.0.1"
    ],
    "setup": "Requires Node.js 20.19 or newer, Chrome, and a graphical session. Set JS_REVERSE_ALLOWED_ROOT to an absolute analysis directory to restrict MCP file reads and writes.",
    "host": {
      "lifecycle": "client",
      "install": {
        "type": "npm",
        "package": "js-reverse-mcp@4.0.1",
        "bin": "js-reverse-mcp"
      },
      "requirements": [
        {
          "type": "command",
          "name": "node",
          "label": "Node.js 20.19+"
        }
      ]
    },
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 300,
      "supported_targets": [
        "claude",
        "codex",
        "opencode"
      ]
    },
    "js-reverse-isolated": {
      "category": "web-reverse",
