    "host": {
      "lifecycle": "client",
      "install": {
        "type": "npm",
        "package": "js-reverse-mcp@4.0.1",
        "bin": "js-reverse-mcp"
      },
      "requirements": [
        {
          "type": "command",
          "name": "node",
          "label": "Node.js 20.19+"
        }
      ]
    },
      "startup_timeout_sec": 180,
      "tool_timeout_sec": 300,
      "supported_targets": [
