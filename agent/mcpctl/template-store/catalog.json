    "gdb": {
      "category": "reverse",
      "description": "Native GDB debugging over a local stdio MCP server",
      "homepage": "https://github.com/datobena/gdb-mcp",
    "transport": "stdio",
    "command": [
      "@mcpctl/adapters/mcp-package",
      "uv",
      "gdb",
      "gdb-mcp==1.0.1",
      "gdb-mcp",
      "--"
    ],
    "setup": "Requires uv and GDB on PATH. This server can start or attach debugger sessions and execute arbitrary GDB commands; use it only for trusted analysis targets.",
    "host": {
      "lifecycle": "client",
      "install": {
        "type": "uv",
        "package": "gdb-mcp==1.0.1",
        "bin": "gdb-mcp"
      },
      "requirements": [
        {
          "type": "command",
          "name": "gdb",
          "label": "GDB"
        }
      ],
      "platforms": [
        "linux"
      ]
    },
      "tool_timeout_sec": 300,
      "supported_targets": [
        "claude",
        "codex",
        "opencode"
      ]
    },
    "ghidra": {
      "category": "reverse",
      "description": "Ghidra GUI decompilation and live program analysis",
      "homepage": "https://github.com/bethington/ghidra-mcp",
      "transport": "stdio",
      "command": [
        "@mcpctl/adapters/mcp-host",
        "ghidra"
    ],
    "setup": "Install GhidraMCP 6.x and its bridge-mcp-ghidra wheel, enable the plugin, and keep GHIDRA_MCP_URL on http://127.0.0.1:8089/. A checkout can be selected with GHIDRA_MCP_DIR.",
    "host": {
      "lifecycle": "client",
      "install": {
        "type": "manual"
      },
      "requirements": [
        {
          "type": "any",
          "commands": [
            "bridge-mcp-ghidra"
          ],
          "envs": [
            "GHIDRA_MCP_DIR",
            "GHIDRA_MCP_BRIDGE"
          ],
          "label": "bridge-mcp-ghidra or a configured Ghidra bridge"
        }
      ],
      "service": {
        "ownership": "external",
        "url_env": "GHIDRA_MCP_URL",
        "url": "http://127.0.0.1:8089/"
      },
      "platforms": [
        "darwin",
        "linux",
        "windows"
      ]
    },
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 300,
      "supported_targets": [
        "claude",
        "codex",
        "opencode"
      ]
    },
    "ghidra-headless": {
      "category": "reverse",
      "description": "Headless Ghidra analysis through PyGhidra",
      "homepage": "https://github.com/clearbluejar/pyghidra-mcp",
