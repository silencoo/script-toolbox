[Unit]
Description=Update the active Mihomo profile with Mihomo Console
Documentation=file:/usr/local/share/doc/mihomo-console/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/sbin/mihomo-console update-active
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/etc/mihomo /run/lock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
