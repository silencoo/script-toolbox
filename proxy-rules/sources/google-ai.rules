# Google AI entry points and session-critical endpoints.
# Intentionally excluded: *.google.com, *.googleapis.com,
# *.googleusercontent.com, and *.gstatic.com. Those suffixes overlap Drive and
# other potentially high-volume Google services.

# Gemini consumer app
DOMAIN-SUFFIX,gemini.google.com
DOMAIN-SUFFIX,bard.google.com

# Google AI Studio and Gemini API
DOMAIN,ai.google.dev
DOMAIN,aistudio.google.com
DOMAIN,makersuite.google.com
DOMAIN,alkalimakersuite-pa.clients6.google.com
DOMAIN,generativelanguage.googleapis.com
DOMAIN,proactivebackend-pa.googleapis.com
DOMAIN-SUFFIX,generativeai.google

# NotebookLM entry points
DOMAIN,notebooklm.google.com
DOMAIN-SUFFIX,notebooklm.google

# Small authentication/session endpoints used during Google AI sessions
DOMAIN,accounts.google.com
DOMAIN,apis.google.com
DOMAIN,ogs.google.com

# Exact shared static/CDN endpoints used by Gemini. Keep these on the cheaper
# Google AI policy instead of the more expensive general AI policy.
DOMAIN,t3.gstatic.com
DOMAIN,www.gstatic.com
DOMAIN,ssl.gstatic.com
