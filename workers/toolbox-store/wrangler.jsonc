{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "toolbox-store",
  "main": "worker.js",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "MAX_BLOB_BYTES": "5242880"
  },
  "assets": {
    "directory": "./ui",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "TOOLBOX_STORE",
      "bucket_name": "toolbox-store"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
