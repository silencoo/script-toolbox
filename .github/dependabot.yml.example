# Disabled while GitHub Actions quota is exhausted.
# Rename to dependabot.yml to enable scheduled dependency updates.
version: 2
updates:
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: monthly
    open-pull-requests-limit: 2
  - package-ecosystem: npm
    directory: /proxy-rules
    schedule:
      interval: monthly
    open-pull-requests-limit: 2
